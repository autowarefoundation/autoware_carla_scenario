"""{{ description }}

Generated by the Scenario Editor from ``document.yaml``.  Nothing in this
package is scenario logic: the document *is* the scenario, and the framework's
``DeclarativeScenario`` runs it.

    pip install --no-index --find-links <wheelhouse> {{ distribution_name }}
    scenario scenario={{ scenario_id }} map={{ map_group }}
"""

from __future__ import annotations

from pathlib import Path

from autoware_carla_scenario import register_conf_dir, register_scenario_builder

__all__ = ["CONF_DIR", "DOCUMENT_PATH", "PACKAGE_DIR", "register"]

#: This package's own directory.  The document and the Hydra config live inside
#: it rather than beside it, so they travel in the wheel: an installed package
#: has no project directory left to read them out of.
PACKAGE_DIR = Path(__file__).resolve().parent

#: The Scenario IR this package exists to run.
DOCUMENT_PATH = PACKAGE_DIR / "document.yaml"

#: Hydra config groups contributed by this package.
CONF_DIR = PACKAGE_DIR / "conf"


def register() -> None:
    """Register this package's scenario and config directory.

    Called by the framework CLI through the
    ``autoware_carla_scenario.scenarios`` entry point.  The builder is imported
    here rather than at module scope so that merely enumerating entry points
    stays free of the CARLA import.
    """
    from .scenario import build_scenario

    register_scenario_builder("{{ scenario_id }}", build_scenario)
    register_conf_dir(CONF_DIR)
