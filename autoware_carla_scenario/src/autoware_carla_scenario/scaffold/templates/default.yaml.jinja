# @package _global_
# Concrete scenario: bind the {{ scenario_name }} scenario to specific values.
#
# The `map`, `ego`, `server`, `entity` and `traffic_manager` groups are still
# provided by the framework's built-in conf directory; this file only overrides
# what differs.
scenario:
  # Quoted: a scenario called `null`, `true` or `on` is still a name.
  name: "{{ scenario_name }}"
  goal_lanelet_ids: [460, 265]
  # Through the junction ahead (every light is set green) and onto the
  # lane beyond it from 5 km/h, as intersection_passing/straight allows.
  timeout_seconds: 15.0

ego:
  initial_speed_kmh: 5.0
  spawn_lanelet_id: 242
  spawn_s: 25.0
