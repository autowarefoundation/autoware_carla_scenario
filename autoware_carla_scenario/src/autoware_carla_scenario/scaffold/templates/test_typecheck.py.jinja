"""The static check of this package's scenarios (``scenario-check``).

Compiles each scenario with Codon, built with the values of its YAML config,
as ``uv run scenario-check scenario='{{ scenario_name }}/*'`` does.  Add a scenario by
adding its config class, its class and its YAML to ``CASES``.
"""

from __future__ import annotations

from pathlib import Path

import pytest
import yaml
from autoware_carla_scenario.typecheck import find_supported_codon, typecheck_scenario
from autoware_carla_scenario.typecheck.toolchain import ToolchainError

from {{ package_name }}.configs import {{ config_class }}
from {{ package_name }}.{{ scenario_name }} import {{ scenario_class }}

CONF = Path(__file__).resolve().parents[1] / "src" / "{{ package_name }}" / "conf" / "scenario"

#: (scenario class, config class, the scenario's YAML configs)
CASES = [({{ scenario_class }}, {{ config_class }}, sorted((CONF / "{{ scenario_name }}").glob("*.yaml")))]


@pytest.mark.parametrize(
    ("scenario_cls", "config_cls", "path"),
    [(s, c, p) for s, c, paths in CASES for p in paths],
    ids=lambda value: value.stem if isinstance(value, Path) else "",
)
def test_the_scenario_compiles(scenario_cls: type, config_cls: type, path: Path) -> None:
    try:
        find_supported_codon()
    except ToolchainError as exc:
        pytest.skip(str(exc))
    values = yaml.safe_load(path.read_text())["scenario"]
    result = typecheck_scenario(scenario_cls, config_cls, values)
    assert result.ok, result.format()


def test_every_scenario_has_a_config() -> None:
    """An empty glob must fail: pytest would skip the check above with no cases."""
    missing = [scenario_cls.__name__ for scenario_cls, _, paths in CASES if not paths]
    assert not missing, f"no *.yaml config under {CONF} for {missing}"
