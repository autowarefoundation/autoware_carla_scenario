"""{{ scenario_class }} -- verify the ego reaches its goal roads.

This module lives in a separate installable package, not inside
``autoware_carla_scenario``.  It only depends on the framework's public API.

Note: importing this module pulls in :class:`BaseScenario`, which imports CARLA
at module scope, so it requires the framework's runtime environment.  The
package ``__init__`` imports it lazily (inside ``register()``).  The CARLA world
itself is only touched inside :meth:`setup`, which runs on the live server.
"""

from __future__ import annotations

import logging

from autoware_carla_scenario import (
    EGO_ROLE_NAME,
    AndCondition,
    BaseCondition,
    BaseScenario,
    EgoConfig,
    EntityLanePositionCondition,
    GroundProjectionConfig,
    Lanelet2Pose,
    StickyCondition,
    TimeoutCondition,
)

from .configs import {{ config_class }}

logger = logging.getLogger(__name__)


class {{ scenario_class }}(BaseScenario):
    """Pass when the ego has visited every configured goal road."""

    # Declared for the static check (docs/typecheck.md): Codon types an
    # attribute of a subclass from its class-level annotation.
    _config: {{ config_class }}

    def __init__(
        self,
        ego_config: EgoConfig,
        spawn_pose: Lanelet2Pose,
        config: {{ config_class }} | None = None,
        ground_projection: GroundProjectionConfig | None = None,
    ) -> None:
        super().__init__(
            ego_config, spawn_pose=spawn_pose, ground_projection=ground_projection
        )
        self._config = config or {{ config_class }}()

    def setup(self) -> None:
        """Snap the ego spawn and register the pass/fail conditions."""
        cfg = self._config
        # Nothing to reach is nothing to pass: refuse it before touching the
        # world.
        if len(cfg.goal_lanelet_ids) == 0:
            raise ValueError("goal_lanelet_ids must name at least one lanelet")
        self._setup_ego_spawn()

        # Pass condition: the ego reaches each goal lanelet (latched via Sticky).
        # Appended one by one and chosen by if/else below: Codon gives
        # neither a list comprehension nor a conditional expression the
        # base class's type.
        stickies: list[BaseCondition] = []
        logger.info("Goal lanelets: %s", list(cfg.goal_lanelet_ids))
        for lanelet_id in cfg.goal_lanelet_ids:
            # The lanelet goes in whole: it names one lane, and the condition
            # resolves it.  Reducing it to a road here would assert only that
            # the ego reached the road, which is also true in the lane beside
            # the one the goal names.
            stickies.append(
                StickyCondition(
                    EntityLanePositionCondition(
                        EGO_ROLE_NAME,
                        Lanelet2Pose(lanelet_id=lanelet_id, s=0.0),
                        label=f"ego_on_lanelet_{lanelet_id}",
                    )
                )
            )
        # AndCondition needs at least two children: one goal is its own
        # pass condition.
        reach_goals: BaseCondition
        if len(stickies) == 1:
            reach_goals = stickies[0]
        else:
            reach_goals = AndCondition(stickies)
        self.register_pass_condition(reach_goals)

        # Fail-safe timeout.
        self.register_fail_condition(
            TimeoutCondition(cfg.timeout_seconds, label="scenario_timeout")
        )

    def is_done(self) -> bool:
        """Termination is driven entirely by the pass/fail conditions."""
        return False
