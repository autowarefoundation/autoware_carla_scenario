"""Config dataclass for the ``{{ scenario_name }}`` scenario.

The scenario's parameters live with the scenario, in this package -- not inside
``autoware_carla_scenario``.  Shared parameters (ego, map, server, ...) can be
imported from the framework's public API instead of being redefined here.
"""

from __future__ import annotations

import math
from dataclasses import dataclass, field
from typing import Union


def _is_bool(value: Union[float, bool]) -> bool:
    """Whether *value*, a field typed ``float``, holds a boolean.

    A dataclass does not coerce its fields, so Hydra's ``=true`` reaches a
    ``float`` field as ``True``, which would read as 1.  Taking the value as
    ``Union[float, bool]`` keeps the check visible to the static check, which
    reads a field typed ``float`` as never holding a bool.
    """
    return isinstance(value, bool)


@dataclass
class {{ config_class }}:
    """Parameters for the ``{{ scenario_name }}`` scenario.

    Every field is overridable from YAML (and the CLI) via Hydra, e.g.::

        uv run scenario scenario={{ scenario_name }}/default \\
            scenario.timeout_seconds=20
    """

    #: Must match the name passed to ``register_scenario`` and the
    #: ``scenario.name`` key in the YAML config.
    name: str = "{{ scenario_name }}"

    #: Lanelet IDs the ego is expected to reach: each lanelet itself (its lane,
    #: not just its road), latched once the ego has been on it, in any order.
    #: The last is also the goal, unless ``ego.goal_lanelet_id`` names one.
    goal_lanelet_ids: list[int] = field(default_factory=lambda: [460, 265])

    #: Fail-safe timeout in seconds.
    timeout_seconds: float = 10.0

    def __post_init__(self) -> None:
        """Refuse an empty goal list, and a timeout that is not positive and
        finite (or is a boolean, which would read as 1 s), naming the key.

        A run builds the config before anything starts
        (``check_batch_configs``), so a bad ``scenario.goal_lanelet_ids=`` or
        ``scenario.timeout_seconds=`` override is refused there, not by the
        scenario's ``setup()`` or ``TimeoutCondition`` once CARLA is up.
        """
        # Nothing to reach is nothing to pass.
        if len(self.goal_lanelet_ids) == 0:
            raise ValueError(
                "scenario.goal_lanelet_ids must name at least one lanelet, "
                f"not {self.goal_lanelet_ids!r}"
            )
        if (
            _is_bool(self.timeout_seconds)
            or not math.isfinite(self.timeout_seconds)
            or self.timeout_seconds <= 0.0
        ):
            raise ValueError(
                "scenario.timeout_seconds must be finite and positive, "
                f"not {self.timeout_seconds!r}"
            )
