# The part of Python's pathlib the checked framework names, for the checker
# (docs/typecheck.md). Nothing here runs: a Path is its string, joined with
# "/", so a module that builds, joins and prints paths type-checks. Like
# CPython's, a Path is built from and joined with a str or a Path only, and
# compares unequal to anything that is not a Path.
#
# The file-system queries (exists(), is_file(), is_dir(), glob(), rglob(),
# absolute()) take what CPython 3.10's take, the oldest Python the package
# supports: the keyword-only `follow_symlinks` (3.12/3.13) and the globs'
# `case_sensitive` and `recurse_symlinks` (3.12/3.13) are refused, as CPython
# 3.10 refuses them. They touch no file: a query is False, and a glob yields
# nothing. The two reads, read_text() and read_bytes() (a str: the check reads
# bytes as str), read nothing and return "". Of what writes, mkdir(),
# write_text(), open(), unlink() and symlink_to() are declared (CPython
# 3.10's signatures); they create, open, remove and write nothing. open()
# returns a typing.IO of str, which IO[bytes] is too (the check reads bytes
# as str), whatever the mode. The rest of the common members follow CPython
# 3.10 too: the pure ones (with_suffix(), with_stem(), joinpath(), parts,
# suffixes, root, drive, anchor, as_uri()) compute their result from the
# string; touch(), rename(), rmdir(), chmod(), write_bytes() and the
# queries do nothing, as iterdir() yields nothing. 3.12's and 3.13's
# additions (`walk()`, `full_match()`, `from_uri()`) are not declared.

import internal.static as static
from typing import IO


def _keyword_only(extra, where: Literal[str]):
    # Codon 0.19 has no `*,`: what follows `*_kw` is passed by keyword only.
    if static.len(extra) > 0:
        compile_error(where + " is keyword-only")


def _part(part) -> str:
    if isinstance(part, Path):
        return part._path
    elif isinstance(part, str):
        return part
    elif isinstance(part, Optional):
        # Unwrapped, as Codon passes an Optional to any parameter of its type:
        # Codon does not narrow `Path(x)` under `if x:`.
        return _part(part.__val__())
    elif hasattr(part, "__fspath__"):
        # Another os.PathLike (what shutil.copy2() returns for a Path).
        return part.__fspath__()
    else:
        compile_error("a Path is built from and joined with a str or an os.PathLike only")
        return ""


class _PathParents:
    """What Path.parents is: a read-only sequence of the logical ancestors.
    Generic in the path (Codon's generic parameter), as Path is defined after."""

    T: type
    _paths: List[T]

    def __init__(self, paths: List[T]):
        self._paths = paths

    def __len__(self) -> int:
        return len(self._paths)

    def __getitem__(self, index: int) -> T:
        return self._paths[index]

    def __iter__(self) -> Generator[T]:
        for path in self._paths:
            yield path

    def __contains__(self, path: T) -> bool:
        return path in self._paths


class _PathParts:
    """What Path.parts is: a read-only sequence of the path's components (a
    tuple of str in CPython, which Codon cannot size at run time): indexed,
    sliced, iterated, with len() and `in`."""

    _items: List[str]

    def __init__(self, items: List[str]):
        self._items = items

    def __len__(self) -> int:
        return len(self._items)

    def __getitem__(self, index: int) -> str:
        return self._items[index]

    def __getitem__(self, index: slice) -> _PathParts:
        return _PathParts(self._items[index])

    def __iter__(self) -> Generator[str]:
        for item in self._items:
            yield item

    def __contains__(self, item: str) -> bool:
        return item in self._items


class _StatResult:
    """What Path.stat() returns (CPython's os.stat_result): the fields the
    framework reads. Nothing is read from a file: all are zero."""

    st_dev: int
    st_ino: int
    st_size: int
    st_mtime_ns: int
    st_mtime: float

    def __init__(self):
        self.st_dev = 0
        self.st_ino = 0
        self.st_size = 0
        self.st_mtime_ns = 0
        self.st_mtime = 0.0


class Path:
    _path: str

    def __init__(self, *parts):
        path = ""
        for part in parts:
            text = _part(part)
            if not path or text.startswith("/"):
                path = text
            elif text:
                path = path + "/" + text
        self._path = path if path else "."

    # After the varargs one: Codon tries the overload defined last first, and
    # an empty *parts has no element type for _part.
    def __init__(self):
        self._path = "."

    def __truediv__(self, other) -> Path:
        return Path(self, other)

    def __rtruediv__(self, other) -> Path:
        return Path(other, self)

    def __str__(self) -> str:
        return self._path

    def __eq__(self, other) -> bool:
        return False

    def __eq__(self, other: Path) -> bool:
        return self._path == other._path

    def __ne__(self, other) -> bool:
        return True

    def __ne__(self, other: Path) -> bool:
        return self._path != other._path

    def __hash__(self) -> int:
        return hash(self._path)

    # os.PathLike: os.fspath(), os.path and shutil take a Path.
    def __fspath__(self) -> str:
        return self._path

    def expanduser(self) -> Path:
        return self

    def resolve(self, strict: bool = False) -> Path:
        return self

    @staticmethod
    def home() -> Path:
        return Path("~")

    @staticmethod
    def cwd() -> Path:
        return Path(".")

    # The path with "/" separators (as CPython's on POSIX).
    def as_posix(self) -> str:
        return self._path

    # relative_to(other), by position: what every supported Python takes.
    # CPython 3.10 joins more parts (`relative_to(*other)`), 3.12 deprecates
    # them and 3.14 refuses them (TypeError), so they are refused; so is 3.12's
    # `walk_up`. Nothing is computed: the path is returned as it is (CPython
    # raises ValueError for one not under it).
    def relative_to(self, _acs_other) -> Path:
        Path(_acs_other)
        return self

    # is_relative_to(other), by position, as relative_to() (CPython 3.10's
    # `*other`, joined, is deprecated in 3.12 and refused in 3.14).
    def is_relative_to(self, _acs_other) -> bool:
        other = Path(_acs_other)._path
        return self._path == other or self._path.startswith(other + "/")

    # is_absolute(): whether the path starts at the root, as on POSIX.
    def is_absolute(self) -> bool:
        return self._path.startswith("/")

    # The name and its parts, as PurePath computes them.
    @property
    def name(self) -> str:
        if self._path == "/" or self._path == ".":
            return ""
        i = self._path.rfind("/")
        return self._path[i + 1:] if i >= 0 else self._path

    @property
    def suffix(self) -> str:
        name = self.name
        i = name.rfind(".")
        return name[i:] if 0 < i < len(name) - 1 else ""

    @property
    def stem(self) -> str:
        name = self.name
        i = name.rfind(".")
        return name[:i] if 0 < i < len(name) - 1 else name

    # with_name(name): the path with its last part replaced (CPython raises
    # ValueError for a path with no name, or a name that is not one).
    def with_name(self, name: str) -> Path:
        i = self._path.rfind("/")
        return Path(self._path[:i + 1] + name if i >= 0 else name)

    @property
    def parent(self) -> Path:
        i = self._path.rfind("/")
        if i < 0:
            return Path(".")
        return Path(self._path[:i] if i > 0 else "/")

    @property
    def parents(self) -> _PathParents[Path]:
        found = List[Path]()
        path = self
        while path.name:
            path = path.parent
            found.append(path)
        return _PathParents[Path](found)

    # Paths order by their string; CPython compares a Path with a Path only
    # (a str is a TypeError), so sorted() works on paths alone.
    def __lt__(self, other: Path) -> bool:
        return self._path < other._path

    def __le__(self, other: Path) -> bool:
        return self._path <= other._path

    def __gt__(self, other: Path) -> bool:
        return self._path > other._path

    def __ge__(self, other: Path) -> bool:
        return self._path >= other._path

    def absolute(self) -> Path:
        return self

    def exists(self) -> bool:
        return False

    def is_file(self) -> bool:
        return False

    def is_dir(self) -> bool:
        return False

    def glob(self, pattern: str) -> Generator[Path]:
        # A generator of Paths, as CPython's glob() returns, of no path.
        if False:
            yield self

    # rglob(pattern): glob() in this directory and every one below it.
    def rglob(self, pattern: str) -> Generator[Path]:
        if False:
            yield self

    # The two reads, with CPython 3.10's signatures (3.13's `newline` is
    # refused): read_text(encoding=None, errors=None), a str, and
    # read_bytes(), bytes, which is a str here (the check reads bytes as
    # str). Nothing is read: both are empty. (coordinate.map_manager reads
    # an OpenDRIVE file with read_text().)
    def read_text(self, encoding: Optional[str] = None, errors: Optional[str] = None) -> str:
        return ""

    def read_bytes(self) -> str:
        return ""

    # The two writes the framework makes (maps.opendrive), with CPython
    # 3.10's signatures (mode=0o777: Codon has no octal literal); nothing is
    # created or written.
    def mkdir(self, mode: int = 511, parents: bool = False, exist_ok: bool = False) -> None:
        pass

    def write_text(
        self,
        data: str,
        encoding: Optional[str] = None,
        errors: Optional[str] = None,
        newline: Optional[str] = None,
    ) -> int:
        return len(data)

    # open(mode="r", buffering=-1, encoding=None, errors=None, newline=None):
    # a file object, an IO[bytes] for a binary mode, an IO[str] otherwise
    # (one type here). CPython refuses a bad mode, or an encoding with a
    # binary one, with a ValueError when it is called.
    def open(
        self,
        mode: str = "r",
        buffering: int = -1,
        encoding: Optional[str] = None,
        errors: Optional[str] = None,
        newline: Optional[str] = None,
    ) -> IO[str]:
        return IO[str](self._path, mode)

    # is_symlink(), with no arguments in every supported Python.
    def is_symlink(self) -> bool:
        return False

    # unlink(missing_ok=False).
    def unlink(self, missing_ok: bool = False) -> None:
        pass

    # symlink_to(target, target_is_directory=False): the target is a str or
    # an os.PathLike.
    def symlink_to(self, target, target_is_directory: bool = False) -> None:
        _part(target)

    # stat(): with no argument (the keyword-only `follow_symlinks` is not
    # declared). The result carries st_dev, st_ino, st_size, st_mtime_ns and
    # st_mtime only, all zero.
    def stat(self) -> _StatResult:
        return _StatResult()

    # replace(target): rename onto target, a str or an os.PathLike; returns
    # the new Path (3.8+). Nothing is renamed.
    def replace(self, target) -> Path:
        return Path(target)

    # The suffix, and the stem, replaced. CPython raises ValueError for a path
    # with no name, and for a suffix that is neither "" nor starts with "."
    # (or is "." alone); with_stem() is Python 3.9+.
    def with_suffix(self, suffix: str) -> Path:
        name = self.name
        if not name:
            return self
        return self.with_name(name[: len(name) - len(self.suffix)] + suffix)

    def with_stem(self, stem: str) -> Path:
        return self.with_name(stem + self.suffix)

    # joinpath(*other): the path joined with each part, a str or an
    # os.PathLike.
    def joinpath(self, *other) -> Path:
        return Path(self, *other)

    # The components, "/" first for an absolute path, and the suffixes of
    # the name ("a.tar.gz" has ".tar" and ".gz").
    @property
    def parts(self) -> _PathParts:
        found = List[str]()
        if self._path.startswith("/"):
            found.append("/")
        for part in self._path.split("/"):
            if part and part != ".":
                found.append(part)
        return _PathParts(found)

    @property
    def suffixes(self) -> List[str]:
        name = self.name
        found = List[str]()
        if name.endswith("."):
            return found
        stripped = name.lstrip(".")
        pieces = stripped.split(".")
        for piece in pieces[1:]:
            found.append("." + piece)
        return found

    @property
    def root(self) -> str:
        return "/" if self._path.startswith("/") else ""

    @property
    def drive(self) -> str:
        return ""

    @property
    def anchor(self) -> str:
        return self.root

    def as_uri(self) -> str:
        return "file://" + self._path

    # match(path_pattern) (3.12 renames it `pattern`, and adds the keyword-only
    # `case_sensitive`): nothing is matched, as nothing is read.
    def match(self, path_pattern: str) -> bool:
        return False

    # samefile(other_path): a str or an os.PathLike; nothing is compared on
    # disk.
    def samefile(self, other_path) -> bool:
        _part(other_path)
        return False

    # The directory listing yields nothing, like glob().
    def iterdir(self) -> Generator[Path]:
        if False:
            yield self

    # touch(mode=0o666, exist_ok=True), rename(target) (the new Path, 3.8+),
    # rmdir() and chmod(mode, *, follow_symlinks=True) (3.10): nothing is
    # created, renamed, removed or changed.
    def touch(self, mode: int = 438, exist_ok: bool = True) -> None:
        pass

    def rename(self, target) -> Path:
        return Path(target)

    def rmdir(self) -> None:
        pass

    def chmod(self, mode: int, *_kw, follow_symlinks: bool = True) -> None:
        _keyword_only(_kw, "chmod(): follow_symlinks")

    # write_bytes(data): the data is bytes, a str here (the check reads bytes
    # as str); returns the number of bytes written.
    def write_bytes(self, data: str) -> int:
        return len(data)

    # lstat() is stat() without following links; readlink() (3.9) is the
    # link's target, a Path; owner() and group() are names, "" here.
    def lstat(self) -> _StatResult:
        return _StatResult()

    def readlink(self) -> Path:
        return self

    def owner(self) -> str:
        return ""

    def group(self) -> str:
        return ""
