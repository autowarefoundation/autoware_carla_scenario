# Python's dataclasses, for the scenario checker (docs/typecheck.md).
#
# A Codon class with annotated fields already has the generated __init__ of a
# dataclass, so the checker drops @dataclass decorators and puts each
# `field(default=...)` / `field(default_factory=...)` default in place
# (typecheck/transform.py), which also appends the __eq__, __hash__ and
# ordering methods the decorator would generate. These definitions only resolve the import.


def dataclass(cls):
    return cls


def field(default):
    return default


def replace(obj):
    """dataclasses.replace(obj, a=x): the checker lowers the call to
    `replace(obj)._acs_with__a(a=x)` (typecheck/transform.py), where this
    returns obj and the dataclass's own method makes the typed copy."""
    return obj
