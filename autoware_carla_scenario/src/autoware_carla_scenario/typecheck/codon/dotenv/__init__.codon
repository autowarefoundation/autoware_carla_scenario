# Model of python-dotenv (docs/typecheck.md): find_dotenv() and load_dotenv(),
# with the installed package's signatures, which test_typecheck_model.py
# compares.
#
# find_dotenv(filename=".env", raise_error_if_not_found=False, usecwd=False)
# -> str: the path of the file found, or "" (here always "").
#
# load_dotenv(dotenv_path=None, stream=None, verbose=False, override=False,
# interpolate=True, encoding="utf-8") -> bool. The path is None, a str or an
# os.PathLike; a stream (an IO[str], which Codon has no type for) is not
# declared, so only None is taken for it. The rest of the package
# (dotenv_values(), set_key(), ...) is not declared. Nothing here runs: no
# directory is searched, no file is read and the environment is not changed.

from os import fspath


def find_dotenv(
    filename: str = ".env",
    raise_error_if_not_found: bool = False,
    usecwd: bool = False,
) -> str:
    return ""


def load_dotenv(
    dotenv_path=None,
    stream=None,
    verbose: bool = False,
    override: bool = False,
    interpolate: bool = True,
    encoding: Optional[str] = "utf-8",
) -> bool:
    if isinstance(dotenv_path, None) or isinstance(dotenv_path, Optional[NoneType]):
        pass
    else:
        fspath(dotenv_path)
    if not (isinstance(stream, None) or isinstance(stream, Optional[NoneType])):
        compile_error("load_dotenv(): a stream is not declared, only a path")
    return False
