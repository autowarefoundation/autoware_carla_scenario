# Model of lanelet2.routing, for the checker (docs/typecheck.md): the routing
# graph and the neighbours it gives a lanelet (following, beside and
# conflicting), which it hands out as ConstLanelets (a Lanelet goes in;
# core.codon), and the shortest path between two lanelets. Its routes,
# other paths and costs are not declared.

from lanelet2.core import ConstLanelet, LaneletMap
from lanelet2.traffic_rules import TrafficRules


# The lanelets of a path, in order, as ConstLanelets (shortestPath()).
class LaneletPath:
    def __getitem__(self, key: int) -> ConstLanelet:
        raise NotImplementedError()

    def __iter__(self) -> Generator[ConstLanelet]:
        raise NotImplementedError()

    def __len__(self) -> int:
        raise NotImplementedError()


class RoutingGraph:
    # RoutingGraph(laneletMap, trafficRules): Python also takes the routing
    # costs, which the framework leaves at lanelet2's.
    def __init__(self, laneletMap: LaneletMap, trafficRules: TrafficRules):
        pass

    def following(self, lanelet: ConstLanelet, withLaneChanges: bool = False) -> List[ConstLanelet]:
        raise NotImplementedError()

    def previous(self, lanelet: ConstLanelet, withLaneChanges: bool = False) -> List[ConstLanelet]:
        raise NotImplementedError()

    # The neighbour a lane change reaches, or None.
    def left(self, lanelet: ConstLanelet, routingCostId: int = 0) -> Optional[ConstLanelet]:
        raise NotImplementedError()

    def right(self, lanelet: ConstLanelet, routingCostId: int = 0) -> Optional[ConstLanelet]:
        raise NotImplementedError()

    # The neighbour no lane change reaches (a solid line between), or None.
    def adjacentLeft(self, lanelet: ConstLanelet, routingCostId: int = 0) -> Optional[ConstLanelet]:
        raise NotImplementedError()

    def adjacentRight(self, lanelet: ConstLanelet, routingCostId: int = 0) -> Optional[ConstLanelet]:
        raise NotImplementedError()

    # The lanelets whose area overlaps this one's and that neither follows
    # nor precedes it (crossing paths in a junction). simple-lanelet2 hands
    # them out as ConstLanelets; lanelet2's own binding wraps each in a
    # ConstLaneletOrArea, which the framework unwraps at run time.
    def conflicting(self, lanelet: ConstLanelet, routingCostId: int = 0) -> List[ConstLanelet]:
        raise NotImplementedError()

    # The shortest path from one lanelet to another, both included, or None
    # when the graph has none (a path to the lanelet itself is that lanelet).
    def shortestPath(self, fromLanelet: ConstLanelet, toLanelet: ConstLanelet, routingCostId: int = 0, withLaneChanges: bool = True) -> Optional[LaneletPath]:
        raise NotImplementedError()
