# Model of lanelet2.io, for the checker (docs/typecheck.md): the map origin a
# projector is built at, loading a map through a projector, and writing one
# through a projector with writeRobust(). write(), loadRobust(), loading at an
# Origin (without a projector) and writing without one are not declared.

from lanelet2.core import LaneletMap


class Origin:
    # Python's defaults are 0; the framework passes the latitude and longitude.
    def __init__(self, lat: float, lon: float, alt: float = 0.0):
        pass


# lanelet2.projection builds its projectors at an Origin, so it is imported
# once Origin is defined (Codon 0.19 resolves the two modules' imports in
# order).
from lanelet2.projection import Projector


# load(filename, projector): the map in the file, read through the projector
# (any of lanelet2's or Autoware's: lanelet2.projection.codon). Raises
# RuntimeError for a file it cannot parse.
def load(filename: str, projector: Projector) -> LaneletMap:
    raise NotImplementedError()


# writeRobust(filename, map, projector=None, params=None): writes the map to
# the file through the projector and returns the errors, a list of str (empty
# when it wrote every primitive). Raises RuntimeError for a file it cannot
# create. The model takes a projector, and not the params.
def writeRobust(filename: str, map: LaneletMap, projector: Projector) -> List[str]:
    raise NotImplementedError()
