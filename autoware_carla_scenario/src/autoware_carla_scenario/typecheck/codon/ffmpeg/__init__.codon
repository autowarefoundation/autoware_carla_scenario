# Model of ffmpeg-python (docs/typecheck.md): input(), the start of the
# fluent pipeline the camera recorder builds (ffmpeg.nodes declares the rest),
# with the installed package's signature, which test_typecheck_model.py
# compares.
#
# input(filename, **kwargs): the file name is a str or an os.PathLike
# (ffmpeg-python hands it to ffmpeg as it is), and an option any keyword of
# any value. Nothing else of the package is declared. Nothing here runs.

from os import fspath

from .nodes import FilterableStream as _FilterableStream


def input(filename, **kwargs) -> _FilterableStream:
    fspath(filename)
    return _FilterableStream()
