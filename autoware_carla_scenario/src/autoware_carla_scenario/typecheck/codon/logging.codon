def log(
    level: int,
    msg,
    *args,
    exc_info: bool = False,
    stack_info: bool = False,
    stacklevel: int = 1,
    extra=None,
) -> None:
    pass


def basicConfig(
    *args,
    filename: Optional[str] = None,
    filemode: str = "a",
    format: str = BASIC_FORMAT,
    datefmt: Optional[str] = None,
    style: str = "%",
    level=None,
    stream=None,
    handlers=None,
    force: bool = False,
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
) -> None:
    _keyword_only(args, "logging.basicConfig()")
    _level(level, "logging.basicConfig()")
    # Codon's lists are invariant: [StreamHandler()] is not a list[Handler].
    if not isinstance(handlers, Optional[NoneType]):
        for handler in handlers:
            _is_handler(handler)
