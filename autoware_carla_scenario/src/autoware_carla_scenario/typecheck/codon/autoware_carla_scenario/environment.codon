# Model of autoware_carla_scenario.environment (docs/typecheck.md).
#
# What the checked scenario_runner uses of it (platform, json, importlib's
# metadata: excluded): the id of this process's environment, which a run
# records with its outcome.  A scenario never builds a RunEnvironment:
# capture() returns it.

# The suffixes of the files a run's environment is written to, as Python's.
ENVIRONMENT_SUFFIX = "_environment.json"
LOCK_SUFFIX = "_requirements.lock"


class RunEnvironment:
    _unused: int

    # Codon would build it by its fields' names too (docs/typecheck.md, #244).
    def __init__(self, _unused):
        compile_error("RunEnvironment: capture() builds it")

    def __init__(self, packages):
        compile_error("RunEnvironment: capture() builds it")

    @property
    def id(self) -> str:
        raise NotImplementedError()


def capture() -> RunEnvironment:
    raise NotImplementedError()
