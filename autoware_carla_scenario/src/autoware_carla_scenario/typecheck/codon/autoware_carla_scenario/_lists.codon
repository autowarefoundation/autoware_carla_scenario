# _acs_list: what the checker puts in place of a list display
# (typecheck/transform.py), e.g. `[ElapsedTimeCondition(...), SpeedCondition(...)]`.
#
# Codon gives a list display the type of its first element, so a list of two
# different conditions does not compile. Python's is a list of conditions, and
# so is this one: a display that starts with a condition (or an action) is a
# List[BaseCondition] (List[BaseAction]), and any other display keeps the type
# of its first element, as Codon's would.


def _acs_list(*items):
    if hasattr(items[0], "_acs_condition"):
        conditions = List[BaseCondition]()
        for item in items:
            conditions.append(item)
        return conditions
    elif hasattr(items[0], "_acs_action"):
        actions = List[BaseAction]()
        for item in items:
            actions.append(item)
        return actions
    else:
        out = List[type(items[0])]()
        for item in items:
            out.append(item)
        return out


# _acs_base: what the checker puts around each value of a dict display whose
# values may mix classes, e.g. `{"turn": turn, "lc": lc}`, as
# `{"turn": _acs_base(turn), "lc": _acs_base(lc)}`: the dict display
# counterpart of _acs_list. A condition (or an action) is a BaseCondition
# (BaseAction), so a display of different ones is a Dict[K, BaseCondition]
# (Dict[K, BaseAction]) as in Python; any other value is returned as it is,
# and the display stays Codon's, typed as it was (an int and a float, a value
# and None).


def _acs_base(x):
    if hasattr(x, "_acs_condition"):
        base: BaseCondition = x
        return base
    elif hasattr(x, "_acs_action"):
        base: BaseAction = x
        return base
    else:
        return x


# _acs_dict_into: an annotated dict display, `x: dict[str, BaseAction] =
# {...}`, as `_acs_dict_into(Dict[str, BaseAction](), ("a", a), ...)`: each
# item goes into the dict of the annotated type, which refuses one that is
# not of it.


def _acs_dict_into(out, *items):
    for item in items:
        out[item[0]] = item[1]
    return out


# Last, not first: every module the checker rewrites imports these, and in the
# library check some of them are imported by the model these import
# (typecheck/library.py, REPLACED_MODELS). Codon resolves an import cycle with
# the names already defined, so these have to be defined by then.
from .actions import BaseAction
from .conditions import BaseCondition
