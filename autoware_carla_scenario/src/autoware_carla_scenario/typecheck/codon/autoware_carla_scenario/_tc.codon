# Helpers for the Codon model of autoware_carla_scenario (docs/typecheck.md).
#
# The model is compiled, never run, so a function body here only has to be
# well typed. Codon 0.19 lacks some of Python's typing, and these fill the gaps:
#
# * no keyword-only parameters (`*,`): a model function takes `*_kw` before
#   them and calls _keyword_only(_kw, ...), a compile error when a caller
#   passes those arguments by position;
# * a Union parameter crashes the compiler, and an Optional[Base] parameter
#   does not accept a subclass: such a parameter is generic (no annotation)
#   and the body checks what it got with one of the _expect_* helpers below
#   (or the model's own, next to the types they name).

import internal.static as static


@extend
class str:
    # `"%.1f" % x` is Python's printf formatting, which Codon's str lacks.
    def __mod__(self, args) -> str:
        return self

    # str.encode, with CPython's signature. The check reads `bytes` as `str`
    # (Codon 0.19 has none), so it returns a str. bytes.decode is not
    # declared: it would be a str's too, and so pass `"text".decode()`, which
    # CPython refuses (str has no decode()); nothing checked decodes.
    def encode(self, encoding: str = "utf-8", errors: str = "strict") -> str:
        return self

    # str.removeprefix(prefix, /) and str.removesuffix(suffix, /) (Python
    # 3.9), which Codon 0.19 lacks. The parameter's name is no keyword anyone
    # passes, as CPython takes it by position only.
    def removeprefix(self, _acs_prefix: str) -> str:
        if _acs_prefix and self.startswith(_acs_prefix):
            return self[len(_acs_prefix):]
        return self

    def removesuffix(self, _acs_suffix: str) -> str:
        if _acs_suffix and self.endswith(_acs_suffix):
            return self[: len(self) - len(_acs_suffix)]
        return self

    # str.maketrans (#601), a static method Codon 0.19 lacks, with the table
    # Codon's str.translate reads: a dict of code points to a str, or None
    # for a character to delete. Python's also takes ints as values, which
    # Codon's translate does not.
    @staticmethod
    def maketrans(_acs_x: str, _acs_y: str) -> Dict[int, Optional[str]]:
        table = Dict[int, Optional[str]]()
        for i in range(len(_acs_x)):
            table[ord(_acs_x[i])] = Optional[str](_acs_y[i])
        return table

    @staticmethod
    def maketrans(_acs_x: str, _acs_y: str, _acs_z: str) -> Dict[int, Optional[str]]:
        table = str.maketrans(_acs_x, _acs_y)
        for c in _acs_z:
            table[ord(c)] = Optional[str]()
        return table

    @staticmethod
    def maketrans(_acs_x: Dict[str, str]) -> Dict[int, Optional[str]]:
        table = Dict[int, Optional[str]]()
        for k, v in _acs_x.items():
            table[ord(k)] = Optional[str](v)
        return table


def _acs_value(T: type) -> T:
    """A T, for the library check's calls (typecheck/library_driver.py):
    read through a null pointer, which is fine, as nothing compiled is run."""
    return Ptr[T]()[0]


class _acs_Returning:
    """What the library check (typecheck/library_driver.py) calls a function
    with for a parameter of a Callable one of whose arguments is a union, a
    type Codon 0.19 crashes on: a callable taking N arguments of any type and
    returning an R. A call with another number of arguments, or with a
    keyword, does not compile, as the Callable would refuse it. Nothing
    compiled is run."""

    R: type
    N: Literal[int]

    def __call__(self, *args) -> R:
        if static.len(args) != N:
            compile_error("called with a number of arguments its Callable does not take")
        return _acs_value(R)


def _acs_takes(value: T, T: type):
    """A typed parameter, which takes a T or a subclass of it (an upcast)."""
    pass


def _acs_expect_return(r, T: type, hook: Literal[str]):
    """The result *r* of an override of the framework's *hook* is a T (#238).

    Strict, unlike an annotated assignment (Codon 0.19 converts any value
    with `__bool__` in `done: bool = x`) or a typed parameter (which unwraps
    an Optional implicitly): *r* must be a T itself, a subclass of the class
    T, an int for a float or a bool for an int, as Python's typing allows.
    An Optional[U] takes a U, an Optional of one, or None (an override that
    never returns a value); any other T takes no Optional.
    """
    if isinstance(r, T):
        pass
    elif isinstance(T, Optional):
        if isinstance(r, NoneType):
            pass
        elif isinstance(r, Optional[NoneType]):
            pass
        elif isinstance(r, Optional):
            _acs_expect_return(unwrap(r), T.T, hook)
        else:
            _acs_expect_return(r, T.T, hook)
    elif isinstance(r, Optional):
        compile_error(hook + ", and this override returns an Optional, which may be None")
    elif isinstance(T, float) and isinstance(r, int):
        pass
    elif isinstance(T, int) and isinstance(r, bool):
        pass
    elif static.has_rtti(T) and static.has_rtti(type(r)):
        # Two classes of a hierarchy: a subclass of T is upcast, and any
        # other class is refused with the types named.
        _acs_takes(r, T)
    else:
        compile_error(hook + ", and this override returns another type")


def _acs_hook_return(C: type, name: Literal[str], r):
    """What the scenario check appends for each call of a method *name* of a
    class C of the scenario's modules (typecheck/library_driver.py): the
    result *r* checked against the return type of the framework's method C
    overrides, when C derives from a model class that declares its hooks
    (`_acs_hook_returns`). Nothing is checked for a class that does not, or
    for a name that is no hook of its base."""
    if hasattr(C, "_acs_hook_returns"):
        C._acs_hook_returns(name, r)


def _keyword_only(extra, where: Literal[str]):
    if static.len(extra) > 0:
        compile_error(where + " is keyword-only")


def _acs_tuple(values):
    """What the checker puts in place of tuple(values) (typecheck/transform.py):
    Codon's tuples have a fixed length, so a tuple of a list or a generator is
    a list (a class-level tuple[X, ...] is checked as a List[X]); a tuple stays
    itself."""
    if isinstance(values, Tuple):
        return values
    else:
        return list(values)


def _acs_reduce(function, iterable, *initial):
    """What the checker puts in place of functools.reduce(function, iterable[,
    initial]) (typecheck/transform.py): Codon's functools has only partial."""
    if static.len(initial) == 0:
        it = iter(iterable)
        acc = next(it)
        for x in it:
            acc = function(acc, x)
        return acc
    elif static.len(initial) == 1:
        acc = initial[0]
        for x in iterable:
            acc = function(acc, x)
        return acc
    else:
        compile_error("functools.reduce takes at most three arguments")


def _acs_callable(value) -> bool:
    """What the checker puts in place of callable(value): Codon 0.19 has no
    callable(), and decides it from the type when it compiles."""
    return hasattr(value, "__call__")


def _expect_float(x) -> float:
    if isinstance(x, float):
        return x
    elif isinstance(x, int):
        return float(x)
    else:
        compile_error("expected a float (or an int)")


def _expect_optional_float(x) -> Optional[float]:
    if isinstance(x, Union):
        # `maybe_float or 0.0` (#538): Codon types `Optional[T] or D` as the
        # Union of both, which Python reads as a number. Only the unions of
        # numbers and None are accepted; the members are not enumerable, so
        # the combinations that `or` makes of them are listed.
        if isinstance(x, Union[Optional[float], float]):
            return None
        elif isinstance(x, Union[Optional[float], int]):
            return None
        elif isinstance(x, Union[Optional[int], float]):
            return None
        elif isinstance(x, Union[Optional[int], int]):
            return None
        elif isinstance(x, Union[float, int]):
            return None
        else:
            compile_error("expected a float (or an int), or None")
    elif isinstance(x, None):
        return None
    elif isinstance(x, Optional[NoneType]):
        return None
    elif isinstance(x, Optional):
        if x is None:
            return None
        return _expect_float(unwrap(x))
    else:
        return _expect_float(x)


def _expect_bool(x) -> bool:
    if isinstance(x, bool):
        return x
    else:
        compile_error("expected a bool")


def _expect_optional_bool(x) -> Optional[bool]:
    if isinstance(x, None):
        return None
    elif isinstance(x, Optional[NoneType]):
        return None
    elif isinstance(x, Optional):
        if x is None:
            return None
        return _expect_bool(unwrap(x))
    else:
        return _expect_bool(x)


def _expect_str(x) -> str:
    if isinstance(x, str):
        return x
    else:
        compile_error("expected a str")


def _expect_optional_str(x) -> Optional[str]:
    if isinstance(x, None):
        return None
    elif isinstance(x, Optional[NoneType]):
        return None
    elif isinstance(x, Optional):
        if x is None:
            return None
        return _expect_str(unwrap(x))
    else:
        return _expect_str(x)


def _expect_int(x) -> int:
    if isinstance(x, int):
        return x
    else:
        compile_error("expected an int")


def _acs_sequence(xs, T: type):
    """A Sequence[T] argument, to iterate: an empty display, `[]` or `()`,
    as an empty List[T], and any other sequence as it is (#264).

    An empty display has no element type in Codon (`[]` is a
    List[NoneType], `()` a Tuple of no items, which iterates as an int), so
    a check that types each element (`p: Lanelet2Pose = x`) refuses it,
    where Python takes it as a Sequence[T]. A list of Nones (`[None]`) is a
    List[Optional[NoneType]], and stays itself: its elements are checked,
    and refused.
    """
    if isinstance(xs, List[NoneType]):
        return List[T]()
    elif isinstance(xs, Tuple) and static.len(xs) == 0:
        return List[T]()
    else:
        return xs


def _expect_str_sequence(xs, where: Literal[str]):
    """A Sequence[str] of names: a list or a tuple of str, or an empty one
    (#264). A str is refused (#299), though Python's typing takes one as a
    Sequence[str]: the framework would read each of its characters as a
    name (`roots="roads"` for `roots=["roads"]`)."""
    if isinstance(xs, str):
        compile_error(where + ": expected a sequence of names (a list or a tuple "
                      "of str), not a str: wrap it in a list")
    elif isinstance(xs, Optional[str]):
        compile_error(where + ": expected a sequence of names (a list or a tuple "
                      "of str), not a str: wrap it in a list")
    else:
        for x in _acs_sequence(xs, str):
            s: str = x


def _expect_int_sequence(xs) -> List[int]:
    """A Sequence[int]: a list or a tuple of ints, or an empty one."""
    out = List[int]()
    for x in _acs_sequence(xs, int):
        if isinstance(x, int):
            out.append(x)
        else:
            compile_error("expected a sequence of ints")
    return out


# A required keyword-only parameter after defaulted ones (`..., *, label: str`)
# is `label = _Required()` here, read through _required_str(): Codon does not
# allow a parameter without a default after defaulted ones.
@tuple
class _Required:
    _unused: int = 0


def _required_str(value, where: Literal[str]) -> str:
    if isinstance(value, _Required):
        compile_error(where + " is a required keyword argument")
    elif isinstance(value, str):
        return value
    else:
        compile_error(where + " must be a str")


@extend
class Dict:
    # Python's one-argument dict.get(key, /): the value, or None when the key
    # is absent. Codon's own takes a default of the value's type, which stays.
    # The parameter's name is no keyword anyone passes, as CPython takes the
    # key by position only.
    def get(self, _acs_key: K) -> Optional[V]:
        if _acs_key in self:
            return self[_acs_key]
        return None

    # Python's dict.pop(key, default, /) (#590): Codon's own takes the key
    # only. A default of the value's type gives the value's type; a None
    # default an Optional of it, as Python's does. Codon tries the overload
    # defined last first; a None would also pass for the first one's `V`
    # (Codon unwraps an Optional implicitly), so the None one is last.
    def pop(self, _acs_key: K, _acs_default: V) -> V:
        if _acs_key in self:
            return self.pop(_acs_key)
        return _acs_default

    def pop(self, _acs_key: K, _acs_default: Optional[NoneType]) -> Optional[V]:
        if _acs_key in self:
            return self.pop(_acs_key)
        return None

    # reversed(d) (#601): the keys, last first, as Python 3.8+ gives them.
    # Codon's reversed() indexes a value without __reversed__, which a dict
    # cannot be.
    def __reversed__(self) -> Generator[K]:
        keys = list(self.keys())
        i = len(keys) - 1
        while i >= 0:
            yield keys[i]
            i -= 1


@extend
class List:
    # Python's list.index(value, start[, stop], /) (#601): Codon's takes the
    # value only. Negative bounds count from the end, as in a slice.
    def index(self, _acs_x: T, _acs_start: int, _acs_stop: int = 0x7FFFFFFFFFFFFFFF) -> int:
        n = self.__len__()
        start = _acs_start
        stop = _acs_stop
        if start < 0:
            start = max(start + n, 0)
        if stop < 0:
            stop = max(stop + n, 0)
        elif stop > n:
            stop = n
        i = start
        while i < stop:
            if self[i] == _acs_x:
                return i
            i += 1
        raise ValueError(f"{_acs_x} is not in list")

    # `xs += (4, 5)` (#601): Python's list += takes any iterable (only `+`
    # wants a list); Codon's takes a list. Defined last, it is the overload
    # Codon tries first, so it serves a list too.
    def __iadd__(self, _acs_other) -> List[T]:
        for a in _acs_other:
            self.append(a)
        return self


def _acs_bounds(n: int, bounds) -> Tuple[int, int]:
    """The (start, stop) of a tuple's index(x[, start[, stop]]), as a slice
    reads them, for a tuple of n items."""
    start = 0
    stop = n
    if static.len(bounds) >= 1:
        start = bounds[0]
    if static.len(bounds) == 2:
        stop = bounds[1]
    elif static.len(bounds) > 2:
        compile_error("index() takes at most 3 arguments")
    if start < 0:
        start = max(start + n, 0)
    if stop < 0:
        stop = max(stop + n, 0)
    return (start, stop)


def _acs_count(t, x) -> int:
    """What the checker puts in the place of t.count(x) when t has no count()
    (typecheck/python_rewrites.py, #601): Codon's tuple has none. An item of
    another type than x is never equal to it."""
    if isinstance(t, Tuple):
        n = 0
        for i in static.range(static.len(t)):
            if isinstance(t[i], type(x)):
                if t[i] == x:
                    n += 1
        return n
    else:
        return t.count(x)


def _acs_index(t, x, *bounds) -> int:
    """What the checker puts in the place of t.index(x[, start[, stop]]) when
    t has no index() (typecheck/python_rewrites.py, #601): Codon's tuple has
    none."""
    if isinstance(t, Tuple):
        start, stop = _acs_bounds(static.len(t), bounds)
        for i in static.range(static.len(t)):
            if isinstance(t[i], type(x)):
                if start <= i and i < stop and t[i] == x:
                    return i
        raise ValueError("tuple.index(x): x not in tuple")
    else:
        return t.index(x, *bounds)
