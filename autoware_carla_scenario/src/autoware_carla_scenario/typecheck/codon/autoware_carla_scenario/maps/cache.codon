# Model of autoware_carla_scenario.maps.cache (docs/typecheck.md), which
# imports subprocess, tempfile and json: what the checked maps package
# (maps.resolver, maps.catalogue, and the names the package re-exports) uses
# of it, with the signatures of the Python module. Its MapSource is the
# checked one (_map_source.codon).

from pathlib import Path

from .._map_source import MapSource
from .._tc import _keyword_only

# The module's constants, as Python's.
CACHE_ROOT_ENV = "AUTOWARE_CARLA_SCENARIO_MAP_CACHE"
AUTOWARE_DATA_DIR_ENV = "AUTOWARE_DATA_DIR"
DERIVED_SUBDIR = ".derived"
TIP_SUFFIX = ".tip.json"


class MapCacheError(Static[RuntimeError]):
    def __init__(self, message: str):
        super().__init__(message)


def map_root() -> Path:
    raise NotImplementedError()


# A frozen dataclass in Python, so @tuple here: an assignment to a field fails
# the check as it fails the run.
@tuple
class CachedRepo:
    source: MapSource
    root: Path
    worktree: Path
    commit: str = ""
    materialised: Optional[str] = None


class GitMapCache:
    root: Path

    def __init__(self, root: Optional[Path] = None):
        raise NotImplementedError()

    def derived_dir(self, path: str) -> Path:
        raise NotImplementedError()

    def provisioned(self, source: MapSource) -> Optional[Path]:
        raise NotImplementedError()

    def at_tip(self, source: MapSource) -> MapSource:
        raise NotImplementedError()

    def last_tip(self, source: MapSource) -> str:
        raise NotImplementedError()

    def peek(self, source: MapSource) -> Optional[CachedRepo]:
        raise NotImplementedError()

    def list_files(self, source: MapSource, *_kw, refresh: bool = False) -> List[str]:
        _keyword_only(_kw, "GitMapCache.list_files(): refresh")
        raise NotImplementedError()

    def checkout(self, source: MapSource, *_kw, include: List[str] = List[str](),
                 materialise: bool = True, refresh: bool = False) -> CachedRepo:
        _keyword_only(_kw, "GitMapCache.checkout(): include, materialise and refresh")
        raise NotImplementedError()


def is_lfs_pointer(path: Path) -> bool:
    raise NotImplementedError()
