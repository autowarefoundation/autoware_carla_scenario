# Model of autoware_carla_scenario.t4_scene (docs/typecheck.md), which reads
# trajectory logs with orjson and writes Protobuf messages: what the checked
# scenario_runner, scenario_queue and t4_scene.exporter use of it, with the
# signatures of the Python class and function.

from pathlib import Path
from typing import Optional

from ._tc import _keyword_only as _acs_keyword_only


# write_t4_scene(log_path, output_dir=None, **options): the scene's path and
# the map resource's (None without a map), which the checked
# t4_scene.exporter writes each log with. A path is a str or a pathlib.Path;
# the options are trajectory_log_to_t4_scene()'s keywords.
def write_t4_scene(log_path, output_dir = None, **options) -> Tuple[Path, Optional[Path]]:
    Path(log_path)
    raise NotImplementedError()


class T4SceneExporter:
    def __init__(self, *_kw, step_s: float = 0.1, max_distance_m: Optional[float] = 100.0):
        _acs_keyword_only(_kw, "T4SceneExporter(): step_s and max_distance_m")

    def export(self, trajectory: Path) -> Optional[Path]:
        raise NotImplementedError()
