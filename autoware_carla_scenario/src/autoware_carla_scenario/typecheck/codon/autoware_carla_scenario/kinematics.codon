class AbsoluteAcceleration:
    vector: Vector3
    frame: CoordinateFrame

    def __init__(self, vector: Vector3, frame: CoordinateFrame):
        self.vector = vector
        self.frame = frame

    # RelativeAcceleration is defined below, so the operators that take one dispatch on
    # the operand, as Python's do, and refuse any other (docs/typecheck.md).
    def __add__(self, other):
        if isinstance(other, RelativeAcceleration):
            return AbsoluteAcceleration(self.vector, self.frame)
        else:
            compile_error("AbsoluteAcceleration + x: x must be a RelativeAcceleration")

    def __sub__(self, other):
        if isinstance(other, AbsoluteAcceleration):
            return RelativeAcceleration(self.vector, self.frame)
        elif isinstance(other, RelativeAcceleration):
            return AbsoluteAcceleration(self.vector, self.frame)
        else:
            compile_error("AbsoluteAcceleration - x: x must be an AbsoluteAcceleration or a RelativeAcceleration")

    def __mul__(self, scalar: float) -> AbsoluteAcceleration:
        raise NotImplementedError()

    def __rmul__(self, scalar: float) -> AbsoluteAcceleration:
        raise NotImplementedError()

    def __truediv__(self, scalar: float) -> AbsoluteAcceleration:
        raise NotImplementedError()

    def __neg__(self) -> AbsoluteAcceleration:
        raise NotImplementedError()

    def magnitude(self) -> float:
        raise NotImplementedError()

    @staticmethod
    def zero(frame: CoordinateFrame) -> AbsoluteAcceleration:
        return AbsoluteAcceleration(Vector3.zero(), frame)

    @staticmethod
    def from_components(ax: float, ay: float, az: float, frame: CoordinateFrame) -> AbsoluteAcceleration:
        return AbsoluteAcceleration(Vector3(ax, ay, az), frame)

    @staticmethod
    def from_carla_vector3d(v: carla.Vector3D) -> AbsoluteAcceleration:
        return AbsoluteAcceleration(Vector3.from_carla_vector3d(v), CoordinateFrame.CARLA_WORLD)


