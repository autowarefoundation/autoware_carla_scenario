# Model of autoware_carla_scenario.kinematics (docs/typecheck.md).

import typesafe_carla.carla as carla

from .coordinate import CoordinateFrame, FrameMismatchError, frame_of


def normalize_angle_deg(angle: float) -> float:
    return (angle + 180.0) % 360.0 - 180.0


def normalize_angle_rad(angle: float) -> float:
    return (angle + 3.141592653589793) % 6.283185307179586 - 3.141592653589793


class Vector3:
    x: float
    y: float
    z: float

    def __init__(self, x: float, y: float, z: float):
        self.x = x
        self.y = y
        self.z = z

    def __add__(self, other: Vector3) -> Vector3:
        raise NotImplementedError()

    def __sub__(self, other: Vector3) -> Vector3:
        raise NotImplementedError()

    def __mul__(self, scalar: float) -> Vector3:
        raise NotImplementedError()

    def __rmul__(self, scalar: float) -> Vector3:
        raise NotImplementedError()

    def __truediv__(self, scalar: float) -> Vector3:
        raise NotImplementedError()

    def __neg__(self) -> Vector3:
        raise NotImplementedError()

    def magnitude(self) -> float:
        raise NotImplementedError()

    def normalized(self) -> Vector3:
        raise NotImplementedError()

    def dot(self, other: Vector3) -> float:
        raise NotImplementedError()

    def cross(self, other: Vector3) -> Vector3:
        raise NotImplementedError()

    @staticmethod
    def zero() -> Vector3:
        return Vector3(0.0, 0.0, 0.0)

    @staticmethod
    def from_carla_vector3d(v: carla.Vector3D) -> Vector3:
        return Vector3(v.x, v.y, v.z)


class AbsoluteVelocity:
    vector: Vector3
    frame: CoordinateFrame

    def __init__(self, vector: Vector3, frame: CoordinateFrame):
        self.vector = vector
        self.frame = frame

    # RelativeVelocity is defined below, so the operators that take one dispatch on
    # the operand, as Python's do, and refuse any other (docs/typecheck.md).
    def __add__(self, other):
        if isinstance(other, RelativeVelocity):
            return AbsoluteVelocity(self.vector, self.frame)
        else:
            compile_error("AbsoluteVelocity + x: x must be a RelativeVelocity")

    def __sub__(self, other):
        if isinstance(other, AbsoluteVelocity):
            return RelativeVelocity(self.vector, self.frame)
        elif isinstance(other, RelativeVelocity):
            return AbsoluteVelocity(self.vector, self.frame)
        else:
            compile_error("AbsoluteVelocity - x: x must be an AbsoluteVelocity or a RelativeVelocity")

    def __mul__(self, scalar: float) -> AbsoluteVelocity:
        raise NotImplementedError()

    def __rmul__(self, scalar: float) -> AbsoluteVelocity:
        raise NotImplementedError()

    def __truediv__(self, scalar: float) -> AbsoluteVelocity:
        raise NotImplementedError()

    def __neg__(self) -> AbsoluteVelocity:
        raise NotImplementedError()

    def speed(self) -> float:
        raise NotImplementedError()

    @staticmethod
    def zero(frame: CoordinateFrame) -> AbsoluteVelocity:
        return AbsoluteVelocity(Vector3.zero(), frame)

    @staticmethod
    def from_components(vx: float, vy: float, vz: float, frame: CoordinateFrame) -> AbsoluteVelocity:
        return AbsoluteVelocity(Vector3(vx, vy, vz), frame)

    @staticmethod
    def from_carla_vector3d(v: carla.Vector3D) -> AbsoluteVelocity:
        return AbsoluteVelocity(Vector3.from_carla_vector3d(v), CoordinateFrame.CARLA_WORLD)


class RelativeVelocity:
    vector: Vector3
    frame: CoordinateFrame

    def __init__(self, vector: Vector3, frame: CoordinateFrame):
        self.vector = vector
        self.frame = frame

    def __add__(self, other: RelativeVelocity) -> RelativeVelocity:
        raise NotImplementedError()

    def __add__(self, other: AbsoluteVelocity) -> AbsoluteVelocity:
        raise NotImplementedError()

    def __sub__(self, other: RelativeVelocity) -> RelativeVelocity:
        raise NotImplementedError()

    def __mul__(self, scalar: float) -> RelativeVelocity:
        raise NotImplementedError()

    def __rmul__(self, scalar: float) -> RelativeVelocity:
        raise NotImplementedError()

    def __truediv__(self, scalar: float) -> RelativeVelocity:
        raise NotImplementedError()

    def __neg__(self) -> RelativeVelocity:
        raise NotImplementedError()

    def speed(self) -> float:
        raise NotImplementedError()

    @staticmethod
    def zero(frame: CoordinateFrame) -> RelativeVelocity:
        return RelativeVelocity(Vector3.zero(), frame)

    @staticmethod
    def from_components(vx: float, vy: float, vz: float, frame: CoordinateFrame) -> RelativeVelocity:
        return RelativeVelocity(Vector3(vx, vy, vz), frame)

    @staticmethod
    def between(target: AbsoluteVelocity, reference: AbsoluteVelocity) -> RelativeVelocity:
        raise NotImplementedError()


class FrenetVelocity:
    longitudinal: float
    lateral: float

    def __init__(self, longitudinal: float, lateral: float):
        self.longitudinal = longitudinal
        self.lateral = lateral

    def __add__(self, other: FrenetVelocity) -> FrenetVelocity:
        raise NotImplementedError()

    def __sub__(self, other: FrenetVelocity) -> FrenetVelocity:
