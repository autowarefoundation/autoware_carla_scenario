# Model of autoware_carla_scenario.scenario_base (docs/typecheck.md).
#
# Only the attributes a scenario subclass is meant to touch are declared: a
# subclass that reads or writes another one of BaseScenario's attributes fails
# the check, as it would break when the base class changes.

import internal.static as static

import typesafe_carla.carla as carla

# Measure from beside the reader check, not from measures, which imports this
# module (_reader.codon).
from ._reader import Measure, _expect_reader
from ._tc import (_keyword_only, _expect_float, _expect_int_sequence, _expect_optional_float,
                  _acs_expect_return, _acs_takes, _expect_str_sequence)
from .actions import BaseAction, _expect_action
from .conditions import BaseCondition, _expect_condition
from .constants import DEFAULT_TM_PORT
from .coverage import (SamplingEvent, _expect_sampling_event, _expect_cover_expression,
                       _expect_optional_range, _expect_optional_edges, _expect_optional_values,
                       _expect_optional_ignore)
from .coordinate import (Lanelet2Pose, OpenDrivePose, CarlaWorldPose, GroundProjectionConfig,
                         _expect_optional_ground_projection)
from .entity import (EgoConfig, EgoVehicle, VehicleEntity, PedestrianEntity,
                     _expect_optional_ego_vehicle, _expect_optional_lanelet2_poses)


def _expect_action_or_callback(cb):
    """A Union[BaseAction, Callable[[carla.World], None]] argument."""
    if hasattr(cb, "_acs_action"):
        _expect_action(cb)
    else:
        cb(carla.Client().get_world())


def _expect_actor(actor, what: Literal[str]):
    """A carla.Actor or any subclass of it (carla.Vehicle, carla.Walker,
    carla.Sensor, ...), checked by kind (#278): Codon 0.19's isinstance()
    sees no subclass, so a class of a hierarchy is upcast (_acs_takes), which
    refuses any other class with the types named, and anything else is
    refused with *what*."""
    if isinstance(actor, carla.Actor):
        pass
    elif static.has_rtti(type(actor)):
        _acs_takes(actor, carla.Actor)
    else:
        compile_error(what)


def _expect_optional_actor(actor, what: Literal[str]):
    """An Optional[carla.Actor] argument: an actor of any subclass, an
    Optional of one, or None. Not a parameter typed Optional[carla.Actor]
    (or an annotated assignment), which Codon 0.19 refuses an
    Optional[carla.Vehicle] for (#278)."""
    if isinstance(actor, None):
        pass
    elif isinstance(actor, Optional[NoneType]):
        pass
    elif isinstance(actor, Optional):
        _expect_actor(unwrap(actor), what)
    else:
        _expect_actor(actor, what)


def _expect_actor_getter(actor_getter, where: Literal[str]):
    """A Callable[[], Optional[carla.Actor]] argument: a getter returning
    carla.Actor or any subclass of it, an Optional of one, or None (#278)."""
    _expect_optional_actor(actor_getter(), where + ": the getter must return a carla.Actor "
                           "(or a subclass of it, such as carla.Vehicle), or None")


class BaseScenario:
    ego_config: EgoConfig
    ego_entity: Optional[EgoVehicle]
    random_seed: int
    _spawn_pose: Optional[Lanelet2Pose]
    _ground_projection: GroundProjectionConfig
    DEFAULT_RANDOM_SEED: ClassVar[int] = 0
    STABILIZE_TICKS: ClassVar[int] = 5

    # Codon would build it by its fields' names too (docs/typecheck.md, #244).
    def __init__(self, ego_config, ego_entity, random_seed, _spawn_pose, _ground_projection):
        compile_error("BaseScenario(): no constructor takes these arguments (required: ego_config)")

    def __init__(self, ego_config: EgoConfig, *_kw, spawn_pose: Optional[Lanelet2Pose] = None,
                 ground_projection = None, random_seed: int = 0, ego_type = None,
                 ego_entity = None):
        _keyword_only(_kw, "BaseScenario(): every argument but ego_config")
        self.ego_config = ego_config
        self.ego_entity = _expect_optional_ego_vehicle(ego_entity)
        self.random_seed = random_seed
        self._spawn_pose = spawn_pose
        gp = _expect_optional_ground_projection(ground_projection)
        self._ground_projection = gp if gp is not None else GroundProjectionConfig()

    @property
    def goal_pose(self) -> Optional[Lanelet2Pose]:
        raise NotImplementedError()

    @goal_pose.setter
    def goal_pose(self, pose: Optional[Lanelet2Pose]):
        raise NotImplementedError()

    @property
    def waypoint_poses(self) -> List[Lanelet2Pose]:
        raise NotImplementedError()

    @waypoint_poses.setter
    def waypoint_poses(self, poses):
        _expect_optional_lanelet2_poses(poses)
        raise NotImplementedError()

    def create_ego(self) -> EgoVehicle:
        raise NotImplementedError()

    def set_client(self, client: carla.Client, tm_port: int = 8100) -> None:
        raise NotImplementedError()

    @property
    def client(self) -> carla.Client:
        raise NotImplementedError()

    @property
    def tm_port(self) -> int:
        raise NotImplementedError()

    @property
    def world(self) -> carla.World:
        raise NotImplementedError()

    def _setup_ego_spawn(self) -> OpenDrivePose:
        raise NotImplementedError()

    @property
    def ego_requires_goal(self) -> bool:
        raise NotImplementedError()

    def require_goal(self) -> Optional[Lanelet2Pose]:
        raise NotImplementedError()

    def derive_goal_from_route(self, route_lanelet_ids) -> None:
        _expect_int_sequence(route_lanelet_ids)
        raise NotImplementedError()

    def derive_waypoints_from_route(self, route_lanelet_ids) -> None:
        _expect_int_sequence(route_lanelet_ids)
        raise NotImplementedError()

    def register_route_to_goal(self, initial_pose: Optional[CarlaWorldPose] = None) -> None:
        raise NotImplementedError()

    def setup(self) -> None:
        raise NotImplementedError()

    def is_done(self) -> bool:
        raise NotImplementedError()

    def register_init(self, cb) -> None:
        _expect_action_or_callback(cb)
        raise NotImplementedError()

    def run_init(self, world: carla.World) -> None:
        raise NotImplementedError()

    def register_pre_tick(self, cb) -> None:
        _expect_action_or_callback(cb)
        raise NotImplementedError()

    def register_post_tick(self, cb) -> None:
        _expect_action_or_callback(cb)
        raise NotImplementedError()

    def register_entity(self, entity: VehicleEntity) -> None:
        raise NotImplementedError()

    def register_pedestrian(self, entity: PedestrianEntity) -> None:
        raise NotImplementedError()

    def register_pass_condition(self, condition: BaseCondition) -> None:
        _expect_condition(condition)
        raise NotImplementedError()

    def register_fail_condition(self, condition: BaseCondition) -> None:
        _expect_condition(condition)
        raise NotImplementedError()

    def register_measure(self, key: str, read, *_kw, unit: str = "", text: str = "") -> None:
        _keyword_only(_kw, "BaseScenario.register_measure(): every argument but key and read")
        _expect_reader(read)
        raise NotImplementedError()

    def measure(self, key: str, world: carla.World) -> Optional[float]:
        raise NotImplementedError()

    @property
    def importance_sampling_weight(self) -> float:
        raise NotImplementedError()

    @property
    def outcome_weight(self) -> Optional[float]:
        raise NotImplementedError()

    @property
    def measures(self) -> Dict[str, Measure]:
        raise NotImplementedError()

    def register_cover(self, name: str, expression, *_kw, unit: str = "", range = None,
                       every = None, buckets = None, values = None, ignore = None,
                       event = SamplingEvent("end"), text: str = "", target = 1.0,
                       cover_by: str = "hits", min_stay = None) -> None:
        _keyword_only(_kw, "BaseScenario.register_cover(): every argument but name and expression")
        _expect_cover_expression(expression)
        _expect_float(target)
        _expect_optional_float(min_stay)
        _expect_optional_range(range)
        _expect_optional_float(every)
        _expect_optional_edges(buckets)
        _expect_optional_values(values, "BaseScenario.register_cover()")
        _expect_optional_ignore(ignore, expression, "BaseScenario.register_cover()")
        _expect_sampling_event(event)
        raise NotImplementedError()

    def register_cross(self, name: str, items, *_kw, text: str = "",
                       target = 1.0, cover_by: str = "hits",
                       min_stay = None) -> None:
        _keyword_only(_kw, "BaseScenario.register_cross(): text, target, cover_by and min_stay")
        _expect_float(target)
        _expect_optional_float(min_stay)
        _expect_str_sequence(items, "BaseScenario.register_cross(): items")
        raise NotImplementedError()

    def follow_with_spectator(self, actor_getter, *_kw, offset_back: float = 8.0,
                              offset_up: float = 5.0, pitch: float = -15.0) -> None:
        _keyword_only(_kw, "BaseScenario.follow_with_spectator(): offset_back, offset_up and pitch")
        _expect_actor_getter(actor_getter, "BaseScenario.follow_with_spectator()")
        raise NotImplementedError()

    def log_actor_position(self, actor_getter, *_kw, label: str = "actor",
                           interval_ticks: int = 20) -> None:
        _keyword_only(_kw, "BaseScenario.log_actor_position(): label and interval_ticks")
        _expect_actor_getter(actor_getter, "BaseScenario.log_actor_position()")
        raise NotImplementedError()

    # ego_actor is Optional[carla.Actor] in Python, which takes an actor of any
    # subclass: generic here, checked by kind (#278).
    def initial_speeds_mps(self, ego_actor) -> Dict[int, float]:
        _expect_optional_actor(ego_actor, "BaseScenario.initial_speeds_mps(): ego_actor must be "
                               "a carla.Actor (or a subclass of it), or None")
        raise NotImplementedError()

    def set_initial_speed(self, ego_actor: carla.Actor) -> None:
        raise NotImplementedError()

    @staticmethod
    def _acs_hook_returns(name: Literal[str], r):
        """The return type of each method an override of which the scenario
        check checks (_acs_hook_return in _tc.codon, #238)."""
        if name == "goal_pose":
            _acs_expect_return(r, Optional[Lanelet2Pose], "BaseScenario.goal_pose returns Optional[Lanelet2Pose]")
        elif name == "importance_sampling_weight":
            _acs_expect_return(r, float, "BaseScenario.importance_sampling_weight returns float")
        elif name == "outcome_weight":
            _acs_expect_return(r, Optional[float], "BaseScenario.outcome_weight returns Optional[float]")
        elif name == "waypoint_poses":
            _acs_expect_return(r, List[Lanelet2Pose], "BaseScenario.waypoint_poses returns List[Lanelet2Pose]")
        elif name == "create_ego":
            _acs_expect_return(r, EgoVehicle, "BaseScenario.create_ego() returns EgoVehicle")
        elif name == "set_client":
            _acs_expect_return(r, NoneType, "BaseScenario.set_client() returns None")
        elif name == "client":
            _acs_expect_return(r, carla.Client, "BaseScenario.client returns carla.Client")
        elif name == "tm_port":
            _acs_expect_return(r, int, "BaseScenario.tm_port returns int")
        elif name == "world":
            _acs_expect_return(r, carla.World, "BaseScenario.world returns carla.World")
        elif name == "_setup_ego_spawn":
            _acs_expect_return(r, OpenDrivePose, "BaseScenario._setup_ego_spawn() returns OpenDrivePose")
        elif name == "ego_requires_goal":
            _acs_expect_return(r, bool, "BaseScenario.ego_requires_goal returns bool")
        elif name == "require_goal":
            _acs_expect_return(r, Optional[Lanelet2Pose], "BaseScenario.require_goal() returns Optional[Lanelet2Pose]")
        elif name == "derive_goal_from_route":
            _acs_expect_return(r, NoneType, "BaseScenario.derive_goal_from_route() returns None")
        elif name == "derive_waypoints_from_route":
            _acs_expect_return(r, NoneType, "BaseScenario.derive_waypoints_from_route() returns None")
        elif name == "register_route_to_goal":
            _acs_expect_return(r, NoneType, "BaseScenario.register_route_to_goal() returns None")
        elif name == "setup":
            _acs_expect_return(r, NoneType, "BaseScenario.setup() returns None")
        elif name == "is_done":
            _acs_expect_return(r, bool, "BaseScenario.is_done() returns bool")
        elif name == "register_init":
            _acs_expect_return(r, NoneType, "BaseScenario.register_init() returns None")
        elif name == "run_init":
            _acs_expect_return(r, NoneType, "BaseScenario.run_init() returns None")
        elif name == "register_pre_tick":
            _acs_expect_return(r, NoneType, "BaseScenario.register_pre_tick() returns None")
        elif name == "register_post_tick":
            _acs_expect_return(r, NoneType, "BaseScenario.register_post_tick() returns None")
        elif name == "register_entity":
            _acs_expect_return(r, NoneType, "BaseScenario.register_entity() returns None")
        elif name == "register_pedestrian":
            _acs_expect_return(r, NoneType, "BaseScenario.register_pedestrian() returns None")
        elif name == "register_pass_condition":
            _acs_expect_return(r, NoneType, "BaseScenario.register_pass_condition() returns None")
        elif name == "register_fail_condition":
            _acs_expect_return(r, NoneType, "BaseScenario.register_fail_condition() returns None")
        elif name == "register_measure":
            _acs_expect_return(r, NoneType, "BaseScenario.register_measure() returns None")
        elif name == "measure":
            _acs_expect_return(r, Optional[float], "BaseScenario.measure() returns Optional[float]")
        elif name == "measures":
            _acs_expect_return(r, Dict[str, Measure], "BaseScenario.measures returns Dict[str, Measure]")
        elif name == "register_cover":
            _acs_expect_return(r, NoneType, "BaseScenario.register_cover() returns None")
        elif name == "register_cross":
            _acs_expect_return(r, NoneType, "BaseScenario.register_cross() returns None")
        elif name == "follow_with_spectator":
            _acs_expect_return(r, NoneType, "BaseScenario.follow_with_spectator() returns None")
        elif name == "log_actor_position":
            _acs_expect_return(r, NoneType, "BaseScenario.log_actor_position() returns None")
        elif name == "initial_speeds_mps":
            _acs_expect_return(r, Dict[int, float], "BaseScenario.initial_speeds_mps() returns Dict[int, float]")
        elif name == "set_initial_speed":
            _acs_expect_return(r, NoneType, "BaseScenario.set_initial_speed() returns None")
