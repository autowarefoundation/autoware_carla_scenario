# Model of autoware_carla_scenario.entity (docs/typecheck.md).
#
# EgoConfig lives in scenario_base in Python; it is defined here, next to the
# EgoVehicle.spawn() that takes it, and scenario_base re-exports it. The spawn
# locations and the NPC vehicle are in _vehicle_entity.codon.

import typesafe_carla.carla as carla

from ._tc import _keyword_only, _acs_expect_return
from .constants import DEFAULT_TM_PORT, EGO_ROLE_NAME
from .debug_markers import DebugMarkers
from .coordinate import (Lanelet2Pose, OpenDrivePose, CarlaWorldPose, GroundProjectionConfig,
                         _expect_lanelet2_poses, _expect_optional_ground_projection)
from .traffic import LaneChangeDirection, SimulationFidelity, TurnDirection
from ._vehicle_entity import (SpawnLocation, SpawnPointIndex, SpawnTransform, VehicleEntity,
                              VehicleEntityConfig)
from .entity_role import _expect_role, _expect_role_name


def _expect_optional_lanelet2_poses(poses) -> List[Lanelet2Pose]:
    """An Optional[Sequence[Lanelet2Pose]] argument: None, or a sequence of
    Lanelet2 poses, an empty one too (`waypoint_poses = []`, #264)."""
    if isinstance(poses, None):
        return List[Lanelet2Pose]()
    elif isinstance(poses, Optional[NoneType]):
        return List[Lanelet2Pose]()
    elif isinstance(poses, Optional):
        if poses is not None:
            return _expect_lanelet2_poses(unwrap(poses))
        return List[Lanelet2Pose]()
    else:
        return _expect_lanelet2_poses(poses)


class EgoConfig(VehicleEntityConfig):
    goal_pose: Optional[Lanelet2Pose]
    waypoint_poses: List[Lanelet2Pose]

    # Codon would build it by its fields' names too (docs/typecheck.md, #244).
    def __init__(self, role_name, spawn_location, vehicle_type, initial_speed_kmh,
                 spawn_retry_max_count, spawn_retry_t_step, spawn_retry_z_step, od_pose,
                 ground_projection, goal_pose, waypoint_poses):
        compile_error("EgoConfig(): no constructor takes these arguments (required: spawn_location)")

    def __init__(self, spawn_location: SpawnLocation, vehicle_type: str = "vehicle.mini.cooper",
                 initial_speed_kmh: float = 0.0, spawn_retry_max_count: int = 0,
                 spawn_retry_t_step: float = 0.1, spawn_retry_z_step: float = 0.5, *_kw,
                 goal_pose: Optional[Lanelet2Pose] = None, waypoint_poses = None):
        _keyword_only(_kw, "EgoConfig(): goal_pose and waypoint_poses")
        super().__init__(str(EGO_ROLE_NAME), spawn_location, vehicle_type, initial_speed_kmh,
                         spawn_retry_max_count, spawn_retry_t_step, spawn_retry_z_step)
        self.goal_pose = goal_pose
        self.waypoint_poses = _expect_optional_lanelet2_poses(waypoint_poses)


class PedestrianEntityConfig:
    role_name: str
    spawn_location: SpawnTransform
    walker_type: str

    def __init__(self, role_name, spawn_location: SpawnTransform,
                 walker_type: str = "walker.pedestrian.0001"):
        self.role_name = _expect_role_name(role_name)
        self.spawn_location = spawn_location
        self.walker_type = walker_type


class PedestrianEntity:
    # No fields: Codon would build one with no arguments too (docs/typecheck.md).
    def __init__(self):
        compile_error("PedestrianEntity(): no constructor takes these arguments "
                      "(required: config)")

    def __init__(self, config: PedestrianEntityConfig):
        pass

    # Python compares and hashes a PedestrianEntity by identity (it defines no __eq__),
    # so one goes in a set, keys a dict and is found with `in` (#596).
    def __eq__(self, other: PedestrianEntity) -> bool:
        return self is other

    def __ne__(self, other: PedestrianEntity) -> bool:
        return self is not other

    def __hash__(self) -> int:
        return id(self)

    @property
    def role_name(self) -> str:
        raise NotImplementedError()

    @property
    def walker_type(self) -> str:
        raise NotImplementedError()

    @property
    def actor(self) -> Optional[carla.Actor]:
        raise NotImplementedError()

    def spawn(self, world: carla.World) -> carla.Actor:
        raise NotImplementedError()

    def destroy(self) -> None:
        raise NotImplementedError()

    def walk_straight(self, speed_ms: float, yaw_deg: Optional[float] = None) -> None:
        raise NotImplementedError()

    def route_to(self, world: carla.World, goal: Lanelet2Pose, *_kw,
                 initial_pose: Optional[CarlaWorldPose] = None, ground_projection = None,
                 waypoints = (), walking_speed: float = 1.4, cross_factor = None) -> None:
        _keyword_only(_kw, "PedestrianEntity.route_to(): initial_pose, ground_projection, waypoints, walking_speed and cross_factor")
        _expect_optional_ground_projection(ground_projection)
        _expect_lanelet2_poses(waypoints)
        raise NotImplementedError()

    @property
    def walking(self) -> bool:
        raise NotImplementedError()

    def walk_on(self, speed_mps: Optional[float] = None) -> None:
        raise NotImplementedError()

    def release_from_traffic(self, world: carla.World) -> None:
        raise NotImplementedError()


class EgoVehicle:
    use_autopilot: ClassVar[bool] = True
    requires_goal: ClassVar[bool] = False
    attaches_to_existing_actor: ClassVar[bool] = False
    simulation_fidelity: ClassVar[SimulationFidelity] = SimulationFidelity.MICROSCOPIC

    def __init__(self):
        pass

    # Python compares and hashes an EgoVehicle by identity (it defines no __eq__),
    # so one goes in a set, keys a dict and is found with `in` (#596).
    def __eq__(self, other: EgoVehicle) -> bool:
        return self is other

    def __ne__(self, other: EgoVehicle) -> bool:
        return self is not other

    def __hash__(self) -> int:
        return id(self)

    def _acs_ego_vehicle(self) -> int:
        return 0

    @staticmethod
    def _acs_hook_returns(name: Literal[str], r):
        """The return type of each method an override of which the scenario
        check checks (_acs_hook_return in _tc.codon, #238)."""
        if name == "actor":
            _acs_expect_return(r, Optional[carla.Actor], "EgoVehicle.actor returns Optional[carla.Actor]")
        elif name == "is_initialized":
            _acs_expect_return(r, bool, "EgoVehicle.is_initialized returns bool")
        elif name == "carried_actor_ids":
            _acs_expect_return(r, Set[int], "EgoVehicle.carried_actor_ids returns Set[int]")
        elif name == "set_initial_speeds":
            _acs_expect_return(r, NoneType, "EgoVehicle.set_initial_speeds() returns None")
        elif name == "termination_requested":
            _acs_expect_return(r, bool, "EgoVehicle.termination_requested returns bool")
        elif name == "termination_reason":
            _acs_expect_return(r, Optional[str], "EgoVehicle.termination_reason returns Optional[str]")
        elif name == "route_to":
            _acs_expect_return(r, NoneType, "EgoVehicle.route_to() returns None")
        elif name == "set_client":
            _acs_expect_return(r, NoneType, "EgoVehicle.set_client() returns None")
        elif name == "change_lane":
            _acs_expect_return(r, NoneType, "EgoVehicle.change_lane() returns None")
        elif name == "lane_change_finished":
            _acs_expect_return(r, bool, "EgoVehicle.lane_change_finished() returns bool")
        elif name == "set_desired_speed":
            _acs_expect_return(r, NoneType, "EgoVehicle.set_desired_speed() returns None")
        elif name == "turn_at_junction":
            _acs_expect_return(r, NoneType, "EgoVehicle.turn_at_junction() returns None")
        elif name == "follow_route":
            _acs_expect_return(r, NoneType, "EgoVehicle.follow_route() returns None")
        elif name == "finish_at":
            _acs_expect_return(r, bool, "EgoVehicle.finish_at() returns bool")
        elif name == "release_from_traffic":
            _acs_expect_return(r, NoneType, "EgoVehicle.release_from_traffic() returns None")
        elif name == "resume_traffic":
            _acs_expect_return(r, NoneType, "EgoVehicle.resume_traffic() returns None")
        elif name == "require_microscopic":
            _acs_expect_return(r, bool, "EgoVehicle.require_microscopic() returns bool")
        elif name == "forget_lane_change":
            _acs_expect_return(r, NoneType, "EgoVehicle.forget_lane_change() returns None")
        elif name == "spawn":
            _acs_expect_return(r, carla.Actor, "EgoVehicle.spawn() returns carla.Actor")
        elif name == "on_scenario_start":
            _acs_expect_return(r, NoneType, "EgoVehicle.on_scenario_start() returns None")
        elif name == "on_tick":
            _acs_expect_return(r, NoneType, "EgoVehicle.on_tick() returns None")
        elif name == "debug_markers":
            _acs_expect_return(r, DebugMarkers, "EgoVehicle.debug_markers() returns DebugMarkers")
        elif name == "on_scenario_end":
            _acs_expect_return(r, NoneType, "EgoVehicle.on_scenario_end() returns None")
        elif name == "destroy":
            _acs_expect_return(r, NoneType, "EgoVehicle.destroy() returns None")

    @property
    def actor(self) -> Optional[carla.Actor]:
        raise NotImplementedError()

    @property
    def is_initialized(self) -> bool:
        raise NotImplementedError()

    @property
    def carried_actor_ids(self) -> Set[int]:
        raise NotImplementedError()

    def set_initial_speeds(self, speeds_mps: Dict[int, float]) -> None:
        raise NotImplementedError()

    @property
    def termination_requested(self) -> bool:
        raise NotImplementedError()

    @property
    def termination_reason(self) -> Optional[str]:
        raise NotImplementedError()

    def route_to(self, world: carla.World, goal: Lanelet2Pose, *_kw,
                 initial_pose: Optional[CarlaWorldPose] = None, ground_projection = None,
                 waypoints = ()) -> None:
        _keyword_only(_kw, "EgoVehicle.route_to(): initial_pose, ground_projection and waypoints")
        # Sequence[Lanelet2Pose] and Optional[GroundProjectionConfig], as
        # RoutingAction checks them (#264).
        _expect_optional_ground_projection(ground_projection)
        _expect_lanelet2_poses(waypoints)
        raise NotImplementedError()

    # The manoeuvres of traffic.driven.BackendDriven, which EgoVehicle mixes
    # in: each is handed to the traffic backend that drives the ego (#265).
    # set_traffic_backend() is the runner's (typecheck/not_modelled.py).
    def set_client(self, client: carla.Client, tm_port: int = DEFAULT_TM_PORT) -> None:
        raise NotImplementedError()

    def change_lane(self, world: carla.World, direction: LaneChangeDirection) -> None:
        raise NotImplementedError()

    def lane_change_finished(self, world: carla.World) -> bool:
        raise NotImplementedError()

    def set_desired_speed(self, world: carla.World, speed_kmh: float) -> None:
        raise NotImplementedError()

    def turn_at_junction(self, world: carla.World, direction: TurnDirection, **kwargs) -> None:
        raise NotImplementedError()

    def follow_route(self, world: carla.World, stops: List[Lanelet2Pose]) -> None:
        raise NotImplementedError()

    def finish_at(self, world: carla.World, points: List[carla.Location]) -> bool:
        raise NotImplementedError()

    def release_from_traffic(self, world: carla.World) -> None:
        raise NotImplementedError()

    def resume_traffic(self, world: carla.World) -> None:
        raise NotImplementedError()

    def require_microscopic(self, world: carla.World) -> bool:
        raise NotImplementedError()

    def forget_lane_change(self) -> None:
        raise NotImplementedError()

    def spawn(self, world: carla.World, config: EgoConfig) -> carla.Actor:
        raise NotImplementedError()

    def on_scenario_start(self, world: carla.World) -> None:
        raise NotImplementedError()

    def on_tick(self, world: carla.World, elapsed: float) -> None:
        raise NotImplementedError()

    def debug_markers(self) -> DebugMarkers:
        raise NotImplementedError()

    def on_scenario_end(self, world: carla.World) -> None:
        raise NotImplementedError()

    def destroy(self) -> None:
        raise NotImplementedError()


# entity.carla_driver_entity imports grpc and carla_driver_interface's protocol,
# and the checked entity package re-exports CarlaDriverEntity: only the name is
# needed, as no checked module builds or uses one. Its constructor is declared
# as Python's, and any call to it fails the check, as its configs (the checked
# DriverClientConfig and ControlConfig) are not in the model: a scenario cannot
# build one that the run would then refuse. It does not derive from EgoVehicle
# here: nothing is declared of it but its constructor, and a subclass of this
# EgoVehicle that nothing builds breaks Codon 0.19's code generation for every
# scenario ("LLVM: error: value doesn't match function result type").
class CarlaDriverEntity:
    def __init__(self, config=None, control_config=None, client=None, *_kw, bridge=None,
                 bridge_config=None, launcher=None, episode_name: str = ""):
        compile_error("CarlaDriverEntity is not modelled: the static check cannot "
                      "build one (typecheck/codon/autoware_carla_scenario/entity.codon)")



# entity.hils_entity imports socket and hils.protocol (socket); the checked
# actions.communication_loss reaches the HILS ego through find_hils_entity()
# (Codon resolves isinstance() of a vehicle by its static type) and calls its
# disconnect() and reconnect(). Only those are declared; the constructor is
# Python's and any call to it fails the check, as its HilsEgoConfig is not in
# the model: a scenario cannot build one (ego.entity=hils builds it).
class HilsEgoEntity:
    def __init__(self, config=None, episode_name: str = ""):
        compile_error("HilsEgoEntity is not modelled: the static check cannot "
                      "build one (typecheck/codon/autoware_carla_scenario/entity.codon)")

    # Optional[Sequence[str]] in Python: the checked caller hands a tuple.
    def disconnect(self, device: Optional[str] = None, messages = None,
                   direction: str = "both") -> Optional[str]:
        raise NotImplementedError()

    def reconnect(self, cut_id: str) -> bool:
        raise NotImplementedError()


def find_hils_entity(role_name) -> Optional[HilsEgoEntity]:
    _expect_role(role_name)
    return None

def _expect_optional_ego_vehicle(ego) -> Optional[EgoVehicle]:
    """An Optional[EgoVehicle] argument (Codon's Optional does not take a subclass)."""
    if isinstance(ego, None):
        return None
    elif isinstance(ego, Optional[NoneType]):
        return None
    elif isinstance(ego, Optional):
        if ego is None:
            return None
        return _expect_ego_vehicle(unwrap(ego))
    else:
        return _expect_ego_vehicle(ego)


def _expect_ego_vehicle(ego: EgoVehicle) -> EgoVehicle:
    return ego
