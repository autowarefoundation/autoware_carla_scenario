# Model of autoware_carla_scenario.entity (docs/typecheck.md).
#
# EgoConfig lives in scenario_base in Python; it is defined here, next to the
# EgoVehicle.spawn() that takes it, and scenario_base re-exports it. The spawn
# locations and the NPC vehicle are in _vehicle_entity.codon.

import typesafe_carla.carla as carla

from ._tc import _keyword_only
from .constants import EGO_ROLE_NAME
from .debug_markers import DebugMarkers
from .coordinate import (Lanelet2Pose, OpenDrivePose, CarlaWorldPose, GroundProjectionConfig,
                         _expect_optional_ground_projection)
from ._vehicle_entity import (SpawnLocation, SpawnPointIndex, SpawnTransform, VehicleEntity,
                              VehicleEntityConfig)
from .entity_role import _expect_role_name


def _expect_optional_lanelet2_poses(poses) -> List[Lanelet2Pose]:
    """An Optional[Sequence[Lanelet2Pose]] argument."""
    out = List[Lanelet2Pose]()
    if isinstance(poses, None):
        pass
    elif isinstance(poses, Optional[NoneType]):
        pass
    elif isinstance(poses, Optional):
        if poses is not None:
            for pose in unwrap(poses):
                out.append(pose)
    else:
        for pose in poses:
            out.append(pose)
    return out


class EgoConfig(VehicleEntityConfig):
    goal_pose: Optional[Lanelet2Pose]
    waypoint_poses: List[Lanelet2Pose]

    def __init__(self, spawn_location: SpawnLocation, vehicle_type: str = "vehicle.mini.cooper",
                 initial_speed_kmh: float = 0.0, spawn_retry_max_count: int = 0,
                 spawn_retry_t_step: float = 0.1, spawn_retry_z_step: float = 0.5, *_kw,
                 goal_pose: Optional[Lanelet2Pose] = None, waypoint_poses = None):
        _keyword_only(_kw, "EgoConfig(): goal_pose and waypoint_poses")
        super().__init__(str(EGO_ROLE_NAME), spawn_location, vehicle_type, initial_speed_kmh,
                         spawn_retry_max_count, spawn_retry_t_step, spawn_retry_z_step)
        self.goal_pose = goal_pose
        self.waypoint_poses = _expect_optional_lanelet2_poses(waypoint_poses)


class PedestrianEntityConfig:
    role_name: str
    spawn_location: SpawnTransform
    walker_type: str

    def __init__(self, role_name, spawn_location: SpawnTransform,
                 walker_type: str = "walker.pedestrian.0001"):
        self.role_name = _expect_role_name(role_name)
        self.spawn_location = spawn_location
        self.walker_type = walker_type


class PedestrianEntity:
    def __init__(self, config: PedestrianEntityConfig):
        pass

    @property
    def role_name(self) -> str:
        raise NotImplementedError()

    @property
    def walker_type(self) -> str:
        raise NotImplementedError()

    @property
    def actor(self) -> Optional[carla.Actor]:
        raise NotImplementedError()

    def spawn(self, world: carla.World) -> carla.Actor:
        raise NotImplementedError()

    def destroy(self) -> None:
        raise NotImplementedError()

    def walk_straight(self, speed_ms: float) -> None:
        raise NotImplementedError()


class EgoVehicle:
    use_autopilot: ClassVar[bool] = True
    requires_goal: ClassVar[bool] = False
    attaches_to_existing_actor: ClassVar[bool] = False

    def __init__(self):
        pass

    def _acs_ego_vehicle(self) -> int:
        return 0

    @property
    def actor(self) -> Optional[carla.Actor]:
        raise NotImplementedError()

    @property
    def is_initialized(self) -> bool:
        raise NotImplementedError()

    @property
    def carried_actor_ids(self) -> Set[int]:
        raise NotImplementedError()

    def set_initial_speeds(self, speeds_mps: Dict[int, float]) -> None:
        raise NotImplementedError()

    @property
    def termination_requested(self) -> bool:
        raise NotImplementedError()

    @property
    def termination_reason(self) -> Optional[str]:
        raise NotImplementedError()

    def route_to(self, world: carla.World, goal: Lanelet2Pose, *_kw,
                 initial_pose: Optional[CarlaWorldPose] = None, ground_projection = None,
                 waypoints = ()) -> None:
        _keyword_only(_kw, "EgoVehicle.route_to(): initial_pose, ground_projection and waypoints")
        raise NotImplementedError()

    def spawn(self, world: carla.World, config: EgoConfig) -> carla.Actor:
        raise NotImplementedError()

    def on_scenario_start(self, world: carla.World) -> None:
        raise NotImplementedError()

    def on_tick(self, world: carla.World, elapsed: float) -> None:
        raise NotImplementedError()

    def debug_markers(self) -> DebugMarkers:
        raise NotImplementedError()

    def on_scenario_end(self, world: carla.World) -> None:
        raise NotImplementedError()

    def destroy(self) -> None:
        raise NotImplementedError()


# entity.carla_driver_entity imports grpc and carla_driver_interface's protocol,
# and the checked entity package re-exports CarlaDriverEntity: only the name is
# needed, as no checked module builds or uses one. Its constructor is declared
# as Python's, and any call to it fails the check, as its configs (the checked
# DriverClientConfig and ControlConfig) are not in the model: a scenario cannot
# build one that the run would then refuse. It does not derive from EgoVehicle
# here: nothing is declared of it but its constructor, and a subclass of this
# EgoVehicle that nothing builds breaks Codon 0.19's code generation for every
# scenario ("LLVM: error: value doesn't match function result type").
class CarlaDriverEntity:
    def __init__(self, config=None, control_config=None, client=None, *_kw, bridge=None,
                 bridge_config=None, launcher=None, episode_name: str = ""):
        compile_error("CarlaDriverEntity is not modelled: the static check cannot "
                      "build one (typecheck/codon/autoware_carla_scenario/entity.codon)")


def _expect_optional_ego_vehicle(ego) -> Optional[EgoVehicle]:
    """An Optional[EgoVehicle] argument (Codon's Optional does not take a subclass)."""
    if isinstance(ego, None):
        return None
    elif isinstance(ego, Optional[NoneType]):
        return None
    elif isinstance(ego, Optional):
        if ego is None:
            return None
        return _expect_ego_vehicle(unwrap(ego))
    else:
        return _expect_ego_vehicle(ego)


def _expect_ego_vehicle(ego: EgoVehicle) -> EgoVehicle:
    return ego
