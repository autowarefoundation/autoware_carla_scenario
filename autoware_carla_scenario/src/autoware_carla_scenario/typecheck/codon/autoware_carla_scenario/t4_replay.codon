# Model of autoware_carla_scenario.trajectory.replay (docs/typecheck.md).
#
# blueprint_for is a callable (T4ObjectTrack -> str): generic here, and called
# once on a track so a function of the wrong shape is refused.

import typesafe_carla.carla as carla

from ._tc import _keyword_only
from .actions import FollowTrajectoryAction
from .entity import EgoConfig, SpawnTransform
from .scenario_base import BaseScenario
from .trajectory import (T4Category, T4ObjectTrack, T4SceneTranscription,
                         TrajectoryFollowingMode, _expect_optional_timing)


def _expect_blueprint_chooser(blueprint_for):
    if isinstance(blueprint_for, None):
        pass
    elif isinstance(blueprint_for, Optional[NoneType]):
        pass
    else:
        name: str = blueprint_for(T4ObjectTrack(0, 0, T4Category.VEHICLE, 0.0, 0.0, 0.0,
                                                List[int](), List[int]()))


def replay_t4_objects(scenario: BaseScenario, transcription: T4SceneTranscription, *_kw,
                      following_mode: TrajectoryFollowingMode = TrajectoryFollowingMode("position"),
                      time_reference = None, categories = None, blueprint_for = None,
                      role_prefix: str = "t4",
                      hide_when_absent: bool = True) -> List[FollowTrajectoryAction]:
    _keyword_only(_kw, "replay_t4_objects(): every argument but scenario and transcription")
    _expect_optional_timing(time_reference)
    _expect_blueprint_chooser(blueprint_for)
    raise NotImplementedError()


def _expect_transcription(transcription):
    """A T4SceneTranscription, or the path of a saved one."""
    if isinstance(transcription, T4SceneTranscription):
        pass
    elif isinstance(transcription, str):
        pass
    else:
        compile_error("expected a T4SceneTranscription or the path of a saved one")


class T4ReplayScenario(BaseScenario):
    transcription: T4SceneTranscription
    replay_ego: bool
    following_mode: TrajectoryFollowingMode
    object_actions: List[FollowTrajectoryAction]

    def __init__(self, transcription, ego_config: Optional[EgoConfig] = None, *_kw,
                 replay_ego: bool = False,
                 following_mode: TrajectoryFollowingMode = TrajectoryFollowingMode("position"),
                 categories = None, blueprint_for = None, **kwargs):
        _keyword_only(_kw, "T4ReplayScenario(): every argument but transcription and "
                           "ego_config")
        _expect_transcription(transcription)
        _expect_blueprint_chooser(blueprint_for)
        super().__init__(EgoConfig(SpawnTransform(carla.Transform())), **kwargs)
        self.replay_ego = replay_ego
        self.following_mode = following_mode
        self.object_actions = List[FollowTrajectoryAction]()

    def setup(self) -> None:
        raise NotImplementedError()

    def is_done(self) -> bool:
        raise NotImplementedError()
