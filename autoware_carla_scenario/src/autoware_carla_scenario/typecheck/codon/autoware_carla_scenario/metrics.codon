# Model of autoware_carla_scenario.metrics (docs/metrics.md): the keys of the
# built-in metrics, AlpaSim's metric names, which a scenario passes to
# MetricCondition or read_metric(), the Metric they are read with and the
# built-in ones by key (BUILT_IN_METRICS). test_typecheck_model.py compares
# every name with the Python one, the keys and each built-in metric's fields
# by value.
#
# Nothing here reads a metric: a built-in metric's `read` is _acs_unread(),
# where Python's is a private function of the module, which no scenario
# imports. Every other field holds Python's value.

import typesafe_carla.carla as carla

# Under an _acs_ name: no name of the module in Python.
from ._reader import _expect_reader as _acs_expect_read

COLLISION_ANY: str = "collision_any"
COLLISION_FRONT: str = "collision_front"
COLLISION_REAR: str = "collision_rear"
COLLISION_LATERAL: str = "collision_lateral"
COLLISION_AT_FAULT: str = "collision_at_fault"
OFFROAD: str = "offroad"
OFFROAD_OR_COLLISION: str = "offroad_or_collision"
OFFROAD_OR_COLLISION_AT_FAULT: str = "offroad_or_collision_at_fault"
WRONG_LANE: str = "wrong_lane"
MIN_DISTANCE_TO_OBSTACLE_M: str = "min_distance_to_obstacle_m"
MIN_DISTANCE_TO_LANE_BOUNDARY_M: str = "min_distance_to_lane_boundary_m"
IMPORTANCE_SAMPLING_WEIGHT: str = "importance_sampling_weight"
LATERAL_REVERSALS: str = "lateral_reversals"
LATERAL_WOBBLE_M: str = "lateral_wobble_m"
STEERING_REVERSALS: str = "steering_reversals"


def _acs_unread(world: carla.World) -> Optional[float]:
    raise NotImplementedError()


# A frozen dataclass in Python, so @tuple here: an assignment to a field fails
# the check as it fails the run.
@tuple
class Metric:
    key: str
    read: Callable[[carla.World], Optional[float]]
    title: str = ""
    unit: str = ""
    text: str = ""
    aggregation: str = "max"

    # Python takes any callable of a world that returns a float or None: a
    # function returning `float`, a lambda. Codon 0.19 crashes on one whose
    # type is not the field's exactly ("Codon compiler crashed", no line), so
    # *read* is called with a world here (_reader.codon), refused at its line
    # when it returns anything but a float, an int or None, and the field
    # holds the stub: nothing in the model reads.
    def __new__(key: str, read, title: str = "", unit: str = "", text: str = "",
                aggregation: str = "max") -> Metric:
        _acs_expect_read(read)
        unread = Callable[[carla.World], Optional[float]](_acs_unread)
        return __internal__.tuple_cast_unsafe(
            (key, unread, title, unit, text, aggregation), Metric
        )


BUILT_IN_METRICS: Dict[str, Metric] = {
    COLLISION_ANY: Metric(
        COLLISION_ANY,
        _acs_unread,
        title="Collision (any)",
        text="1 while the ego's bounding box overlaps another vehicle's or "
        "a pedestrian's, else 0 (AlpaSim collision_any)",
    ),
    COLLISION_FRONT: Metric(
        COLLISION_FRONT,
        _acs_unread,
        title="Collision (front)",
        text="1 while another road user's box overlaps the ego's front edge "
        "(AlpaSim collision_front)",
    ),
    COLLISION_REAR: Metric(
        COLLISION_REAR,
        _acs_unread,
        title="Collision (rear)",
        text="1 while another road user's box overlaps the ego's rear edge "
        "and not its front (AlpaSim collision_rear)",
    ),
    COLLISION_LATERAL: Metric(
        COLLISION_LATERAL,
        _acs_unread,
        title="Collision (lateral)",
        text="1 while another road user's box overlaps the ego's and "
        "neither its front nor its rear edge (AlpaSim collision_lateral)",
    ),
    COLLISION_AT_FAULT: Metric(
        COLLISION_AT_FAULT,
        _acs_unread,
        title="Collision at fault",
        text="1 during a front or a lateral collision "
        "(AlpaSim collision_at_fault)",
    ),
    OFFROAD: Metric(
        OFFROAD,
        _acs_unread,
        title="Off the road",
        text="1 while a corner of the ego's box is on no driving lane "
        "(AlpaSim offroad)",
    ),
    OFFROAD_OR_COLLISION: Metric(
        OFFROAD_OR_COLLISION,
        _acs_unread,
        title="Off the road or collision",
        text="1 while off the road or in any collision "
        "(AlpaSim offroad_or_collision)",
    ),
    OFFROAD_OR_COLLISION_AT_FAULT: Metric(
        OFFROAD_OR_COLLISION_AT_FAULT,
        _acs_unread,
        title="Off the road or collision at fault",
        text="1 while off the road or in a collision at fault "
        "(AlpaSim offroad_or_collision_at_fault)",
    ),
    WRONG_LANE: Metric(
        WRONG_LANE,
        _acs_unread,
        title="Against the lane",
        text="1 while the ego heads more than 120 degrees away from the "
        "driving lane under it, else 0; unread off the road "
        "(AlpaSim wrong_lane)",
    ),
    MIN_DISTANCE_TO_OBSTACLE_M: Metric(
        MIN_DISTANCE_TO_OBSTACLE_M,
        _acs_unread,
        title="Distance to obstacle",
        unit="m",
        text="Box to box, to the nearest other vehicle or pedestrian; 0 "
        "when touching (AlpaSim min_distance_to_obstacle_m)",
        aggregation="min",
    ),
    MIN_DISTANCE_TO_LANE_BOUNDARY_M: Metric(
        MIN_DISTANCE_TO_LANE_BOUNDARY_M,
        _acs_unread,
        title="Distance to lane edge",
        unit="m",
        text="From the ego's box to the edge of the driving lanes around "
        "it; 0 off the road (AlpaSim min_distance_to_lane_boundary_m)",
        aggregation="min",
    ),
    IMPORTANCE_SAMPLING_WEIGHT: Metric(
        IMPORTANCE_SAMPLING_WEIGHT,
        _acs_unread,
        title="Importance-sampling weight",
        unit="ratio",
        text="The run's likelihood ratio so far, the product of NADE's "
        "p/q and (1-p)/(1-q) (1 without NADE); a batch of runs weighted "
        "by its last value estimates the naturalistic rate",
        aggregation="last",
    ),
    LATERAL_REVERSALS: Metric(
        LATERAL_REVERSALS,
        _acs_unread,
        title="Weaving (reversals)",
        unit="count",
        text="How many times so far the ego's drift across its lane turned "
        "back by more than 0.1 m; a lane change is a drift, not a reversal",
        aggregation="last",
    ),
    LATERAL_WOBBLE_M: Metric(
        LATERAL_WOBBLE_M,
        _acs_unread,
        title="Weaving (amplitude)",
        unit="m",
        text="How far the ego strayed across its lane about its course "
        "over the last 4 s, RMS",
        aggregation="max",
    ),
    STEERING_REVERSALS: Metric(
        STEERING_REVERSALS,
        _acs_unread,
        title="Steering reversals",
        unit="count",
        text="How many times so far the steering applied to the ego "
        "turned back by more than 0.01 of full lock",
        aggregation="last",
    ),
}


def is_metric(key: str) -> bool:
    raise NotImplementedError()


def read_metric(key: str, world: carla.World) -> Optional[float]:
    raise NotImplementedError()


def set_importance_sampling_weight(weight: Optional[float]) -> None:
    raise NotImplementedError()


def reset_ego_motion() -> None:
    raise NotImplementedError()


def track_ego_motion(world: carla.World, elapsed: float) -> None:
    raise NotImplementedError()
