        aggregation="max",
    ),
    REACH_DRIVABLE_AREA_M2: Metric(
        REACH_DRIVABLE_AREA_M2,
        _acs_unread,
        title="Drivable area (CommonRoad-Reach)",
        unit="m^2",
        text="Road the ego can still reach without a collision at the end "
