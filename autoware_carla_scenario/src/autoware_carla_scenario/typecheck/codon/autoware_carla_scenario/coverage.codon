# Model of autoware_carla_scenario.coverage (docs/typecheck.md).
#
# Only what a scenario names: the sampling event of a cover item.  Cover items
# themselves are declared through BaseScenario.register_cover().  CoverItem and
# CrossItem are declared for the library check (scenario_base, which holds
# them), with only the name scenario_base reads; a scenario never builds one.
# CoverageCollector and prepare_measures() (below) are what the checked
# scenario_runner uses of it.
# COVERAGE_SCHEMA, CoverGroup, CoverageReport and merge_coverage() are
# declared for the library check of the package's __init__, which re-exports
# them (openodd's, a Rust extension).

from pathlib import Path

import internal.static as static

import typesafe_carla.carla as carla

from ._tc import _expect_float, _expect_optional_float, _keyword_only, _acs_sequence
from .conditions import BaseCondition, _expect_condition


@tuple
class SamplingEvent:
    value: str
    START: ClassVar[SamplingEvent] = SamplingEvent("start")
    END: ClassVar[SamplingEvent] = SamplingEvent("end")
    TICK: ClassVar[SamplingEvent] = SamplingEvent("tick")


# The schema a coverage file names (openodd.collector.COVERAGE_SCHEMA).
COVERAGE_SCHEMA: str = "openodd.coverage/1"


@tuple
class CoverGroup:
    value: str
    ODD: ClassVar[CoverGroup] = CoverGroup("odd")
    SITUATION: ClassVar[CoverGroup] = CoverGroup("situation")
    SCENARIO: ClassVar[CoverGroup] = CoverGroup("scenario")


def _expect_sampling_event(event):
    """A Union[SamplingEvent, BaseCondition] argument."""
    if hasattr(event, "_acs_condition"):
        _expect_condition(event)
    elif isinstance(event, SamplingEvent):
        pass
    else:
        compile_error("event must be a SamplingEvent or a condition")


def _expect_cover_expression(expression):
    """A Callable[[carla.World], Any] argument: a cover expression or an ODD probe."""
    expression(carla.Client().get_world())


def _expect_optional_range(r):
    """An Optional[tuple[float, float]] argument."""
    if isinstance(r, None):
        pass
    elif isinstance(r, Optional[NoneType]):
        pass
    else:
        low, high = r
        _expect_float(low)
        _expect_float(high)


def _expect_optional_edges(edges):
    """An Optional[Sequence[float]] argument (an empty one too, #264)."""
    if isinstance(edges, None):
        pass
    elif isinstance(edges, Optional[NoneType]):
        pass
    else:
        for edge in _acs_sequence(edges, float):
            _expect_float(edge)


def _expect_optional_values(values, where: Literal[str]):
    """An Optional[Iterable[Any]] argument: the values of a cover item or an
    ODD attribute, one bucket each (#279). Any iterable passes (a list, a
    tuple, an empty one too, #264, a set, a dict, a str, a range), and so
    does an enum class: the framework's are tuples here (so iterable), and a
    scenario's carries Enum's marker (enum.codon). Nothing is iterated, as
    iterating an enum class is not modelled. Codon 0.19 cannot tell a class
    passed as an argument from one of its objects, so an enum member passes
    too, and so does a frozen dataclass of the framework, a tuple here."""
    if isinstance(values, None):
        pass
    elif isinstance(values, Optional[NoneType]):
        pass
    elif isinstance(values, Optional):
        _expect_optional_values(unwrap(values), where)
    elif hasattr(values, "__iter__"):
        pass
    elif hasattr(values, "_acs_enum"):
        pass
    else:
        compile_error(where + ": values must be an iterable of the bucket values "
                      "(a list, a tuple or an enum class), or None")


def _acs_call_ignore(ignore, value, where: Literal[str]):
    """*ignore* called as openodd's collector calls it: with one sampled value."""
    if isinstance(ignore, Partial):
        # A function, a lambda or a bound method: its signature is checked
        # first, so a wrong one is refused with what ignore takes.
        if not static.function.can_call(ignore, value):
            compile_error(where + ": ignore must take one argument, a value the "
                          "expression returns")
    ignore(value)


def _expect_optional_ignore(ignore, expression, where: Literal[str]):
    """An Optional[Callable[[Any], bool]] argument, called with what
    *expression* returns, unwrapped from its Optional: the collector calls
    `ignore(value)` for each sample, never with None (#279). An exception it
    raises there is logged once and the sample counted as none, so a wrong
    *ignore* would empty the item for the whole run. What it returns is
    tested for truth, which Python takes of any value: it is not checked."""
    if isinstance(ignore, None):
        pass
    elif isinstance(ignore, Optional[NoneType]):
        pass
    elif isinstance(ignore, Optional):
        _expect_optional_ignore(unwrap(ignore), expression, where)
    elif not hasattr(ignore, "__call__"):
        compile_error(where + ": ignore must be a callable taking a sampled value "
                      "(Callable[[Any], bool]), or None")
    else:
        value = expression(carla.Client().get_world())
        if isinstance(value, None):
            pass
        elif isinstance(value, Optional[NoneType]):
            pass
        elif isinstance(value, Optional):
            _acs_call_ignore(ignore, unwrap(value), where)
        else:
            _acs_call_ignore(ignore, value, where)


class CoverItem:
    name: str

    # Codon would build it by its fields too (docs/typecheck.md, #244).
    def __init__(self, name):
        compile_error("CoverItem(): no constructor takes these arguments "
                      "(required: name, expression)")

    def __init__(self, name: str, expression, unit: str = "", range = None, every = None,
                 buckets = None, values = None, ignore = None, event = SamplingEvent("end"),
                 text: str = "", target = 1.0, group = None, cover_by: str = "hits",
                 min_stay = None, attribute = None):
        self.name = name

    # Python's dataclass fields but name, read as properties (#298): fields
    # here would change the constructor Codon generates. Writing one is
    # refused, which Python allows; a scenario registers its items with
    # register_cover() and has no CoverItem to write.
    @property
    def unit(self) -> str:
        raise NotImplementedError()

    @property
    def range(self) -> Optional[Tuple[float, float]]:
        raise NotImplementedError()

    @property
    def every(self) -> Optional[float]:
        raise NotImplementedError()

    @property
    def buckets(self) -> Optional[List[float]]:
        raise NotImplementedError()

    @property
    def text(self) -> str:
        raise NotImplementedError()

    @property
    def target(self) -> float:
        raise NotImplementedError()

    @property
    def group(self) -> CoverGroup:
        raise NotImplementedError()

    @property
    def cover_by(self) -> str:
        raise NotImplementedError()

    @property
    def min_stay(self) -> Optional[float]:
        raise NotImplementedError()

    @property
    def attribute(self) -> Optional[str]:
        raise NotImplementedError()

    @property
    def edges(self) -> List[float]:
        raise NotImplementedError()

    @property
    def labels(self) -> List[str]:
        raise NotImplementedError()

    # Python's Event, Union[SamplingEvent, BaseCondition]: a union of classes
    # without None is an attribute type (docs/typecheck.md).
    @property
    def event(self) -> Union[SamplingEvent, BaseCondition]:
        raise NotImplementedError()

    @property
    def numeric(self) -> bool:
        raise NotImplementedError()

    @property
    def amount(self) -> str:
        raise NotImplementedError()

    def bucket_of(self, value) -> str:
        """*value* is Any in Python."""
        raise NotImplementedError()


class CrossItem:
    name: str
    items: List[CoverItem]
    text: str = ""
    target: float = 1.0
    cover_by: str = "hits"
    min_stay: Optional[float] = None

    @property
    def event(self) -> Union[SamplingEvent, BaseCondition]:
        raise NotImplementedError()

    @property
    def group(self) -> CoverGroup:
        raise NotImplementedError()


# What the checked scenario_runner uses of coverage.collector (openodd's
# collector, a Rust extension): the collector, the sampling it is told of, the
# case and outcome of the run it records, and the file it writes. The ODD is any value in Python (`odd: Any`); backend and
# generator are openodd's types, which are not declared, so passing one fails
# the check.
class CoverageCollector:
    # No fields: Codon would build one with no arguments too (docs/typecheck.md).
    def __init__(self):
        compile_error("CoverageCollector(): no constructor takes these arguments "
                      "(required: items)")

    def __init__(self, items: List[CoverItem], crosses: Optional[List[CrossItem]] = None,
                 odd = None, *_kw, backend = None, generator = None):
        _keyword_only(_kw, "CoverageCollector(): backend and generator")
        if not (isinstance(backend, None) or isinstance(backend, Optional[NoneType])):
            compile_error("CoverageCollector(): openodd's Backend is not declared")
        if not (isinstance(generator, None) or isinstance(generator, Optional[NoneType])):
            compile_error("CoverageCollector(): the generator is not declared")

    def start(self, context: carla.World, elapsed: float) -> None:
        raise NotImplementedError()

    def tick(self, context: carla.World, elapsed: float) -> None:
        raise NotImplementedError()

    def end(self, context: carla.World, elapsed: float) -> None:
        raise NotImplementedError()

    def write(self, path: Path, scenario: str) -> None:
        raise NotImplementedError()

    def record_case(self, case, space = None) -> None:
        """An OddSample and the ParameterSpace it was drawn in (odd.codon,
        which imports this module, so they are told by their markers)."""
        if not hasattr(case, "_acs_odd_sample"):
            compile_error("record_case(): the case is an OddSample")
        if not (isinstance(space, None) or isinstance(space, Optional[NoneType])):
            if not hasattr(space, "_acs_parameter_space"):
                compile_error("record_case(): the space is a ParameterSpace or None")
        raise NotImplementedError()

    def record_outcome(self, passed: bool, *_kw, failed_at: Optional[float] = None,
                       environment: Optional[str] = None) -> None:
        _keyword_only(_kw, "CoverageCollector.record_outcome(): failed_at and environment")
        raise NotImplementedError()


# What the package re-exports of coverage.report (openodd's merge): its
# constructor is a compile error, so a scenario cannot build one; of what
# merge_coverage() returns, what Codon has types for is declared (#298).
class CoverageReport:
    # No fields: Codon would build one with no arguments too (docs/typecheck.md).
    def __init__(self):
        compile_error("CoverageReport(): no constructor takes these arguments (required: core)")

    def __init__(self, core):
        compile_error("CoverageReport is not modelled: the static check cannot "
                      "build one (typecheck/codon/autoware_carla_scenario/coverage.codon)")

    @property
    def runs(self) -> int:
        raise NotImplementedError()

    @property
    def scenarios(self) -> Dict[str, int]:
        raise NotImplementedError()

    def groups(self) -> List[str]:
        raise NotImplementedError()

    def group_grade(self, group: str) -> float:
        raise NotImplementedError()

    def to_markdown(self, *_kw, max_holes: int = 20) -> str:
        _keyword_only(_kw, "CoverageReport.to_markdown(): max_holes")
        raise NotImplementedError()


def merge_coverage(documents) -> CoverageReport:
    """openodd's merge of coverage documents (Sequence[dict[str, Any]])."""
    raise NotImplementedError()


def prepare_measures(odd, scenario = None) -> None:
    raise NotImplementedError()
