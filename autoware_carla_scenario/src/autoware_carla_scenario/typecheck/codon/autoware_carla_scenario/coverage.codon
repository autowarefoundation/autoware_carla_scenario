# Model of autoware_carla_scenario.coverage (docs/typecheck.md).
#
# Only what a scenario names: the sampling event of a cover item.  Cover items
# themselves are declared through BaseScenario.register_cover().  CoverItem and
# CrossItem are declared for the library check (scenario_base, which holds
# them), with only the name scenario_base reads; a scenario never builds one.
# CoverageCollector (below) is what the checked scenario_runner uses of it.

from pathlib import Path

import typesafe_carla.carla as carla

from ._tc import _expect_float, _expect_optional_float, _keyword_only
from .conditions import BaseCondition, _expect_condition


@tuple
class SamplingEvent:
    value: str
    START: ClassVar[SamplingEvent] = SamplingEvent("start")
    END: ClassVar[SamplingEvent] = SamplingEvent("end")
    TICK: ClassVar[SamplingEvent] = SamplingEvent("tick")


def _expect_sampling_event(event):
    """A Union[SamplingEvent, BaseCondition] argument."""
    if hasattr(event, "_acs_condition"):
        _expect_condition(event)
    elif isinstance(event, SamplingEvent):
        pass
    else:
        compile_error("event must be a SamplingEvent or a condition")


def _expect_cover_expression(expression):
    """A Callable[[carla.World], Any] argument: a cover expression or an ODD probe."""
    expression(carla.Client().get_world())


def _expect_optional_range(r):
    """An Optional[tuple[float, float]] argument."""
    if isinstance(r, None):
        pass
    elif isinstance(r, Optional[NoneType]):
        pass
    else:
        low, high = r
        _expect_float(low)
        _expect_float(high)


def _expect_optional_edges(edges):
    """An Optional[Sequence[float]] argument."""
    if isinstance(edges, None):
        pass
    elif isinstance(edges, Optional[NoneType]):
        pass
    else:
        for edge in edges:
            _expect_float(edge)


class CoverItem:
    name: str

    def __init__(self, name: str, expression, unit: str = "", range = None, every = None,
                 buckets = None, values = None, ignore = None, event = SamplingEvent("end"),
                 text: str = "", target = 1.0, group = None, cover_by: str = "hits",
                 min_stay = None, attribute = None):
        self.name = name


class CrossItem:
    name: str
    items: List[CoverItem]
    text: str = ""
    target: float = 1.0
    cover_by: str = "hits"
    min_stay: Optional[float] = None


# What the checked scenario_runner uses of coverage.collector (openodd's
# collector, a Rust extension): the collector, the sampling it is told of, and
# the file it writes. The ODD is any value in Python (`odd: Any`); backend and
# generator are openodd's types, which are not declared, so passing one fails
# the check.
class CoverageCollector:
    def __init__(self, items: List[CoverItem], crosses: Optional[List[CrossItem]] = None,
                 odd = None, *_kw, backend = None, generator = None):
        _keyword_only(_kw, "CoverageCollector(): backend and generator")
        if not (isinstance(backend, None) or isinstance(backend, Optional[NoneType])):
            compile_error("CoverageCollector(): openodd's Backend is not declared")
        if not (isinstance(generator, None) or isinstance(generator, Optional[NoneType])):
            compile_error("CoverageCollector(): the generator is not declared")

    def start(self, context: carla.World, elapsed: float) -> None:
        raise NotImplementedError()

    def tick(self, context: carla.World, elapsed: float) -> None:
        raise NotImplementedError()

    def end(self, context: carla.World, elapsed: float) -> None:
        raise NotImplementedError()

    def write(self, path: Path, scenario: str) -> None:
        raise NotImplementedError()
