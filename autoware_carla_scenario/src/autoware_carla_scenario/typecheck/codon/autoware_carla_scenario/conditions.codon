# Model of autoware_carla_scenario.conditions (docs/typecheck.md).
#
# Every condition derives from BaseCondition directly: the Python
# CompositionCondition layer in between is left out (Codon miscompiles class
# hierarchies two levels deep, and nothing a scenario writes names it).

import typesafe_carla.carla as carla

from .action_state import ActionState
from ._tc import (_keyword_only, _expect_float, _expect_optional_str, _Required,
                  _required_str, _acs_expect_return)
from .coordinate import (Lanelet2Pose, OpenDrivePose, CarlaWorldPose, _expect_pose,
                         _expect_optional_pose, _expect_pose_list)
from .entity_role import EntityRole, _expect_role, _expect_optional_role, find_actor_in_list


@tuple
class ComparisonRule:
    value: int
    GREATER_THAN: ClassVar[ComparisonRule] = ComparisonRule(1)
    LESS_THAN: ClassVar[ComparisonRule] = ComparisonRule(2)
    EQUAL_TO: ClassVar[ComparisonRule] = ComparisonRule(3)
    GREATER_THAN_OR_EQUAL: ClassVar[ComparisonRule] = ComparisonRule(4)
    LESS_THAN_OR_EQUAL: ClassVar[ComparisonRule] = ComparisonRule(5)


@tuple
class AccelerationDirection:
    value: int
    LONGITUDINAL: ClassVar[AccelerationDirection] = AccelerationDirection(1)
    LATERAL: ClassVar[AccelerationDirection] = AccelerationDirection(2)
    MAGNITUDE: ClassVar[AccelerationDirection] = AccelerationDirection(3)


@tuple
class SpeedDirection:
    value: int
    LONGITUDINAL: ClassVar[SpeedDirection] = SpeedDirection(1)
    LATERAL: ClassVar[SpeedDirection] = SpeedDirection(2)
    MAGNITUDE: ClassVar[SpeedDirection] = SpeedDirection(3)


@tuple
class TurnIndicatorState:
    value: int
    OFF: ClassVar[TurnIndicatorState] = TurnIndicatorState(1)
    LEFT: ClassVar[TurnIndicatorState] = TurnIndicatorState(2)
    RIGHT: ClassVar[TurnIndicatorState] = TurnIndicatorState(3)
    HAZARD: ClassVar[TurnIndicatorState] = TurnIndicatorState(4)


@tuple
class SpeedCoordinateSystem:
    value: int
    WORLD: ClassVar[SpeedCoordinateSystem] = SpeedCoordinateSystem(1)
    ENTITY: ClassVar[SpeedCoordinateSystem] = SpeedCoordinateSystem(2)


@tuple
class DistanceCoordinateSystem:
    value: int
    ENTITY: ClassVar[DistanceCoordinateSystem] = DistanceCoordinateSystem(1)
    LANE: ClassVar[DistanceCoordinateSystem] = DistanceCoordinateSystem(2)


@tuple
class RelativeDistanceType:
    value: str
    EUCLIDEAN: ClassVar[RelativeDistanceType] = RelativeDistanceType("euclidean")
    LONGITUDINAL: ClassVar[RelativeDistanceType] = RelativeDistanceType("longitudinal")
    LATERAL: ClassVar[RelativeDistanceType] = RelativeDistanceType("lateral")


@tuple
class CollisionTargetType:
    value: str
    ANY: ClassVar[CollisionTargetType] = CollisionTargetType("")
    VEHICLE: ClassVar[CollisionTargetType] = CollisionTargetType("vehicle.")
    PEDESTRIAN: ClassVar[CollisionTargetType] = CollisionTargetType("walker.")
    STATIC: ClassVar[CollisionTargetType] = CollisionTargetType("static.")


@tuple
class WaypointCheckType:
    value: int
    IS_EMPTY: ClassVar[WaypointCheckType] = WaypointCheckType(1)


def compare(actual: float, rule: ComparisonRule, value: float,
            tolerance: float = 1e-06) -> bool:
    raise NotImplementedError()


class ScalarComparisonRule:
    field: str
    rule: ComparisonRule
    value: float
    tolerance: float

    def __init__(self, field: str, rule: ComparisonRule, value: float, tolerance: float = 1e-06):
        self.field = field
        self.rule = rule
        self.value = value
        self.tolerance = tolerance

    def satisfied(self, actual: float) -> bool:
        raise NotImplementedError()


class ConditionStatus:
    label: str
    satisfied: bool
    message: str
    condition_type: str
    role: str

    def __init__(self, label: str, satisfied: bool, message: str, condition_type: str = "",
                 role: str = ""):
        self.label = label
        self.satisfied = satisfied
        self.message = message
        self.condition_type = condition_type
        self.role = role


class ScenarioResult:
    passed: bool
    message: str
    elapsed_seconds: float
    condition_statuses: List[ConditionStatus]

    def __init__(self, passed: bool, message: str, elapsed_seconds: float,
                 condition_statuses: List[ConditionStatus] = List[ConditionStatus]()):
        self.passed = passed
        self.message = message
        self.elapsed_seconds = elapsed_seconds
        self.condition_statuses = condition_statuses

    def to_json(self, **kwargs) -> str:
        raise NotImplementedError()


class BaseCondition:
    # Codon also builds a class by its fields, by position: a subclass with
    # its inherited label alone (`TimeoutCondition("10")`, #236). Each
    # subclass declares an __init__ of one argument that refuses this, ahead
    # of its constructor, which wins every call it takes (docs/typecheck.md).
    label: str

    def __init__(self, label: str):
        self.label = label

    def _acs_condition(self) -> int:
        """Marks a condition for _acs_list (lists.codon)."""
        return 0

    @staticmethod
    def _acs_hook_returns(name: Literal[str], r):
        """The return type of each method an override of which the scenario
        check checks (_acs_hook_return in _tc.codon, #238)."""
        if name == "check":
            _acs_expect_return(r, Optional[ScenarioResult], "BaseCondition.check() returns Optional[ScenarioResult]")

    def check(self, world: carla.World, elapsed: float) -> Optional[ScenarioResult]:
        raise NotImplementedError()


def _expect_optional_condition(condition) -> Optional[BaseCondition]:
    """An Optional[BaseCondition] argument (Codon's Optional does not take a subclass)."""
    if isinstance(condition, None):
        return None
    elif isinstance(condition, Optional[NoneType]):
        return None
    elif isinstance(condition, Optional):
        if condition is None:
            return None
        return _expect_condition(unwrap(condition))
    else:
        return _expect_condition(condition)


def _expect_condition(condition: BaseCondition) -> BaseCondition:
    # Checked once here, so a condition subclass reaches check() typed, and
    # its result is what the framework reads (#238): BaseCondition wraps
    # check() and reads `result.passed` of anything but None.
    BaseCondition._acs_hook_returns("check", condition.check(carla.Client().get_world(), 0.0))
    return condition


def _expect_conditions(conditions) -> List[BaseCondition]:
    """A Sequence[BaseCondition] argument: a list or tuple of any conditions."""
    out = List[BaseCondition]()
    for condition in conditions:
        out.append(_expect_condition(condition))
    return out


def _optional_label(label: Optional[str]) -> str:
    return label if label is not None else ""


def find_actor_by_role_name(world: carla.World, role_name) -> Optional[carla.Actor]:
    _expect_role(role_name)
    raise NotImplementedError()


def _expect_action_state(state) -> ActionState:
    """A Union[ActionState, str] argument: a state, or its OpenSCENARIO name."""
    if isinstance(state, ActionState):
        return state
    elif isinstance(state, str):
        return ActionState(state)
    else:
        compile_error("expected an ActionState or a str (its OpenSCENARIO name)")


def _expect_actions(actions) -> int:
    """A Mapping[str, BaseAction] argument, any dict of action ids to actions.
    actions.codon imports this module, so BaseAction cannot be named here: an
    action is what BaseAction declares, its _acs_action marker and its state."""
    if isinstance(actions, Dict[NoneType, NoneType]):
        # `{}`: Codon types an empty literal's keys and values as NoneType.
        return 0
    n = 0
    for key in actions:
        action_id: str = key
        action = actions[key]
        action._acs_action()
        state: ActionState = action.state
        n += 1
    return n


class ActionStateCondition(BaseCondition):
    def __init__(self, label):
        compile_error("ActionStateCondition(): no constructor takes these arguments "
                      "(required: action_id, state, actions)")

    def __init__(self, action_id: str, state, actions, *_kw, label: str = "action_state"):
        _keyword_only(_kw, "ActionStateCondition(): label")
        _expect_action_state(state)
        _expect_actions(actions)
        super().__init__(label)


