# Model of autoware_carla_scenario.conditions (docs/typecheck.md).
#
# Every condition derives from BaseCondition directly: the Python
# CompositionCondition layer in between is left out (Codon miscompiles class
# hierarchies two levels deep, and nothing a scenario writes names it).

import typesafe_carla.carla as carla

from .action_state import ActionState
from ._tc import (_keyword_only, _expect_float, _expect_optional_str, _Required,
                  _required_str, _acs_expect_return, _acs_sequence)
from .coordinate import (Lanelet2Pose, OpenDrivePose, CarlaWorldPose, _expect_pose,
                         _expect_optional_pose, _expect_pose_list)
from .entity_role import EntityRole, _expect_role, _expect_optional_role, find_actor_in_list


@tuple
class ComparisonRule:
    value: int
    GREATER_THAN: ClassVar[ComparisonRule] = ComparisonRule(1)
    LESS_THAN: ClassVar[ComparisonRule] = ComparisonRule(2)
    EQUAL_TO: ClassVar[ComparisonRule] = ComparisonRule(3)
    GREATER_THAN_OR_EQUAL: ClassVar[ComparisonRule] = ComparisonRule(4)
    LESS_THAN_OR_EQUAL: ClassVar[ComparisonRule] = ComparisonRule(5)

    # Enum's name (#307): Codon has no Enum to give a framework enum one.
    @property
    def name(self) -> str:
        if self == ComparisonRule.GREATER_THAN:
            return "GREATER_THAN"
        if self == ComparisonRule.LESS_THAN:
            return "LESS_THAN"
        if self == ComparisonRule.EQUAL_TO:
            return "EQUAL_TO"
        if self == ComparisonRule.GREATER_THAN_OR_EQUAL:
            return "GREATER_THAN_OR_EQUAL"
        if self == ComparisonRule.LESS_THAN_OR_EQUAL:
            return "LESS_THAN_OR_EQUAL"
        raise ValueError("not a member of ComparisonRule")

    @property
    def text(self) -> str:
        return self.name.lower().replace("_", " ")

    # What `for m in E`, `list(E)` and `E["A"]` read: the checker rewrites
    # them (#437). Declared in Python's order, as the test checks.
    @staticmethod
    def _acs_members() -> List[ComparisonRule]:
        return [ComparisonRule.GREATER_THAN, ComparisonRule.LESS_THAN, ComparisonRule.EQUAL_TO, ComparisonRule.GREATER_THAN_OR_EQUAL, ComparisonRule.LESS_THAN_OR_EQUAL]

    @staticmethod
    def _acs_by_name(name: str) -> ComparisonRule:
        if name == "GREATER_THAN":
            return ComparisonRule.GREATER_THAN
        if name == "LESS_THAN":
            return ComparisonRule.LESS_THAN
        if name == "EQUAL_TO":
            return ComparisonRule.EQUAL_TO
        if name == "GREATER_THAN_OR_EQUAL":
            return ComparisonRule.GREATER_THAN_OR_EQUAL
        if name == "LESS_THAN_OR_EQUAL":
            return ComparisonRule.LESS_THAN_OR_EQUAL
        raise KeyError(name)


