@tuple
class CollisionTargetType:
    value: str
    ANY: ClassVar[CollisionTargetType] = CollisionTargetType("")
    VEHICLE: ClassVar[CollisionTargetType] = CollisionTargetType("vehicle.")
    PEDESTRIAN: ClassVar[CollisionTargetType] = CollisionTargetType("walker.")
    STATIC: ClassVar[CollisionTargetType] = CollisionTargetType("static.")

    # Enum's name (#307): Codon has no Enum to give a framework enum one.
    @property
    def name(self) -> str:
        if self == CollisionTargetType.ANY:
            return "ANY"
        if self == CollisionTargetType.VEHICLE:
            return "VEHICLE"
        if self == CollisionTargetType.PEDESTRIAN:
            return "PEDESTRIAN"
        if self == CollisionTargetType.STATIC:
            return "STATIC"
        raise ValueError("not a member of CollisionTargetType")

    def matches(self, type_id: Optional[str]) -> bool:
        if self == CollisionTargetType.ANY:
            return True
        if type_id is None:
            return False
        return type_id.startswith(self.value)

    # What `for m in E`, `list(E)` and `E["A"]` read: the checker rewrites
    # them (#437). Declared in Python's order, as the test checks.
    @staticmethod
    def _acs_members() -> List[CollisionTargetType]:
        return [CollisionTargetType.ANY, CollisionTargetType.VEHICLE, CollisionTargetType.PEDESTRIAN, CollisionTargetType.STATIC]

    @staticmethod
    def _acs_by_name(name: str) -> CollisionTargetType:
        if name == "ANY":
            return CollisionTargetType.ANY
        if name == "VEHICLE":
            return CollisionTargetType.VEHICLE
        if name == "PEDESTRIAN":
            return CollisionTargetType.PEDESTRIAN
        if name == "STATIC":
            return CollisionTargetType.STATIC
        raise KeyError(name)


