    def __init__(self, entity_name, position, lane: str = "same", *_kw, label = _Required()):
        _keyword_only(_kw, "EntityLaneOfCondition(): label")
        if lane != "same" and lane != "left" and lane != "right" and lane != "any":
            raise ValueError("EntityLaneOfCondition(): lane must be same, left, right or any")
        super().__init__(entity_name, position,
                         label=_required_str(label, "EntityLaneOfCondition(): label"))


