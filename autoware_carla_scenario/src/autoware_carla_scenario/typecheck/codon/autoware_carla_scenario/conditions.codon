    @staticmethod
    def anywhere_on_road(entity_name, road_id: str,
                         rules: Optional[List[ScalarComparisonRule]] = None, *_kw,
                         label = _Required()) -> EntityLanePositionCondition:
        _keyword_only(_kw, "EntityLanePositionCondition.anywhere_on_road(): label")
        return EntityLanePositionCondition(entity_name, OpenDrivePose(road_id, 0, 0.0), rules,
                                           label=_required_str(label, "EntityLanePositionCondition.anywhere_on_road(): label"))


def beside_lane_id(lane_id: int, side: str) -> int:
    if side != "left" and side != "right":
        raise ValueError("beside_lane_id(): side must be 'left' or 'right'")
    delta = 1 if side == "left" else -1
    return lane_id + delta if lane_id < 0 else lane_id - delta


class EntityLaneOfCondition(EntityLanePositionCondition):
    def __init__(self, label):
        compile_error("EntityLaneOfCondition(): no constructor takes these arguments "
                      "(required: entity_name, position, keyword label)")

    def __init__(self, entity_name, position, lane: str = "same", *_kw, label = _Required()):
        _keyword_only(_kw, "EntityLaneOfCondition(): label")
        if lane != "same" and lane != "left" and lane != "right" and lane != "any":
            raise ValueError("EntityLaneOfCondition(): lane must be same, left, right or any")
        super().__init__(entity_name, position,
                         label=_required_str(label, "EntityLaneOfCondition(): label"))


