@tuple
class AdversityKind:
    value: str
    BRAKE_CHECK: ClassVar[AdversityKind] = AdversityKind("brake_check")
    IGNORE_LEADER: ClassVar[AdversityKind] = AdversityKind("ignore_leader")
    CUT_IN: ClassVar[AdversityKind] = AdversityKind("cut_in")
    TRAFFIC_RULE: ClassVar[AdversityKind] = AdversityKind("traffic_rule")
    JAYWALKING: ClassVar[AdversityKind] = AdversityKind("jaywalking")
    LANE_CHANGE_ABORT: ClassVar[AdversityKind] = AdversityKind("lane_change_abort")
    HEAD_ON: ClassVar[AdversityKind] = AdversityKind("head_on")
    RUNNING_RED_LIGHT: ClassVar[AdversityKind] = AdversityKind("running_red_light")
    STOP_CROSSING: ClassVar[AdversityKind] = AdversityKind("stop_crossing")
    MERGE: ClassVar[AdversityKind] = AdversityKind("merge")

    # Enum's name (#307): Codon has no Enum to give a framework enum one.
    @property
    def name(self) -> str:
        if self == AdversityKind.BRAKE_CHECK:
            return "BRAKE_CHECK"
        if self == AdversityKind.IGNORE_LEADER:
            return "IGNORE_LEADER"
        if self == AdversityKind.CUT_IN:
            return "CUT_IN"
        if self == AdversityKind.TRAFFIC_RULE:
            return "TRAFFIC_RULE"
        if self == AdversityKind.JAYWALKING:
            return "JAYWALKING"
        if self == AdversityKind.LANE_CHANGE_ABORT:
            return "LANE_CHANGE_ABORT"
        if self == AdversityKind.HEAD_ON:
            return "HEAD_ON"
        if self == AdversityKind.RUNNING_RED_LIGHT:
            return "RUNNING_RED_LIGHT"
        if self == AdversityKind.STOP_CROSSING:
            return "STOP_CROSSING"
        if self == AdversityKind.MERGE:
            return "MERGE"
        raise ValueError("not a member of AdversityKind")

    # What `for m in E`, `list(E)` and `E["A"]` read: the checker rewrites
    # them (#437). Declared in Python's order, as the test checks.
    @staticmethod
    def _acs_members() -> List[AdversityKind]:
        return [AdversityKind.BRAKE_CHECK, AdversityKind.IGNORE_LEADER, AdversityKind.CUT_IN, AdversityKind.TRAFFIC_RULE, AdversityKind.JAYWALKING, AdversityKind.LANE_CHANGE_ABORT, AdversityKind.HEAD_ON, AdversityKind.RUNNING_RED_LIGHT, AdversityKind.STOP_CROSSING, AdversityKind.MERGE]

    @staticmethod
    def _acs_by_name(name: str) -> AdversityKind:
        if name == "BRAKE_CHECK":
            return AdversityKind.BRAKE_CHECK
        if name == "IGNORE_LEADER":
            return AdversityKind.IGNORE_LEADER
        if name == "CUT_IN":
            return AdversityKind.CUT_IN
        if name == "TRAFFIC_RULE":
            return AdversityKind.TRAFFIC_RULE
        if name == "JAYWALKING":
            return AdversityKind.JAYWALKING
        if name == "LANE_CHANGE_ABORT":
            return AdversityKind.LANE_CHANGE_ABORT
        if name == "HEAD_ON":
            return AdversityKind.HEAD_ON
        if name == "RUNNING_RED_LIGHT":
            return AdversityKind.RUNNING_RED_LIGHT
        if name == "STOP_CROSSING":
            return AdversityKind.STOP_CROSSING
        if name == "MERGE":
            return AdversityKind.MERGE
        raise KeyError(name)


@tuple
class AdversityLocation:
    value: str
    ANY: ClassVar[AdversityLocation] = AdversityLocation("any")
    INTERSECTION: ClassVar[AdversityLocation] = AdversityLocation("intersection")
    HIGHWAY: ClassVar[AdversityLocation] = AdversityLocation("highway")
    ROUNDABOUT: ClassVar[AdversityLocation] = AdversityLocation("roundabout")

    # Enum's name (#307): Codon has no Enum to give a framework enum one.
    @property
    def name(self) -> str:
        if self == AdversityLocation.ANY:
            return "ANY"
        if self == AdversityLocation.INTERSECTION:
            return "INTERSECTION"
        if self == AdversityLocation.HIGHWAY:
            return "HIGHWAY"
        if self == AdversityLocation.ROUNDABOUT:
            return "ROUNDABOUT"
        raise ValueError("not a member of AdversityLocation")

    # What `for m in E`, `list(E)` and `E["A"]` read: the checker rewrites
    # them (#437). Declared in Python's order, as the test checks.
    @staticmethod
    def _acs_members() -> List[AdversityLocation]:
        return [AdversityLocation.ANY, AdversityLocation.INTERSECTION, AdversityLocation.HIGHWAY, AdversityLocation.ROUNDABOUT]

    @staticmethod
    def _acs_by_name(name: str) -> AdversityLocation:
        if name == "ANY":
            return AdversityLocation.ANY
        if name == "INTERSECTION":
            return AdversityLocation.INTERSECTION
        if name == "HIGHWAY":
            return AdversityLocation.HIGHWAY
        if name == "ROUNDABOUT":
            return AdversityLocation.ROUNDABOUT
        raise KeyError(name)


