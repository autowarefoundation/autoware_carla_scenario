# What lane_distance and utils.traffic_light read of the map MapManager has
# loaded: pyxodr's RoadNetwork and Road, and the lxml elements they hold.
# Neither pyxodr nor lxml compiles with Codon, so only what is read is declared.


class _XmlAttributes:
    def get(self, key: str) -> Optional[str]:
        raise NotImplementedError()

    def get(self, key: str, default: str) -> str:
        raise NotImplementedError()


class _XmlElement:
    attrib: _XmlAttributes

    def find(self, path: str) -> Optional[_XmlElement]:
        raise NotImplementedError()

    def findall(self, path: str) -> List[_XmlElement]:
        raise NotImplementedError()

    def iter(self, tag: str) -> List[_XmlElement]:
        raise NotImplementedError()

    def get(self, key: str) -> Optional[str]:
        raise NotImplementedError()

    def get(self, key: str, default: str) -> str:
        raise NotImplementedError()


class Road:
    road_xml: _XmlElement

    # pyxodr's cached_property: the road's reference line, a 2-D array with a
    # row per point along the road (composition.temporary_stop sums its length).
    @property
    def reference_line(self) -> numpy.ndarray[float, 2]:
        raise NotImplementedError()

    def __getitem__(self, name: str) -> str:
        raise NotImplementedError()


class RoadNetwork:
    road_ids_to_object: Dict[str, Road]
    root: _XmlElement


# lanelet2's map and routing graph, as MapManager hands them out: opaque here.
# route.active hands them to RouteFrame (route.codon); composition.temporary_stop
# walks the routing graph from a lanelet to its neighbours' ids. Only that much
# of lanelet2's API is declared.


# Opaque: a lanelet2.core.Lanelet (or ConstLanelet); only its id is read.
class _Lanelet2Lanelet:
    @property
    def id(self) -> int:
        raise NotImplementedError()


# Opaque: lanelet2.core.LaneletLayer; only indexed by lanelet id.
class _Lanelet2LaneletLayer:
    def __getitem__(self, id: int) -> _Lanelet2Lanelet:
        raise NotImplementedError()


# Opaque: lanelet2.core.LaneletMap; only its lanelet layer is read.
class _Lanelet2Map:
    @property
    def laneletLayer(self) -> _Lanelet2LaneletLayer:
        raise NotImplementedError()


# Opaque: lanelet2.routing.RoutingGraph; only previous and following are read.
class _Lanelet2RoutingGraph:
    def previous(self, lanelet: _Lanelet2Lanelet, withLaneChanges: bool = False
                 ) -> List[_Lanelet2Lanelet]:
        raise NotImplementedError()

    def following(self, lanelet: _Lanelet2Lanelet, withLaneChanges: bool = False
                  ) -> List[_Lanelet2Lanelet]:
        raise NotImplementedError()


class MapManager:
    @staticmethod
    def get_instance() -> MapManager:
        raise NotImplementedError()

    @property
    def lanelet_map(self) -> _Lanelet2Map:
        raise NotImplementedError()

    @property
    def routing_graph(self) -> _Lanelet2RoutingGraph:
        raise NotImplementedError()

    @property
    def road_network(self) -> RoadNetwork:
        raise NotImplementedError()

    @property
    def mgrs_offset(self) -> Tuple[float, float]:
        raise NotImplementedError()

    @property
    def z_offset(self) -> float:
        raise NotImplementedError()
