# What lane_distance, utils.traffic_light and coordinate.transform read of the
# map MapManager has loaded: pyxodr's RoadNetwork, Road, LaneSection and Lane,
# and the lxml elements they hold.
# Neither pyxodr nor lxml compiles with Codon, so only what is read is declared.


class _XmlAttributes:
    # KeyError when absent.
    def __getitem__(self, key: str) -> str:
        raise NotImplementedError()

    def get(self, key: str) -> Optional[str]:
        raise NotImplementedError()

    def get(self, key: str, default: str) -> str:
        raise NotImplementedError()


class _XmlElement:
    attrib: _XmlAttributes

    def find(self, path: str) -> Optional[_XmlElement]:
        raise NotImplementedError()

    def findall(self, path: str) -> List[_XmlElement]:
        raise NotImplementedError()

    def iter(self, tag: str) -> List[_XmlElement]:
        raise NotImplementedError()

    def get(self, key: str) -> Optional[str]:
        raise NotImplementedError()

    def get(self, key: str, default: str) -> str:
        raise NotImplementedError()


# pyxodr's Lane (pyxodr.road_objects.lane): its id (the XML's, as an int) and
# its XML element, whose <width> records coordinate.transform evaluates.
class Lane:
    lane_xml: _XmlElement

    @property
    def id(self) -> int:
        raise NotImplementedError()


# pyxodr's LaneSection (pyxodr.road_objects.lane_section): its XML element and
# its lanes, innermost first on each side.
class LaneSection:
    lane_section_xml: _XmlElement

    @property
    def left_lanes(self) -> List[Lane]:
        raise NotImplementedError()

    @property
    def right_lanes(self) -> List[Lane]:
        raise NotImplementedError()

    @property
    def lanes(self) -> List[Lane]:
        raise NotImplementedError()


class Road:
    road_xml: _XmlElement

    # pyxodr's cached_property: the road's lane sections, in order along it.
    @property
    def lane_sections(self) -> List[LaneSection]:
        raise NotImplementedError()

    # pyxodr's cached_property: the elevation at each reference line point.
    @property
    def z_coordinates(self) -> numpy.ndarray[float, 1]:
        raise NotImplementedError()

    # pyxodr's cached_property: the road's reference line, a 2-D array with a
    # row per point along the road (composition.temporary_stop sums its length).
    @property
    def reference_line(self) -> numpy.ndarray[float, 2]:
        raise NotImplementedError()

    def __getitem__(self, name: str) -> str:
        raise NotImplementedError()


# pyxodr's RoadNetwork: read from an .xodr file (MapManager.initialize()),
# its roads by id (filled by get_roads()) and the XML root. pyxodr also takes
# the lane types to ignore, which the framework leaves at pyxodr's.
class RoadNetwork:
    road_ids_to_object: Dict[str, Road]
    root: _XmlElement

    def __init__(self, xodr_file_path: str, resolution: float = 0.1):
        pass

    def get_roads(self, include_connecting_roads: bool = True,
                  verbose: bool = False) -> List[Road]:
        raise NotImplementedError()


# lanelet2's map and routing graph, as MapManager hands them out: lanelet2's
# own classes, as the lanelet2 model (codon/lanelet2/) declares them. The
# library check compiles coordinate/map_manager.py from its source
# (typecheck/library.py), so this MapManager is the scenario check's: what a
# scenario may read of the one coordinate exports.


class MapManager:
    @staticmethod
    def get_instance() -> MapManager:
        raise NotImplementedError()

    # A classmethod in Python, as get_instance(): the queue resets the
    # singleton before it loads a run's maps.
    @staticmethod
    def reset() -> None:
        raise NotImplementedError()

    def initialize(self, xodr_path: Path, lanelet2_path: Path,
                   carla_world: Optional[carla.World] = None,
                   projector_type: Optional[str] = None) -> None:
        raise NotImplementedError()

    @property
    def lanelet_map(self) -> lanelet2.core.LaneletMap:
        raise NotImplementedError()

    @property
    def routing_graph(self) -> lanelet2.routing.RoutingGraph:
        raise NotImplementedError()

    @property
    def road_network(self) -> RoadNetwork:
        raise NotImplementedError()

    @property
    def mgrs_offset(self) -> Tuple[float, float]:
        raise NotImplementedError()

    # The (lat, lon, alt) origin of the OpenDRIVE map's geoReference.
    @property
    def geo_origin(self) -> Tuple[float, float, float]:
        raise NotImplementedError()

    @property
    def z_offset(self) -> float:
        raise NotImplementedError()

    # The CARLA map of the world it was initialised with, or None.
    @property
    def carla_map(self) -> Optional[carla.Map]:
        raise NotImplementedError()


# What coordinate/map_manager.py and sweeper/map_loader.py import of
# coordinate/projection.py: where a map is anchored, the projector it is read
# with, and the OpenDRIVE geoReference parser map_manager re-exports. The
# library check compiles all three modules from their source now (#142), so
# it no longer reads these; they stay declared as in Python
# (test_typecheck_model.py). None is exported by the coordinate package.

# map_origin(lanelet2_path, xodr_path): ((lat, lon, alt), what said so).
# Raises ValueError for an OpenDRIVE file without a geoReference.
def map_origin(lanelet2_path: Path, xodr_path: Optional[Path] = None
               ) -> Tuple[Tuple[float, float, float], str]:
    raise NotImplementedError()


# resolve_projector(...): the projector (any of lanelet2's or Autoware's) and
# its name. Raises ValueError for a projector_type it does not know.
def resolve_projector(lanelet2_path: Path, origin: lanelet2.io.Origin,
                      projector_type: Optional[str] = None
                      ) -> Tuple[lanelet2.projection.Projector, str]:
    raise NotImplementedError()


# load_lanelet2(...): the map, the projector it was read with and the
# reading's name. Raises ValueError for a projector_type it does not know.
def load_lanelet2(lanelet2_path: Path, origin: lanelet2.io.Origin,
                  projector_type: Optional[str] = None
                  ) -> Tuple[lanelet2.core.LaneletMap,
                             lanelet2.projection.Projector, str]:
    raise NotImplementedError()


def _parse_geo_reference(xodr_content: str) -> Tuple[float, float, float]:
    raise NotImplementedError()
