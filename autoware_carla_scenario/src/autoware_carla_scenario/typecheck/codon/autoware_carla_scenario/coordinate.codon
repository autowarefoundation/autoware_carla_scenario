def get_stop_line_poses(lanelet_id: int) -> List[Lanelet2Pose]:
    raise NotImplementedError()


def get_stop_line_poses_with_following(lanelet_id: int, depth: int = 1
                                       ) -> List[Lanelet2Pose]:
    raise NotImplementedError()


def find_nearest_traffic_light(world: carla.World, location, max_distance: float = 150.0
                               ) -> Tuple[Optional[carla.Actor], float]:
    _expect_pose_or_location(location)
    raise NotImplementedError()


def lanelet2_traffic_light_id_to_opendrive_controller_id(lanelet2_tl_id: int) -> Optional[int]:
    raise NotImplementedError()


def get_signal_ids_for_controller(controller_id: int) -> List[str]:
    raise NotImplementedError()


# Below: the boundary the checked coordinate modules (typecheck/library.py)
# compile against, beyond what a scenario uses. __init__.codon exports none of
# it, so a scenario does not reach it through the model.


def find_traffic_lights_for_lanelet2_id(world: carla.World, lanelet2_tl_id: int
                                        ) -> List[carla.Actor]:
    raise NotImplementedError()


def to_map_frame(pose):
    # Returns autoware_bridge's BridgePose, which the model does not have.
    _expect_pose(pose)
    raise NotImplementedError()


def get_stop_line_linestrings(lanelet_id: int):
    # Returns lanelet2 line strings, which the model does not have.
    raise NotImplementedError()


def get_stop_line_linestrings_with_following(lanelet_id: int, depth: int = 1):
    raise NotImplementedError()


# What lane_distance reads of the map MapManager has loaded: pyxodr's
# RoadNetwork and Road, and the lxml elements they hold. Neither pyxodr nor
# lxml compiles with Codon, so only what is read is declared.


class _XmlAttributes:
    def get(self, key: str) -> Optional[str]:
        raise NotImplementedError()

    def get(self, key: str, default: str) -> str:
        raise NotImplementedError()


class _XmlElement:
    attrib: _XmlAttributes

    def find(self, path: str) -> Optional[_XmlElement]:
        raise NotImplementedError()

    def findall(self, path: str) -> List[_XmlElement]:
        raise NotImplementedError()

    def get(self, key: str, default: str) -> str:
        raise NotImplementedError()


class Road:
    road_xml: _XmlElement

    def __getitem__(self, name: str) -> str:
        raise NotImplementedError()


class RoadNetwork:
    road_ids_to_object: Dict[str, Road]


class MapManager:
    @staticmethod
    def get_instance() -> MapManager:
        raise NotImplementedError()

    @property
    def road_network(self) -> RoadNetwork:
        raise NotImplementedError()
