# Model of autoware_carla_scenario.signals (docs/typecheck.md).
# The whole signals package is checked (typecheck/library.py): the library
# check compiles its source, also when a module is checked alone, since such a
# run brings the checked modules it imports. This declares the phase a
# controller is showing and the jump to another phase.

import typesafe_carla.carla as carla


class Phase:
    name: str
    duration_seconds: float


class SignalController:
    name: str
    delay_seconds: float

    @property
    def current_phase(self) -> Optional[Phase]:
        raise NotImplementedError()

    @property
    def started_at(self) -> Optional[float]:
        raise NotImplementedError()

    def change_phase_to(self, phase_name: str, world: carla.World) -> bool:
        raise NotImplementedError()
