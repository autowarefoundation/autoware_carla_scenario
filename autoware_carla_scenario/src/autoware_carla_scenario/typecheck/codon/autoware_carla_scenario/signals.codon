# Model of autoware_carla_scenario.signals (docs/typecheck.md), for
# conditions.traffic_signal_controller, signals.registry and
# actions.traffic_signal_controller, which are checked. signals.controller is
# not (typecheck/library.py): this declares only what checked modules use of
# it, a controller found by name, the phase it is showing and the jump to
# another phase.

import typesafe_carla.carla as carla


class Phase:
    name: str
    duration_seconds: float


class SignalController:
    name: str
    delay_seconds: float

    @property
    def current_phase(self) -> Optional[Phase]:
        raise NotImplementedError()

    @property
    def started_at(self) -> Optional[float]:
        raise NotImplementedError()

    def change_phase_to(self, phase_name: str, world: carla.World) -> bool:
        raise NotImplementedError()


def find_signal_controller(name: str) -> Optional[SignalController]:
    raise NotImplementedError()
