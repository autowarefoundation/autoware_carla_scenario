# Model of autoware_carla_scenario.signals (docs/typecheck.md), for
# conditions.traffic_signal_controller and actions.traffic_signal_controller.
# The whole signals package is checked (typecheck/library.py), so the library
# check compiles them against its source; this stands in for it only when one
# of them is checked alone (`scenario-check --library <module>`), and declares
# only what they use of it: a controller found by name, the phase it is
# showing and the jump to another phase.

import typesafe_carla.carla as carla


class Phase:
    name: str
    duration_seconds: float


class SignalController:
    name: str
    delay_seconds: float

    @property
    def current_phase(self) -> Optional[Phase]:
        raise NotImplementedError()

    @property
    def started_at(self) -> Optional[float]:
        raise NotImplementedError()

    def change_phase_to(self, phase_name: str, world: carla.World) -> bool:
        raise NotImplementedError()


def find_signal_controller(name: str) -> Optional[SignalController]:
    raise NotImplementedError()
