# Derived from RuntimeError, as CPython's is: json.loads() raises it for a
# document nested too deeply, which a reader catches beside ValueError.
class RecursionError(Static[RuntimeError]):
    _pytype: ClassVar[cobj] = cobj()

    def __init__(self, *args, **kwargs):
        super().__init__("RecursionError", _message(args, kwargs, "RecursionError()"))
        self.python_type = self.__class__._pytype


# Derived from BaseException, not Exception, as CPython's is: `except
# Exception:` does not catch it.
class KeyboardInterrupt(Static[BaseException]):
    _pytype: ClassVar[cobj] = cobj()

    def __init__(self, *args, **kwargs):
        super().__init__("KeyboardInterrupt", _message(args, kwargs, "KeyboardInterrupt()"))
        self.python_type = self.__class__._pytype


def _errno_message(errno: Optional[int], strerror: Optional[str], filename: str) -> str:
    # CPython's str() of it: "[Errno 28] No space left on device: 'path'".
    return "[Errno " + str(errno) + "] " + str(strerror) + ": " + repr(filename)


# OSError(errno, strerror, filename): an error about a file, as the system
# raises one, built from another's errno and strerror (each None when that
# one had none) and the file's name, a str (CPython takes any object, which
# is not declared). Declared after the subclasses above, which do not
# inherit it (each takes one message, as before); a class a checked module
# derives from OSError does (tools.file_writes' _PartialWriteError). Two
# values stay refused, but for two strs, which a subclass passes on (above).
@extend
class OSError:
    # Exception's constructor gives the instance its class's Python type,
    # where it has one (a class derived in a checked module has none).
    def __init__(self, errno: Optional[int], strerror: Optional[str], filename: str):
        super().__init__("OSError", _errno_message(errno, strerror, filename))
