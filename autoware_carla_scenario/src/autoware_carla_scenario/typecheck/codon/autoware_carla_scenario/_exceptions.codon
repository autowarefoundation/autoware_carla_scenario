@extend
class ZeroDivisionError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class OverflowError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class AttributeError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class RuntimeError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class NotImplementedError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class StopIteration:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class AssertionError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class EOFError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class SystemExit:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)

    # `e.code`, what it was raised with (`sys.exit(2)`): an int here, the
    # status Codon's SystemExit holds. CPython's is whatever it was raised
    # with, an int, a str or None, so code reading it tests it with
    # isinstance() first, as CPython needs.
    @property
    def code(self) -> int:
        return self.status


# OSError's subclasses pass their own type name on, as Codon's LookupError
# and RuntimeError take one for theirs; its own constructor stays.
@extend
class OSError:
    def __init__(self, typename: str, message: str):
        super().__init__(typename, message)
        self.python_type = self.__class__._pytype


class ImportError(Static[Exception]):
    _pytype: ClassVar[cobj] = cobj()

    # A subclass passes its own type name and the message on, as two strs,
    # which CPython takes too.
    def __init__(self, *args, **kwargs):
        if static.len(args) == 2:
            _no_keywords(kwargs, "ImportError()")
            super().__init__(_str(args[0]), _str(args[1]))
        else:
            super().__init__("ImportError", _message(args, kwargs, "ImportError()"))
        self.python_type = self.__class__._pytype


class ModuleNotFoundError(Static[ImportError]):
    _pytype: ClassVar[cobj] = cobj()

    # A subclass (importlib.metadata's PackageNotFoundError) passes its own
    # type name and the message on, as two strs, which CPython takes too.
    def __init__(self, *args, **kwargs):
        if static.len(args) == 2:
            _no_keywords(kwargs, "ModuleNotFoundError()")
            super().__init__(_str(args[0]), _str(args[1]))
        else:
            super().__init__("ModuleNotFoundError", _message(args, kwargs, "ModuleNotFoundError()"))
        self.python_type = self.__class__._pytype


class FileNotFoundError(Static[OSError]):
    _pytype: ClassVar[cobj] = cobj()

    def __init__(self, *args, **kwargs):
        super().__init__("FileNotFoundError", _message(args, kwargs, "FileNotFoundError()"))
        self.python_type = self.__class__._pytype


