# Python's built-in exceptions that Codon 0.19 lacks (docs/typecheck.md).
#
# Every rewritten module (a checked module and a scenario alike) imports them
# through the transform's prelude (typecheck/transform.py), so they read as
# the builtins they are in Python. Each derives from its CPython base
# (FileNotFoundError from OSError, BrokenPipeError from ConnectionError).
#
# Each is built as CPython builds one with a message: from nothing or from one
# value by position, whose str() is the message (`FileNotFoundError(path)`).
# CPython's other forms are not declared, so the check refuses them: a keyword
# (CPython's OSError takes none, ImportError only `name` and `path`), other
# values (`OSError(errno, strerror)`, but for two strs where a subclass is
# derived from, below), and the attributes they fill (`errno`, `filename`,
# `name`).

import internal.static as static


def _no_keywords(kwargs, where: Literal[str]):
    # Each constructor takes `**kwargs`, so that a keyword is refused here
    # rather than taken by the constructor the class inherits from Codon's
    # (OSError's takes `message=`): Codon tries the class's own first.
    if static.len(kwargs.args) > 0:
        compile_error(where + " takes no keyword argument here")


def _message(args, kwargs, where: Literal[str]) -> str:
    # Codon 0.19 has no `/`: the message is a `*args` of at most one value.
    _no_keywords(kwargs, where)
    if static.len(args) == 0:
        return ""
    elif static.len(args) == 1:
        return str(args[0])
    else:
        compile_error(where + " takes one message here")
        return ""


def _str(value: str) -> str:
    return value


# `e.args`, which Codon's exceptions lack: the one-value tuple of the message,
# which is CPython's for an exception raised with one message (`raise
# ValueError("x")` has `args == ("x",)`). An exception raised with none or
# several values has other `args` there. Codon copies a base class's methods
# into a class when it defines it, so each of Codon's own exceptions is
# extended (a class declared below inherits it from its base).


@extend
class BaseException:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class Exception:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class NameError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class OSError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


@extend
class IOError:
    @property
    def args(self) -> Tuple[str]:
        return (self.message,)


