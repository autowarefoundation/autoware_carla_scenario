# Model of autoware_carla_scenario.entity_role (docs/typecheck.md).

import typesafe_carla.carla as carla


class EntityRole:
    _value: str

    def __init__(self, value: str):
        self._value = value

    @staticmethod
    def ego() -> EntityRole:
        return EntityRole("Ego")

    @staticmethod
    def npc(n: int) -> EntityRole:
        return EntityRole("npc" + str(n))

    def __str__(self) -> str:
        return self._value

    def __repr__(self) -> str:
        return "EntityRole(" + self._value + ")"

    def __eq__(self, other: EntityRole) -> bool:
        return self._value == other._value

    def __ne__(self, other: EntityRole) -> bool:
        return self._value != other._value

    def __hash__(self) -> int:
        return hash(self._value)


def _expect_role(role) -> EntityRole:
    """A Union[EntityRole, str] argument (a role name)."""
    if isinstance(role, EntityRole):
        return role
    elif isinstance(role, str):
        return EntityRole(role)
    else:
        compile_error("expected an EntityRole or a str (a role name)")


def _expect_role_name(role) -> str:
    """A Union[EntityRole, str] argument stored as its string (an entity config's role_name)."""
    if isinstance(role, EntityRole):
        return str(role)
    elif isinstance(role, str):
        return role
    else:
        compile_error("expected an EntityRole or a str (a role name)")


def _expect_optional_role_name(role) -> Optional[str]:
    """A Union[EntityRole, str, None] argument stored as its string
    (RelativeLanePose.entity_ref)."""
    if isinstance(role, None):
        return None
    elif isinstance(role, Optional[NoneType]):
        return None
    elif isinstance(role, Optional):
        if role is None:
            return None
        return _expect_role_name(unwrap(role))
    else:
        return _expect_role_name(role)


def _expect_optional_role(role) -> Optional[EntityRole]:
    """A Union[EntityRole, str, None] argument."""
    if isinstance(role, None):
        return None
    elif isinstance(role, Optional[NoneType]):
        return None
    elif isinstance(role, Optional):
        if role is None:
            return None
        return _expect_role(unwrap(role))
    else:
        return _expect_role(role)


def find_actor_in_list(actors, role_name) -> Optional[carla.Actor]:
    # Union[carla.ActorList, list[carla.Actor]] in Python: a Union parameter
    # crashes Codon 0.19, so it is generic and its type is checked here.
    if isinstance(actors, carla.ActorList):
        pass
    elif isinstance(actors, List[carla.Actor]):
        pass
    else:
        compile_error("find_actor_in_list(): actors is a carla.ActorList or a list of carla.Actor")
    # str(), as in Python: a checked module's EntityRole (the library check)
    # is not the model's, and both name a role the same way.
    name: str = str(role_name)
    raise NotImplementedError()


def find_actor_in_world(world: carla.World, role_name) -> Optional[carla.Actor]:
    # str(), as find_actor_in_list: a role of either EntityRole names it.
    name: str = str(role_name)
    raise NotImplementedError()
