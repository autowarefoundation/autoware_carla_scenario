# Model of autoware_carla_scenario.route (docs/typecheck.md). Its modules are
# checked (route.model, route.active, route.frame and the geometry, poses and
# search over lanelet2's model); this declares what the scenario check and
# the checked modules that import the package read of it, the scenario's
# route and its frame.

import lanelet2.core


class RouteMatch:
    # Generic: Python's fields are variadic tuples (tuple[int, ...],
    # tuple[RouteSegmentMatch, ...]), which have no Codon type, and a scenario
    # reads the running route (scenario_route()) rather than building one.
    # The constructor takes Python's parameters all the same, so a call
    # Python refuses is refused here too. Codon builds a class without fields
    # with no arguments as well, unless an __init__ of none says otherwise:
    # the first one does, and the constructor declared after it wins every
    # call it takes (docs/typecheck.md).
    def __init__(self):
        compile_error("RouteMatch(): no constructor takes these arguments "
                      "(required: lanelet_ids, start_s, end_s, segments)")

    def __init__(self, lanelet_ids, start_s, end_s, segments, index = 0):
        pass

    def anchor_s(self, anchor: Optional[str]) -> float:
        raise NotImplementedError()

    @property
    def length(self) -> float:
        raise NotImplementedError()


class RouteFrame:
    # Generic: the scenario check builds none (the checked route.active
    # builds the checked RouteFrame, of lanelet2's model).
    # No fields: Codon would build one with no arguments too (docs/typecheck.md).
    def __init__(self):
        compile_error("RouteFrame(): no constructor takes these arguments "
                      "(required: match, lanelet_map, routing_graph)")

    def __init__(self, match, lanelet_map, routing_graph):
        pass

    def project(self, x: float, y: float, near: Optional[float] = None) -> Tuple[float, float]:
        raise NotImplementedError()

    def height(self, s: float) -> float:
        raise NotImplementedError()

    @property
    def length(self) -> float:
        raise NotImplementedError()

    def locate(self, s: float) -> Tuple[int, float]:
        raise NotImplementedError()

    def point(self, s: float) -> Tuple[float, float, float]:
        raise NotImplementedError()

    def lanelet_at(self, s: float) -> lanelet2.core.Lanelet:
        raise NotImplementedError()

    def junction_way(self, index: int) -> Tuple[List[lanelet2.core.ConstLanelet],
                                                Optional[lanelet2.core.ConstLanelet],
                                                Optional[lanelet2.core.ConstLanelet]]:
        raise NotImplementedError()


# The values trajectory.model's route poses are checked against.
APPROACHES = ("left", "right", "opposite")
CROSSWALK_LEGS = ("entry", "exit")
SIDES = ("left", "right")


def parse_anchor(anchor: str) -> Tuple[str, int, str]:
    raise NotImplementedError()


def scenario_route() -> Optional[RouteMatch]:
    raise NotImplementedError()


def scenario_route_frame() -> RouteFrame:
    raise NotImplementedError()
