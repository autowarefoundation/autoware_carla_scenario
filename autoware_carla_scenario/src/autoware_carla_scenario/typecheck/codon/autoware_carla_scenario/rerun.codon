# Model of autoware_carla_scenario.rerun (docs/typecheck.md), which runs the
# conversion on a thread pool and imports the converter package at run time:
# what the checked scenario_runner and scenario_queue use of it, with the
# signatures of the Python class.

from pathlib import Path

from ._tc import _keyword_only as _acs_keyword_only

# The trajectory log's suffix (`{stem}.trajectory.jsonl`), which the checked
# t4_scene.grid reads. Python's is the checked run_outputs's (#1678); a model
# cannot import a checked module (the scenario check compiles only the
# model), so it is declared here, with Python's value.
TRAJECTORY_SUFFIX: str = ".trajectory.jsonl"


def recording_path(trajectory: Path) -> Path:
    raise NotImplementedError()


class RerunConverter:
    # The converter package, which Python holds as `Any`: taken as it comes.
    def __init__(self, *_kw, strict: bool = False, converter = None,
                 lidar_max_points: Optional[int] = None, lidar_sdk = None,
                 cameras: bool = False):
        _acs_keyword_only(
            _kw,
            "RerunConverter(): strict, converter, lidar_max_points, lidar_sdk and cameras",
        )

    def start_sensors(self, trajectory: Path, label: str, start_frame: int) -> None:
        raise NotImplementedError()

    def stop_sensors(self) -> None:
        raise NotImplementedError()

    def submit(self, trajectory: Path, label: str) -> Path:
        raise NotImplementedError()

    # Python returns the RerunConversion records, which are not modelled
    # (their `stats` is a dict of mixed values): the checked scenario_queue
    # drops them.
    def wait(self) -> None:
        raise NotImplementedError()
