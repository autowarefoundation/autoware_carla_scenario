# Model of autoware_carla_scenario.rerun (docs/typecheck.md), which runs the
# conversion on a thread pool and imports the converter package at run time:
# what the checked scenario_runner and scenario_queue use of it, with the
# signatures of the Python class.

from pathlib import Path
from typing import Optional

from ._tc import _keyword_only as _acs_keyword_only

# The trajectory log's suffix (`{stem}.trajectory.jsonl`), which the checked
# t4_scene.grid reads. Python's is the checked run_outputs's (#1678); a model
# cannot import a checked module (the scenario check compiles only the
# model), so it is declared here, with Python's value.
TRAJECTORY_SUFFIX: str = ".trajectory.jsonl"


def recording_path(trajectory: Path) -> Path:
    raise NotImplementedError()


class RerunConversion:
    # Codon would build it from no arguments too (docs/typecheck.md).
    def __init__(self):
        compile_error("RerunConversion(): no constructor takes these arguments (required: label, trajectory, recording)")

    # What the converter returned (`stats`), which Python holds as a dict of
    # mixed values: taken as it comes, and not declared. Python's fields are
    # read as properties: a field would change the constructor Codon
    # generates.
    def __init__(self, label: str, trajectory: Path, recording: Path,
                 error: Optional[str] = None, stats = None,
                 skipped: bool = False):
        pass

    @property
    def label(self) -> str:
        raise NotImplementedError()

    @property
    def trajectory(self) -> Path:
        raise NotImplementedError()

    @property
    def recording(self) -> Path:
        raise NotImplementedError()

    @property
    def error(self) -> Optional[str]:
        raise NotImplementedError()

    @property
    def skipped(self) -> bool:
        raise NotImplementedError()

    @property
    def ok(self) -> bool:
        raise NotImplementedError()


class RerunConverter:
    # The converter package, which Python holds as `Any`: taken as it comes.
    def __init__(self, *_kw, strict: bool = False, converter = None,
                 lidar_max_points: Optional[int] = None, lidar_sdk = None,
                 cameras: bool = False, draw_radius_m: Optional[float] = None):
        _acs_keyword_only(
            _kw,
            "RerunConverter(): strict, converter, lidar_max_points, lidar_sdk, cameras and draw_radius_m",
        )

    def start_sensors(self, trajectory: Path, label: str, start_frame: int) -> None:
        raise NotImplementedError()

    def stop_sensors(self) -> None:
        raise NotImplementedError()

    def submit(self, trajectory: Path, label: str) -> Path:
        raise NotImplementedError()

    # How each log submitted so far went, in submission order: the checked
    # scenario_queue drops them.
    def wait(self) -> list[RerunConversion]:
        raise NotImplementedError()

    # Drops the conversions into a recording removed since (a retried run's).
    def forget(self, recording: Path) -> None:
        raise NotImplementedError()
