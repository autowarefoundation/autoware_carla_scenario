# Model of autoware_carla_scenario.odd (docs/odd.md, docs/typecheck.md).
#
# An ODD written in Python is compiled against this, like a scenario: the
# builder function is called, every attribute's probe is called with a world,
# and every condition a module holds must be one an attribute built.

from pathlib import Path

import typesafe_carla.carla as carla
import lanelet2.core
import lanelet2.routing

from ._tc import (_keyword_only, _expect_float, _expect_int_sequence, _expect_optional_float,
                  _acs_sequence, _expect_str_sequence)
from .coverage import (CoverItem, _expect_cover_expression, _expect_optional_range,
                       _expect_optional_edges, _expect_optional_values)


NEARBY_RADIUS_M: float = 50.0
ILLUMINATION_LEVELS: List[str] = ["day", "low_sun", "twilight", "night"]
INTENSITY_LEVELS: List[str] = ["none", "light", "moderate", "heavy"]
TRAFFIC_DENSITY_LEVELS: List[str] = ["none", "low", "medium", "high"]


# openodd's sentinel for a value only the run can tell (odd.model.UNDECIDED,
# of a Rust extension's class, which odd.model names Undecided): one
# instance, compared by identity, written UNDECIDED.  Python cannot build
# another (`type(UNDECIDED)()` raises), so neither can the check: the model's
# one is allocated without its constructor.
class Undecided:
    _unused: int

    def __init__(self):
        compile_error("Undecided(): UNDECIDED is openodd's only one; it is not built")

    def __repr__(self) -> str:
        return "UNDECIDED"

    def __str__(self) -> str:
        return "UNDECIDED"


UNDECIDED: Undecided = Undecided.__new__()


class OddCondition:
    _unused: int

    # Codon would build it by its fields too (docs/typecheck.md, #244).
    def __init__(self, _unused):
        compile_error("OddCondition(): no constructor takes these arguments (it takes none)")

    def __init__(self):
        self._unused = 0

    def attributes(self) -> List[str]:
        raise NotImplementedError()

    def describe(self) -> str:
        raise NotImplementedError()

    def references(self) -> List[str]:
        raise NotImplementedError()


def _expect_optional_conditions(conditions):
    """An Optional[Sequence[OddCondition]] argument."""
    if isinstance(conditions, None):
        pass
    elif isinstance(conditions, Optional[NoneType]):
        pass
    else:
        for condition in _acs_sequence(conditions, OddCondition):
            c: OddCondition = condition


def _expect_optional_labels(labels, where: Literal[str]):
    """An Optional[Sequence[str]] argument of names: not a str (#299)."""
    if isinstance(labels, None):
        pass
    elif isinstance(labels, Optional[NoneType]):
        pass
    else:
        _expect_str_sequence(labels, where)


class OddAttribute:
    name: str
    unit: str
    text: str

    # Codon would build it by its fields' names too (docs/typecheck.md, #244).
    def __init__(self, name, unit, text):
        compile_error("OddAttribute(): no constructor takes these arguments (required: name, probe)")

    def __init__(self, name: str, probe, *_kw, unit: str = "", range = None,
                 every = None, buckets = None, values = None, text: str = "",
                 target = 1.0, cover_by: str = "hits", min_stay = None):
        _keyword_only(_kw, "OddAttribute(): every argument but name and probe")
        _expect_float(target)
        _expect_optional_float(min_stay)
        _expect_cover_expression(probe)
        _expect_optional_range(range)
        _expect_optional_float(every)
        _expect_optional_edges(buckets)
        _expect_optional_values(values, "OddAttribute()")
        self.name = name
        self.unit = unit
        self.text = text

    # Python's instance attributes, read as properties (#307): fields would
    # change the constructor Codon generates. The probe is not modelled
    # (NOT_MODELLED_MEMBERS).
    @property
    def target(self) -> float:
        raise NotImplementedError()

    @property
    def item(self) -> Optional[CoverItem]:
        raise NotImplementedError()

    @property
    def cover_by(self) -> str:
        raise NotImplementedError()

    @property
    def min_stay(self) -> Optional[float]:
        raise NotImplementedError()

    @property
    def derived(self) -> bool:
        raise NotImplementedError()

    @property
    def derived_from(self) -> List[str]:
        raise NotImplementedError()

    @property
    def source(self) -> Tuple[str, str]:
        raise NotImplementedError()

    def is_in(self, values) -> OddCondition:
        for value in values:
            pass
        raise NotImplementedError()

    def equals(self, value) -> OddCondition:
        raise NotImplementedError()

    def between(self, low, high) -> OddCondition:
        _expect_float(low)
        _expect_float(high)
        raise NotImplementedError()

    def at_least(self, bound) -> OddCondition:
        _expect_float(bound)
        raise NotImplementedError()

    def at_most(self, bound) -> OddCondition:
        _expect_float(bound)
        raise NotImplementedError()

    def greater_than(self, bound) -> OddCondition:
        _expect_float(bound)
        raise NotImplementedError()

    def less_than(self, bound) -> OddCondition:
        _expect_float(bound)
        raise NotImplementedError()

    def is_unknown(self) -> OddCondition:
        raise NotImplementedError()


def _expect_conditions(conditions):
    """A Sequence[OddCondition] argument (a list or a tuple, an empty one too,
    #264)."""
    for condition in _acs_sequence(conditions, OddCondition):
        c: OddCondition = condition


def all_of(conditions) -> OddCondition:
    _expect_conditions(conditions)
    raise NotImplementedError()


def any_of(conditions) -> OddCondition:
    _expect_conditions(conditions)
    raise NotImplementedError()


def module_holds(name: str, holds: bool = True) -> OddCondition:
    raise NotImplementedError()


class OddModule:
    name: str
    active: bool
    text: str

    def __init__(self, name: str, *_kw, include_and = None, include_or = None,
                 exclude_and = None, exclude_or = None, labels = None,
                 active: bool = True, text: str = "", situation: bool = False,
                 target = 1.0, cover_by: str = "hits", min_stay = None,
                 metadata = None):
        _keyword_only(_kw, "OddModule(): every argument but name")
        _expect_float(target)
        _expect_optional_float(min_stay)
        if not (isinstance(include_and, None) or isinstance(include_and, Optional[NoneType])):
            if not (isinstance(include_or, None) or isinstance(include_or, Optional[NoneType])):
                compile_error("OddModule(): one include section, include_and or include_or")
        if not (isinstance(exclude_and, None) or isinstance(exclude_and, Optional[NoneType])):
            if not (isinstance(exclude_or, None) or isinstance(exclude_or, Optional[NoneType])):
                compile_error("OddModule(): one exclude section, exclude_and or exclude_or")
        _expect_optional_conditions(include_and)
        _expect_optional_conditions(include_or)
        _expect_optional_conditions(exclude_and)
        _expect_optional_conditions(exclude_or)
        _expect_optional_labels(labels, "OddModule(): labels")
        self.name = name
        self.active = active
        self.text = text

    def as_situation(self, *_kw, target = 1.0, cover_by: str = "hits",
                     min_stay = None) -> None:
        _keyword_only(_kw, "OddModule.as_situation(): every argument")
        _expect_float(target)
        _expect_optional_float(min_stay)
        raise NotImplementedError()

    def conditions(self) -> List[OddCondition]:
        raise NotImplementedError()

    @property
    def labels(self) -> List[str]:
        raise NotImplementedError()

    @property
    def situation(self) -> bool:
        raise NotImplementedError()

    @property
    def item(self) -> Optional[CoverItem]:
        raise NotImplementedError()


def _expect_optional_modules(modules):
    """An Optional[Sequence[OddModule]] argument."""
    if isinstance(modules, None):
        pass
    elif isinstance(modules, Optional[NoneType]):
        pass
    else:
        for module in _acs_sequence(modules, OddModule):
            m: OddModule = module


class OddDefinition:
    name: str
    modules: List[OddModule]
    text: str

    # Codon would build it by its fields' names too (docs/typecheck.md, #244).
    def __init__(self, name, modules, text):
        compile_error("OddDefinition(): no constructor takes these arguments (required: name, attributes)")

    def __init__(self, name: str, attributes, modules = None, *_kw,
                 roots = None, text: str = ""):
        _keyword_only(_kw, "OddDefinition(): roots and text")
        for attribute in _acs_sequence(attributes, OddAttribute):
            a: OddAttribute = attribute
        _expect_optional_modules(modules)
        _expect_optional_labels(roots, "OddDefinition(): roots")
        self.name = name
        self.modules = List[OddModule]()
        if not (isinstance(modules, None) or isinstance(modules, Optional[NoneType])):
            for module in _acs_sequence(modules, OddModule):
                self.modules.append(module)
        self.text = text

    # Python's instance attribute, read as a property (#307), as roots and
    # the rest are: a field would change the constructor Codon generates.
    @property
    def attributes(self) -> List[OddAttribute]:
        raise NotImplementedError()

    @property
    def roots(self) -> List[str]:
        raise NotImplementedError()

    @property
    def version(self) -> Optional[str]:
        raise NotImplementedError()

    @property
    def revision(self) -> Optional[str]:
        raise NotImplementedError()

    @property
    def structure_digest(self) -> str:
        raise NotImplementedError()

    @property
    def sources(self) -> List[Dict[str, str]]:
        raise NotImplementedError()

    def cover_items(self) -> List[CoverItem]:
        raise NotImplementedError()

    def situations(self) -> List[OddModule]:
        raise NotImplementedError()

    def unmeasured(self) -> List[str]:
        raise NotImplementedError()

    def outside_buckets(self, attribute) -> List[str]:
        """Union[OddAttribute, str]: a Union parameter crashes Codon 0.19, so
        the attribute is generic and its type is checked here."""
        if isinstance(attribute, str) or isinstance(attribute, Optional[str]):
            pass
        elif isinstance(attribute, OddAttribute) or isinstance(attribute, Optional[OddAttribute]):
            pass
        else:
            compile_error("OddDefinition.outside_buckets(): the attribute is an "
                          "OddAttribute or its name")
        raise NotImplementedError()


# openodd's sample and parameter space (a Rust extension): the checked
# scenario_runner only hands them to CoverageCollector.record_case(), so
# neither declares more than its being a value.
class OddSample:
    _unused: int

    def __init__(self):
        compile_error("OddSample: openodd's sampler draws it; it is not built here")

    def _acs_odd_sample(self) -> int:
        return 0


class ParameterSpace:
    _unused: int

    def __init__(self):
        compile_error("ParameterSpace: openodd's flaky search builds it; it is not built here")

    def _acs_parameter_space(self) -> int:
        return 0


# A case drawn from the ODD and the space it was drawn in
# (`tuple[OddSample, ParameterSpace]`): the checked scenario_runner records it
# (`coverage.record_case(*case)`), and scenario_queue passes it on.
@tuple
class OddCase:
    sample: OddSample
    space: ParameterSpace


# What the checked scenario_runner uses of odd.route (excluded): the ODD's
# verdict on the ego's planned route.  Neither class is built by a scenario:
# plan_route_coverage() returns them.
class RouteLanelet:
    lanelet_id: int
    length_m: float
    verdict: str
    failing_modules: List[str]

    def __init__(self, lanelet_id: int, length_m: float, verdict: str,
                 values = None, failing_modules = None):
        compile_error("RouteLanelet: plan_route_coverage() builds it")


class RouteCoverage:
    # Python's fields, in its order: the constructor Codon generates of them
    # takes the calls Python's does, and the one below refuses each.
    odd: str
    name: str
    lanelets: List[RouteLanelet]
    expected_m: Dict[str, Dict[str, float]]
    map_attributes: List[str]

    def __init__(self, odd: str, name: str, lanelets: List[RouteLanelet],
                 expected_m: Dict[str, Dict[str, float]], map_attributes: List[str]):
        compile_error("RouteCoverage: plan_route_coverage() builds it")

    @property
    def length_m(self) -> float:
        raise NotImplementedError()

    @property
    def outside_m(self) -> float:
        raise NotImplementedError()

    @property
    def inside_m(self) -> float:
        raise NotImplementedError()

    @property
    def undecided_m(self) -> float:
        raise NotImplementedError()

    @property
    def leaves_odd(self) -> bool:
        raise NotImplementedError()

    @property
    def lanelet_ids(self) -> List[int]:
        raise NotImplementedError()

    def outside(self) -> List[RouteLanelet]:
        raise NotImplementedError()

    def undecided(self) -> List[RouteLanelet]:
        raise NotImplementedError()


def plan_route_coverage(odd, scenario_or_route, *_kw, lanelet_map = None,
                        routing_graph = None, name: str = "") -> RouteCoverage:
    """The ODD's verdict on a planned route.  *odd* is a
    Union[OddDefinition, str, None] and *scenario_or_route* a
    Union[BaseScenario, PlannedRoute, Iterable[int]]: a Union parameter
    crashes Codon 0.19, so both are generic and checked here.  A scenario is
    told by its goal (`goal_pose`, `require_goal()`): the checked runner passes
    the checked scenario_base's BaseScenario, not the model's.  PlannedRoute
    (odd.route_plan) is not declared, so passing one fails the check."""
    _keyword_only(_kw, "plan_route_coverage(): lanelet_map, routing_graph and name")
    if hasattr(scenario_or_route, "goal_pose") and hasattr(scenario_or_route, "require_goal"):
        pass
    else:
        _expect_int_sequence(scenario_or_route)
    if isinstance(odd, None):
        pass
    elif isinstance(odd, Optional[NoneType]):
        pass
    elif isinstance(odd, str) or isinstance(odd, Optional[str]):
        pass
    elif isinstance(odd, OddDefinition) or isinstance(odd, Optional[OddDefinition]):
        pass
    else:
        compile_error("plan_route_coverage(): the ODD is an OddDefinition, a str or None")
    if not (isinstance(lanelet_map, None) or isinstance(lanelet_map, Optional[NoneType])):
        m: Optional[lanelet2.core.LaneletMap] = lanelet_map
    if not (isinstance(routing_graph, None) or isinstance(routing_graph, Optional[NoneType])):
        g: Optional[lanelet2.routing.RoutingGraph] = routing_graph
    raise NotImplementedError()


def default_odd() -> OddDefinition:
    raise NotImplementedError()


def resolve_odd(spec = None) -> OddDefinition:
    """Union[str, Path, OddDefinition, None]: a Union parameter crashes Codon
    0.19, so the spec is generic and its type is checked here."""
    if isinstance(spec, None):
        pass
    elif isinstance(spec, Optional[NoneType]):
        pass
    elif isinstance(spec, str) or isinstance(spec, Optional[str]):
        pass
    elif isinstance(spec, Path) or isinstance(spec, Optional[Path]):
        pass
    elif isinstance(spec, OddDefinition) or isinstance(spec, Optional[OddDefinition]):
        pass
    else:
        compile_error("resolve_odd(): the spec is a str, a Path, an OddDefinition or None")
    raise NotImplementedError()


def reset_probes() -> None:
    raise NotImplementedError()


def register_odd(name: str, builder) -> None:
    odd: OddDefinition = builder()


