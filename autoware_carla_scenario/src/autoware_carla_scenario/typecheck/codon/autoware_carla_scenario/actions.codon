class TrafficSourceAction(BaseAction):
    def __init__(self, constraints, *_kw, initial_vehicles: int = 0,
                 vehicles_per_minute: float = 0.0, max_vehicles = None,
                 speed_kmh: float = 30.0, min_gap_m: float = 15.0, blueprint = None,
                 seed: int = 0, label: str = "traffic_source", condition = None,
                 timing: TickTiming = TickTiming("pre_tick"), once: bool = True,
                 until = None, reissue = None):
        _keyword_only(_kw, "TrafficSourceAction(): everything after the constraints")
        super().__init__(label, condition, timing, once=once, until=until, reissue=reissue)


