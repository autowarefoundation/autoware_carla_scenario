class WalkStraightAction(BaseAction):
    def __init__(self, entity_name, speed_ms: float = 1.4, condition = None,
                 timing: TickTiming = TickTiming("pre_tick"), *_kw, label: str = "walk_straight",
                 once: bool = True):
        _keyword_only(_kw, "WalkStraightAction(): label and once")
