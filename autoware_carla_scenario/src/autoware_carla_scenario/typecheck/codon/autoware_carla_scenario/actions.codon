from .traffic import TurnDirection, LaneChangeDirection
from .trajectory import (Trajectory, TrajectoryFollowingMode, TrajectoryTiming,
                         _expect_optional_timing)


@tuple
class TickTiming:
    value: str
    PRE_TICK: ClassVar[TickTiming] = TickTiming("pre_tick")
    POST_TICK: ClassVar[TickTiming] = TickTiming("post_tick")

    # Enum's name (#307): Codon has no Enum to give a framework enum one.
    @property
    def name(self) -> str:
        if self == TickTiming.PRE_TICK:
            return "PRE_TICK"
        if self == TickTiming.POST_TICK:
            return "POST_TICK"
        raise ValueError("not a member of TickTiming")


@tuple
class TrafficLightTarget:
    value: str
    ALL: ClassVar[TrafficLightTarget] = TrafficLightTarget("all")

    # Enum's name (#307): Codon has no Enum to give a framework enum one.
    @property
    def name(self) -> str:
        if self == TrafficLightTarget.ALL:
            return "ALL"
        raise ValueError("not a member of TrafficLightTarget")


class BaseAction:
    # Codon also builds a class by its fields, by position: a subclass with
    # its inherited label alone (`TurnAction("npc1")`). Each subclass declares
    # an __init__ of one argument that refuses this, ahead of its
    # constructor, which wins every call it takes (docs/typecheck.md).
    label: str
    REISSUES_BY_DEFAULT: ClassVar[bool] = False

    def __init__(self, label: str, condition = None,
                 timing: TickTiming = TickTiming("post_tick"), *_kw, once: bool = True,
                 until = None, reissue = None):
        _keyword_only(_kw, "BaseAction(): once, until and reissue")
        _expect_optional_condition(condition)
        _expect_optional_condition(until)
        _expect_optional_bool(reissue)
        self.label = label

    def _acs_action(self) -> int:
        """Marks an action for _acs_list (lists.codon)."""
        return 0

    @staticmethod
    def _acs_hook_returns(name: Literal[str], r):
        """The return type of each method an override of which the scenario
        check checks (_acs_hook_return in _tc.codon, #238)."""
        if name == "timing":
            _acs_expect_return(r, TickTiming, "BaseAction.timing returns TickTiming")
        elif name == "done":
            _acs_expect_return(r, bool, "BaseAction.done returns bool")
        elif name == "state":
            _acs_expect_return(r, ActionState, "BaseAction.state returns ActionState")
        elif name == "sets_tire_friction":
            _acs_expect_return(r, bool, "BaseAction.sets_tire_friction returns bool")
        elif name == "reissues_while_running":
            _acs_expect_return(r, bool, "BaseAction.reissues_while_running returns bool")
        elif name == "execute":
            _acs_expect_return(r, NoneType, "BaseAction.execute() returns None")
        elif name == "tick":
            _acs_expect_return(r, NoneType, "BaseAction.tick() returns None")

    @property
    def timing(self) -> TickTiming:
        raise NotImplementedError()

    @property
    def done(self) -> bool:
        raise NotImplementedError()

    @property
    def state(self) -> ActionState:
        raise NotImplementedError()

    @property
    def sets_tire_friction(self) -> bool:
        raise NotImplementedError()

    @property
    def reissues_while_running(self) -> bool:
        raise NotImplementedError()

    def execute(self, world: carla.World) -> None:
        raise NotImplementedError()

    def tick(self, world: carla.World, elapsed: float) -> None:
        raise NotImplementedError()


def _expect_action(action: BaseAction) -> BaseAction:
    # Checked once here, so an action subclass reaches execute() typed, and
    # returns None as BaseAction.execute() does (#238).
    BaseAction._acs_hook_returns("execute", action.execute(carla.Client().get_world()))
    return action


def _expect_traffic_light_ids(ids):
    """A Union[Sequence[int], TrafficLightTarget, None] argument."""
    if isinstance(ids, None):
        pass
    elif isinstance(ids, Optional[NoneType]):
        pass
    elif isinstance(ids, TrafficLightTarget):
        pass
    else:
        for i in _acs_sequence(ids, int):
            if not isinstance(i, int):
                compile_error("expected lanelet2 traffic light ids (ints), TrafficLightTarget.ALL or None")


class EnvironmentAction(BaseAction):
    def __init__(self, label):
        compile_error("EnvironmentAction(): no constructor takes these arguments")

    def __init__(self, cloudiness = None, precipitation = None, precipitation_deposits = None,
                 wetness = None, wind_intensity = None, fog_density = None, fog_distance = None,
                 sun_altitude_angle = None, sun_azimuth_angle = None, condition = None,
                 timing: TickTiming = TickTiming("pre_tick"), *_kw, rain = None,
                 tire_friction = None, tire_friction_quantile = None,
                 visibility_m = None, visibility_quantile = None,
                 label: str = "environment",
                 once: bool = True):
        _keyword_only(_kw, "EnvironmentAction(): rain, tire_friction, "
                      "tire_friction_quantile, visibility_m, visibility_quantile, "
                      "label and once")
        _expect_optional_float(cloudiness)
        _expect_optional_float(precipitation)
        _expect_optional_float(precipitation_deposits)
        _expect_optional_float(wetness)
        _expect_optional_float(wind_intensity)
        _expect_optional_float(fog_density)
        _expect_optional_float(fog_distance)
        _expect_optional_float(sun_altitude_angle)
        _expect_optional_float(sun_azimuth_angle)
        _expect_optional_float(rain)
        _expect_optional_float(tire_friction)
        _expect_optional_float(tire_friction_quantile)
        _expect_optional_float(visibility_m)
        _expect_optional_float(visibility_quantile)
        super().__init__(label, condition, timing, once=once)

    @property
    def settings(self) -> Dict[str, float]:
        raise NotImplementedError()

    @property
    def sets_tire_friction(self) -> bool:
        raise NotImplementedError()

    @property
    def sets_visibility(self) -> bool:
        raise NotImplementedError()


