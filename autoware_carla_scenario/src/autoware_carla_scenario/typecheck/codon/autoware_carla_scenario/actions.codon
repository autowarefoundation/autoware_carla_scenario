        self.taper_length_out = taper_length_out
        self.taper_type = taper_type
        self.warning_zone_length = warning_zone_length
        self.warning_zone_spacing = warning_zone_spacing
        self.buffer_zone_length = buffer_zone_length
        self.termination_zone_length = termination_zone_length
        self.warning_sign_offset = warning_sign_offset
        self.side = side


