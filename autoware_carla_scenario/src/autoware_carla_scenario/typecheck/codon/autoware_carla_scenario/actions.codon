                 following_mode: TrajectoryFollowingMode = TrajectoryFollowingMode("position"),
                 initial_distance_offset: float = 0.0, condition = None,
                 timing: TickTiming = TickTiming("pre_tick"), *_kw,
                 label: str = "follow_trajectory", once: bool = True, until = None,
                 control_config = None, hidden_outside_trajectory: bool = False,
                 speed = None, appear_on_start: bool = False, stop_at_end: bool = True):
        _keyword_only(_kw, "FollowTrajectoryAction(): label, once, until, control_config, "
                           "hidden_outside_trajectory, speed, appear_on_start and stop_at_end")
        _expect_role(entity_name)
        _expect_optional_timing(time_reference)
        _expect_optional_float(speed)
        super().__init__(label, condition, timing, once=once, until=until)

    @property
    def trajectory(self) -> Trajectory:
        raise NotImplementedError()

    @property
    def finished(self) -> bool:
        raise NotImplementedError()

    @property
    def held_vertex(self) -> Optional[int]:
        raise NotImplementedError()


