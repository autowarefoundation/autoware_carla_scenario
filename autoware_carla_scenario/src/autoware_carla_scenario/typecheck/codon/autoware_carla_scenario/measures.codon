    raise NotImplementedError()


def vehicle_ahead_gap_between(ego: carla.Transform, ego_bumpers: Bumpers,
                              other: carla.Transform,
                              other_bumpers: Bumpers) -> Optional[float]:
    raise NotImplementedError()


def stop_line_distance_between(ego: carla.Transform,
                               ego_bumpers: Bumpers) -> Optional[float]:
    raise NotImplementedError()


def stop_line_lane(ego: carla.Transform, ego_bumpers: Bumpers) -> List[int]:
    raise NotImplementedError()


def prepare_vehicle_ahead() -> None:
    raise NotImplementedError()



def check_measure_key(key: str, where: str) -> None:
    raise NotImplementedError()


def _acs_expect_scenario(scenario: _acs_BaseScenario) -> _acs_BaseScenario:
    return scenario


def _acs_expect_optional_scenario(scenario) -> Optional[_acs_BaseScenario]:
    """An Optional[BaseScenario] argument (Codon's Optional does not take a subclass)."""
    if isinstance(scenario, None):
        return None
    elif isinstance(scenario, Optional[NoneType]):
        return None
    elif isinstance(scenario, Optional):
        if scenario is None:
            return None
        return _acs_expect_scenario(unwrap(scenario))
    else:
        return _acs_expect_scenario(scenario)


# The scenario whose measures read_measure() reads, which the runner sets: an
# Optional[BaseScenario], a scenario passing itself (a subclass) or None.
def set_measured_scenario(scenario) -> None:
    _acs_expect_optional_scenario(scenario)
    raise NotImplementedError()


def measured_scenario() -> Optional[_acs_BaseScenario]:
    raise NotImplementedError()


def read_measure(key: str, world: carla.World) -> Optional[float]:
    raise NotImplementedError()
