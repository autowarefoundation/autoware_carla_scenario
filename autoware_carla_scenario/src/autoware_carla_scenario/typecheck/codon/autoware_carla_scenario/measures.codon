# Model of autoware_carla_scenario.measures (docs/odd.md, "Scenario measures"):
# the keys a scenario's measures are read under, which a scenario passes to
# BaseScenario.register_measure() and an ODD to odd.scenario_measure(), the
# Measure they are read with and the built-in ones by key
# (BUILT_IN_MEASURES), the vehicle-ahead definition (its version, the
# definitions it reads with, a vehicle's bumpers), the geometry it reads in
# and the running scenario's measures (read_measure()). It declares the whole
# of measures.__all__; test_typecheck_model.py compares every name with the
# Python one, the constants and each built-in measure's fields by value.
#
# Nothing here reads a measure: a built-in measure's `read` is _acs_unread(),
# where Python's is a private function of the module, which no scenario
# imports. Every other field holds Python's value.

import typesafe_carla.carla as carla

# Measure is defined beside the reader check, which scenario_base imports
# too: BaseScenario.measures returns a Dict[str, Measure], and this module
# imports scenario_base (#265). _acs_unread under its _acs_ name: no name of
# the module in Python.
from ._reader import Measure, _acs_unread

# Under an _acs_ name: BaseScenario is no name of measures in Python, which
# imports it for its annotations only.
from .scenario_base import BaseScenario as _acs_BaseScenario

VEHICLE_AHEAD_GAP_M: str = "vehicle_ahead_gap_m"
VEHICLE_AHEAD_RELATIVE_SPEED_KPH: str = "vehicle_ahead_relative_speed_kph"
CROSSING_PEDESTRIAN_GAP_M: str = "crossing_pedestrian_gap_m"
CROSSING_PEDESTRIAN_SPEED_MS: str = "crossing_pedestrian_speed_ms"
STOP_LINE_DISTANCE_M: str = "stop_line_distance_m"

VEHICLE_AHEAD_VERSION: int = 2
ALONG_LANE: str = "along_lane"
GEOMETRIC: str = "geometric"

AHEAD_RANGE_M: float = 100.0
LANE_HALF_WIDTH_M: float = 1.75
ON_LANELET_M: float = 0.2
EGO_LANE_HEADING_DEG: float = 60.0
PEDESTRIAN_LATERAL_M: float = 10.0
PEDESTRIAN_MOVING_MS: float = 0.5
PROBE_ROLE: str = "bumper_probe"


# A frozen dataclass in Python, so @tuple here.
@tuple
class Bumpers:
    front: float = 0.0
    rear: float = 0.0


BUILT_IN_MEASURES: Dict[str, Measure] = {
    VEHICLE_AHEAD_GAP_M: Measure(
        VEHICLE_AHEAD_GAP_M,
        _acs_unread,
        "m",
        "Bumper to bumper, along the ego's lane on the Lanelet2 map, to "
        "the nearest vehicle ahead on its lane or a lane beside it (a "
        "vehicle about to cut in is measured from before it changes "
        "lanes); along the ego's heading where there is no lane",
        VEHICLE_AHEAD_VERSION,
    ),
    VEHICLE_AHEAD_RELATIVE_SPEED_KPH: Measure(
        VEHICLE_AHEAD_RELATIVE_SPEED_KPH,
        _acs_unread,
        "km/h",
        "That vehicle's speed along the ego's lane less the ego's; "
        "negative when the ego closes in",
        VEHICLE_AHEAD_VERSION,
    ),
    CROSSING_PEDESTRIAN_GAP_M: Measure(
        CROSSING_PEDESTRIAN_GAP_M,
        _acs_unread,
        "m",
        "How far ahead the nearest pedestrian ahead that is moving was "
        "when it set off, held while it crosses: one standing at the kerb "
        "is not measured until it sets off",
    ),
    CROSSING_PEDESTRIAN_SPEED_MS: Measure(
        CROSSING_PEDESTRIAN_SPEED_MS,
        _acs_unread,
        "m/s",
        "That pedestrian's speed",
    ),
    STOP_LINE_DISTANCE_M: Measure(
        STOP_LINE_DISTANCE_M,
        _acs_unread,
        "m",
        "Along the ego's lane on the Lanelet2 map, from its front bumper "
        "to the nearest stop line ahead (a traffic light's, a traffic "
        "sign's, a detection area's or a road marking's)",
    ),
}


def bumpers_of_box(box: carla.BoundingBox) -> Bumpers:
    raise NotImplementedError()


def bumpers_of(actor: carla.Actor) -> Bumpers:
    raise NotImplementedError()


def measure_version(key: str) -> int:
    raise NotImplementedError()


