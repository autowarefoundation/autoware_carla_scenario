# Model of autoware_carla_scenario.entity._spawn and .vehicle_entity
# (docs/typecheck.md), re-exported by entity.codon. The library check compiles
# the checked source in its place (REPLACED_MODELS, typecheck/library.py), so
# the model's EgoConfig derives from the checked VehicleEntityConfig and hands
# the checked spawn_vehicle_actor the checked SpawnLocation.
#
# SpawnLocation (Union[SpawnTransform, SpawnPointIndex] in Python) is the base
# class of the two here.

import typesafe_carla.carla as carla

from .constants import DEFAULT_TM_PORT
from ._tc import _keyword_only
from .coordinate import (OpenDrivePose, GroundProjectionConfig, Lanelet2Pose, CarlaWorldPose,
                         _expect_optional_ground_projection, _expect_lanelet2_poses)
from .traffic import LaneChangeDirection, SimulationFidelity, TurnDirection
from .entity_role import _expect_role_name


class SpawnLocation:
    def __init__(self):
        pass


class SpawnTransform(SpawnLocation):
    value: carla.Transform

    def __init__(self, value: carla.Transform):
        super().__init__()
        self.value = value


class SpawnPointIndex(SpawnLocation):
    value: int

    def __init__(self, value: int):
        super().__init__()
        self.value = value


class VehicleEntityConfig:
    role_name: str
    spawn_location: SpawnLocation
    vehicle_type: str
    initial_speed_kmh: float
    spawn_retry_max_count: int
    spawn_retry_t_step: float
    spawn_retry_z_step: float
    od_pose: Optional[OpenDrivePose]
    ground_projection: Optional[GroundProjectionConfig]

    def __init__(self, role_name, spawn_location: SpawnLocation,
                 vehicle_type: str = "vehicle.mini.cooper", initial_speed_kmh: float = 0.0,
                 spawn_retry_max_count: int = 0, spawn_retry_t_step: float = 0.1,
                 spawn_retry_z_step: float = 0.5, od_pose: Optional[OpenDrivePose] = None,
                 ground_projection = None):
        self.role_name = _expect_role_name(role_name)
        self.spawn_location = spawn_location
        self.vehicle_type = vehicle_type
        self.initial_speed_kmh = initial_speed_kmh
        self.spawn_retry_max_count = spawn_retry_max_count
        self.spawn_retry_t_step = spawn_retry_t_step
        self.spawn_retry_z_step = spawn_retry_z_step
        self.od_pose = od_pose
        self.ground_projection = _expect_optional_ground_projection(ground_projection)


class VehicleEntity:
    # A class variable, not a field: Codon would build one with no arguments
    # too (docs/typecheck.md). The traffic backend writes it on the instance.
    simulation_fidelity: ClassVar[SimulationFidelity] = SimulationFidelity.MICROSCOPIC

    def __init__(self):
        compile_error("VehicleEntity(): no constructor takes these arguments (required: config)")

    def __init__(self, config: VehicleEntityConfig):
        pass

    @property
    def role_name(self) -> str:
        raise NotImplementedError()

    @property
    def vehicle_type(self) -> str:
        raise NotImplementedError()

    @property
    def initial_speed_kmh(self) -> float:
        raise NotImplementedError()

    @property
    def actor(self) -> Optional[carla.Actor]:
        raise NotImplementedError()

    def spawn(self, world: carla.World) -> carla.Actor:
        raise NotImplementedError()

    def destroy(self) -> None:
        raise NotImplementedError()

    # traffic.driven.BackendDriven.route_to(), which RoutingAction calls on an
    # NPC as on the ego: the arguments are checked as EgoVehicle's are (#264).
    def route_to(self, world: carla.World, goal: Lanelet2Pose, *_kw,
                 initial_pose: Optional[CarlaWorldPose] = None, ground_projection = None,
                 waypoints = ()) -> None:
        _keyword_only(_kw, "VehicleEntity.route_to(): initial_pose, ground_projection and waypoints")
        _expect_optional_ground_projection(ground_projection)
        _expect_lanelet2_poses(waypoints)
        raise NotImplementedError()

    # The manoeuvres of traffic.driven.BackendDriven, which VehicleEntity
    # mixes in: each is handed to the traffic backend that drives the vehicle
    # (#265). set_traffic_backend() is the runner's (typecheck/not_modelled.py).
    def set_client(self, client: carla.Client, tm_port: int = DEFAULT_TM_PORT) -> None:
        raise NotImplementedError()

    def change_lane(self, world: carla.World, direction: LaneChangeDirection) -> None:
        raise NotImplementedError()

    def lane_change_finished(self, world: carla.World) -> bool:
        raise NotImplementedError()

    def set_desired_speed(self, world: carla.World, speed_kmh: float) -> None:
        raise NotImplementedError()

    def turn_at_junction(self, world: carla.World, direction: TurnDirection, **kwargs) -> None:
        raise NotImplementedError()

    def follow_route(self, world: carla.World, stops: List[Lanelet2Pose]) -> None:
        raise NotImplementedError()

    def release_from_traffic(self, world: carla.World) -> None:
        raise NotImplementedError()

    def resume_traffic(self, world: carla.World) -> None:
        raise NotImplementedError()

    def require_microscopic(self, world: carla.World) -> bool:
        raise NotImplementedError()

    def forget_lane_change(self) -> None:
        raise NotImplementedError()
