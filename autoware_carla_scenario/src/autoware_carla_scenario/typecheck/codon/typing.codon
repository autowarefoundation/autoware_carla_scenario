# Python's typing, for the scenario checker (docs/typecheck.md). Optional,
# List, Dict, Set, Tuple, Callable, Union and ClassVar are Codon builtins
# already; these are the names Codon lacks. An annotation the
# checker cannot express in Codon is dropped (typecheck/transform.py), so the
# abstract collections only appear here for class-level declarations.

# A compile-time constant, so `if TYPE_CHECKING: ... else: ...` compiles only
# its first branch, as a type checker reads it. (Static is Codon's Literal,
# which this module names for Python's below.)
TYPE_CHECKING: Static[bool] = True

Sequence = List
MutableSequence = List
Iterable = List
Collection = List
Mapping = Dict
MutableMapping = Dict
AbstractSet = Set
# Codon has no immutable set; the checker rewrites frozenset(...) to set(...).
FrozenSet = Set
# Iterator is Codon's generator type; the collections types are Codon's own.
Iterator = Generator
from collections import Counter, defaultdict as DefaultDict, deque as Deque


# Only for the import: the checker drops every parameter and local annotation
# naming Any (typecheck/transform.py), so no value is typed with this class. A
# class-level `dict[str, Any]` field keeps its annotation, and its empty
# default is built as one (`dict[str, Any]()`), so nothing can be put in it.
class Any:
    pass


# Only for a module-level `T = TypeVar("T", bound="...")` that types a
# decorator for mypy (trajectory.model's _refusing_vertex_times, which the
# library check drops): Codon has its own generics, and nothing is typed with
# the value.
def TypeVar(name: str, bound: str = "") -> str:
    return name


# A protocol is an empty base here, and the checker drops @runtime_checkable
# (typecheck/transform.py): Codon checks each call with the type it is given,
# so a protocol class is only ever a declaration.
class Protocol:
    pass


def runtime_checkable(cls):
    return cls


# Python's Literal, for the import: the checker reads `Literal["a", "b"]` as
# the type of its values (typecheck/transform.py), which Codon's own Literal
# (a compile-time value's type) is not.
Literal = str


# Python's IO[AnyStr], the type of a file object (what Path.open() returns,
# codon/pathlib.codon): generic in what it reads and writes, `bytes` (read as
# `str` by the check) or `str`, so IO[bytes] and IO[str] are one type here.
# Declared are name, mode, closed, close(), fileno(), flush(), read(),
# readline(), write(), iteration over the lines and `with`, as typing.IO
# declares them and a file object has them in CPython 3.10; the rest is not.
# Nothing here runs: nothing is read or written.
class IO:
    # Codon's generic parameter, in a form Python 3.10 can parse.
    T: type
    name: str
    mode: str

    def __init__(self, name: str, mode: str):
        self.name = name
        self.mode = mode

    @property
    def closed(self) -> bool:
        return False

    def close(self) -> None:
        pass

    def fileno(self) -> int:
        return -1

    def flush(self) -> None:
        pass

    def read(self, n: int = -1) -> T:
        return Ptr[T]()[0]

    def readline(self, limit: int = -1) -> T:
        return Ptr[T]()[0]

    def write(self, s: T) -> int:
        return 0

    def __iter__(self) -> Generator[T]:
        if False:
            yield Ptr[T]()[0]

    def __enter__(self) -> IO[T]:
        return self

    def __exit__(self, *args) -> None:
        pass


# Names only an annotation uses: the checker drops every annotation naming
# them (typecheck/transform.py), so they exist for the import alone. Final[X]
# and Annotated[X, ...] are read as X.
class Final:
    pass


class Annotated:
    pass


class NoReturn:
    pass


class Type:
    pass


class Sized:
    pass


class Hashable:
    pass


# typing.cast(T, x): x, typed as T. Nothing here runs.
def cast(T: type, x) -> T:
    return Ptr[T]()[0]
