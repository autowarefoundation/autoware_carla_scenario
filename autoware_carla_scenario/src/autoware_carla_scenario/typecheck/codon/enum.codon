# Python's enum, for the static check (docs/typecheck.md).
#
# Codon has no enum module. The checker rewrites an Enum class
# (typecheck/transform.py) into a subclass of Enum[T], T the type of its
# values, with each member a class variable holding an instance:
#
#     class Color(Enum):           class Color(Enum[str]):
#         RED = "red"        ->        RED: ClassVar[Color] = Color("RED", "red")
#
# so `Color.RED.value` is a str, `Color.RED.name` a str, and a Color is a type
# of its own. Looking a member up by value (`Color("red")`) is typed by a
# constructor the checker adds to each class after its module (`@extend`); it
# makes a Color, not the member, since nothing the check compiles runs.
# The checker also appends `Color._acs_members()` (the members as a list) and
# `Color._acs_by_name(name)`, which it reads for `for c in Color`, `list(Color)`
# and `Color["RED"]` (#377).


class Enum:
    # The type of the values (Codon's generic parameter, in a form Python
    # can parse too: `class Enum[T]` needs Python 3.12).
    T: type
    _name_: str
    _value_: T

    def __init__(self, name: str, value: T):
        self._name_ = name
        self._value_ = value

    @property
    def name(self) -> str:
        return self._name_

    @property
    def value(self) -> T:
        return self._value_

    def __eq__(self, other) -> bool:
        # A member equals a member by name.  Python's plain Enum is equal to
        # nothing else; an IntEnum / StrEnum subclass below adds its value.
        if isinstance(other, Enum):
            return self._name_ == other._name_
        else:
            return False

    def __ne__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._name_ != other._name_
        else:
            return True

    def __hash__(self) -> int:
        return hash(self._name_)

    def __str__(self) -> str:
        return self.__class__.__name__ + "." + self._name_

    def __repr__(self) -> str:
        return "<" + self.__class__.__name__ + "." + self._name_ + ">"

    def _acs_enum(self) -> int:
        """Marks an enum, which the model's values= checks take for an
        enum class (coverage.codon, #279): Codon 0.19 passes a class as an
        argument as if it were one of its objects."""
        return 0


class IntEnum(Enum[T]):
    T: type
    """An int-valued enum (`IntEnum`, `IntFlag`, `(int, Enum)`): a member
    compares, orders and converts like its value, as Python's int mixin makes
    it.  A plain `Enum` has none of this (Python refuses `<` and `int()`).
    The checker names this class as the base of such an enum."""

    def __eq__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ == other._value_
        else:
            return self._value_ == other

    def __ne__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ != other._value_
        else:
            return self._value_ != other

    def __lt__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ < other._value_
        else:
            return self._value_ < other

    def __le__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ <= other._value_
        else:
            return self._value_ <= other

    def __gt__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ > other._value_
        else:
            return self._value_ > other

    def __ge__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ >= other._value_
        else:
            return self._value_ >= other

    def __int__(self) -> int:
        return self._value_

    def __index__(self) -> int:
        return self._value_

    def __float__(self) -> float:
        return float(self._value_)


class StrEnum(Enum[T]):
    T: type
    """A str-valued enum (`StrEnum`, `(str, Enum)`): a member equals its
    string, as Python's str mixin makes it."""

    def __eq__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ == other._value_
        else:
            return self._value_ == other

    def __ne__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ != other._value_
        else:
            return self._value_ != other


class Flag(Enum[T]):
    T: type
    """A flag enum (`Flag`).  It equals a flag by value, so two combinations
    of the same members are equal, and it is false when it has no bit set.
    The operators `|`, `&`, `^`, `~` and `in` (#437) are not here: Codon
    realizes a method of this class for the base type, which could not name
    the subclass it returns, so the checker declares them on each flag class
    with `@extend` (`def __or__(self, other: Perm) -> Perm`).  A combination
    is no member: it is the class built from the combined int (`Perm(3)`,
    the constructor by value the checker adds to each class), with the empty
    name."""

    def __eq__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ == other._value_
        else:
            return False

    def __ne__(self, other) -> bool:
        if isinstance(other, Enum):
            return self._value_ != other._value_
        else:
            return True

    def __hash__(self) -> int:
        return hash(self._value_)

    def __bool__(self) -> bool:
        return self._value_ != 0


class IntFlag(IntEnum[T]):
    T: type
    """An `IntFlag` (also `(int, Flag)`): an IntEnum's comparisons and int(),
    and Flag's truth value; its operators, which take an int on either side
    too, are declared on each class by the checker (see Flag)."""

    def __hash__(self) -> int:
        return hash(self._value_)

    def __bool__(self) -> bool:
        return self._value_ != 0


def auto() -> int:
    return 0


def unique(cls):
    return cls
