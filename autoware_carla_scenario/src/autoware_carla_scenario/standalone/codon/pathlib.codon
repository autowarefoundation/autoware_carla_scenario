# pathlib for a standalone binary: the part of Path the compiled modules use.

import os

from C import getcwd(cobj, int) -> cobj
from C import access(cobj, i32) -> i32


def _cwd() -> str:
    buf = Ptr[byte](4096)
    if getcwd(buf.as_byte(), 4096) == cobj():
        return "."
    return str.from_ptr(buf)


class Path:
    _p: str

    def __init__(self, *parts):
        out = ""
        for part in parts:
            text = str(part)
            if text.startswith("/") or out == "":
                out = text
            else:
                out = out.rstrip("/") + "/" + text
        self._p = out if out != "" else "."

    def __str__(self) -> str:
        return self._p

    def __repr__(self) -> str:
        return "Path(" + repr(self._p) + ")"

    def __fspath__(self) -> str:
        return self._p

    def __truediv__(self, other) -> Path:
        return Path(self._p, str(other))

    def __eq__(self, other: Path) -> bool:
        return self._p == other._p

    @property
    def name(self) -> str:
        stripped = self._p.rstrip("/")
        i = stripped.rfind("/")
        return stripped[i + 1 :] if i >= 0 else stripped

    @property
    def suffix(self) -> str:
        name = self.name
        i = name.rfind(".")
        return name[i:] if i > 0 else ""

    @property
    def stem(self) -> str:
        name = self.name
        i = name.rfind(".")
        return name[:i] if i > 0 else name

    @property
    def parent(self) -> Path:
        stripped = self._p.rstrip("/")
        i = stripped.rfind("/")
        if i < 0:
            return Path(".")
        return Path(stripped[:i] if i > 0 else "/")

    def with_name(self, name: str) -> Path:
        return self.parent / name

    def with_suffix(self, suffix: str) -> Path:
        return self.parent / (self.stem + suffix)

    def is_absolute(self) -> bool:
        return self._p.startswith("/")

    def resolve(self) -> Path:
        return self if self.is_absolute() else Path(_cwd(), self._p)

    def exists(self) -> bool:
        return int(access(self._p.c_str(), i32(0))) == 0

    def mkdir(self, mode: int = 511, parents: bool = False, exist_ok: bool = False) -> None:
        if parents:
            prefix = "/" if self._p.startswith("/") else ""
            for part in self._p.split("/"):
                if part == "":
                    continue
                prefix = "/" + part if prefix == "/" else (part if prefix == "" else prefix + "/" + part)
                os.mkdir(prefix, mode)
        else:
            os.mkdir(self._p, mode)

    def read_text(self, encoding: str = "utf-8") -> str:
        with open(self._p) as f:
            return f.read()

    def write_text(self, text: str, encoding: str = "utf-8") -> int:
        with open(self._p, "w") as f:
            f.write(text)
        return len(text)

    def open(self, mode: str = "r", buffering: int = -1, encoding: str = "utf-8"):
        return open(self._p, mode)
