# coordinate.map_manager for a standalone binary (docs/standalone.md).
#
# The Python MapManager loads the Lanelet2 map with Lanelet2 and the OpenDRIVE
# with pyxodr; a binary reads the geometry `scenario-build` baked from the same
# files (standalone/bake.py). Its API is the Python one's, as far as the
# compiled modules use it: get_instance(), reset(), initialize(), mgrs_offset,
# z_offset, carla_map.

import math
import logging
import typesafe_carla.carla as carla

_logger = logging.getLogger("autoware_carla_scenario.coordinate.map_manager")

#: Bundle format the runtime reads (standalone/bake.py FORMAT_VERSION).
MAP_FORMAT_VERSION = 1


class _Polyline:
    """Points of a centerline or a reference line, with their 2D arc lengths."""
    xs: List[float]
    ys: List[float]
    zs: List[float]
    arc: List[float]

    def __init__(self, xs: List[float], ys: List[float], zs: List[float]):
        self.xs = xs
        self.ys = ys
        self.zs = zs
        # _compute_arc_lengths_2d: np.cumsum of the segment lengths.
        arc = List[float](len(xs))
        total = 0.0
        if len(xs) > 0:
            arc.append(0.0)
        for i in range(1, len(xs)):
            dx = xs[i] - xs[i - 1]
            dy = ys[i] - ys[i - 1]
            total += math.sqrt(dx * dx + dy * dy)  # np.linalg.norm, then np.cumsum
            arc.append(total)
        self.arc = arc

    def __len__(self) -> int:
        return len(self.xs)


class _Lanelet:
    id: int
    centerline: _Polyline
    outline_x: List[float]
    outline_y: List[float]
    min_x: float
    min_y: float
    max_x: float
    max_y: float

    def __init__(self, id: int, centerline: _Polyline):
        self.id = id
        self.centerline = centerline
        self.outline_x = List[float]()
        self.outline_y = List[float]()
        self.min_x = 0.0
        self.min_y = 0.0
        self.max_x = 0.0
        self.max_y = 0.0

    def set_outline(self, xs: List[float], ys: List[float]):
        self.outline_x = xs
        self.outline_y = ys
        if len(xs) > 0:
            self.min_x = min(xs)
            self.max_x = max(xs)
            self.min_y = min(ys)
            self.max_y = max(ys)


class _MapData:
    mgrs_offset_x: float
    mgrs_offset_y: float
    z_offset: float
    lanelets: Dict[int, _Lanelet]
    lanelet_order: List[int]  # as the Lanelet2 layer iterates them
    roads: Dict[str, _Polyline]
    road_order: List[str]
    carla_map: Optional[carla.Map]

    def __init__(self):
        self.mgrs_offset_x = 0.0
        self.mgrs_offset_y = 0.0
        self.z_offset = 0.0
        self.lanelets = Dict[int, _Lanelet]()
        self.lanelet_order = List[int]()
        self.roads = Dict[str, _Polyline]()
        self.road_order = List[str]()
        self.carla_map = None


_MAP = List[_MapData]()



def _xyz(fields: List[str], start: int, n: int, dims: int) -> List[List[float]]:
    cols = [List[float](n) for _ in range(dims)]
    for i in range(n):
        for d in range(dims):
            cols[d].append(float(fields[start + dims * i + d]))
    return cols


def load_map_data(path: str) -> _MapData:
    """Read the map bundle `scenario-build` wrote (standalone/bake.py)."""
    data = _MapData()
    version_seen = False
    with open(path) as f:
        for raw in f:
            line = raw.rstrip("\n")
            if not line:
                continue
            fields = line.split(" ")
            tag = fields[0]
            if tag == "acsmap":
                if int(fields[1]) != MAP_FORMAT_VERSION:
                    raise RuntimeError(f"{path}: map data format {fields[1]}, "
                                       f"this binary reads {MAP_FORMAT_VERSION}")
                version_seen = True
            elif tag == "mgrs_offset":
                data.mgrs_offset_x = float(fields[1])
                data.mgrs_offset_y = float(fields[2])
            elif tag == "z_offset":
                data.z_offset = float(fields[1])
            elif tag == "lanelet":
                lanelet_id = int(fields[1])
                cols = _xyz(fields, 3, int(fields[2]), 3)
                data.lanelets[lanelet_id] = _Lanelet(lanelet_id, _Polyline(cols[0], cols[1], cols[2]))
                data.lanelet_order.append(lanelet_id)
            elif tag == "outline":
                cols = _xyz(fields, 3, int(fields[2]), 2)
                data.lanelets[int(fields[1])].set_outline(cols[0], cols[1])
            elif tag == "road":
                cols = _xyz(fields, 3, int(fields[2]), 3)
                data.roads[fields[1]] = _Polyline(cols[0], cols[1], cols[2])
                data.road_order.append(fields[1])
            else:
                raise RuntimeError(f"{path}: unknown record {repr(tag)}")
    if not version_seen:
        raise RuntimeError(f"{path} is not a scenario map bundle")
    return data



def _clip(v: float, lo: float, hi: float) -> float:
    return lo if v < lo else (hi if v > hi else v)



def _covered_by(lanelet: _Lanelet, x: float, y: float) -> bool:
    """boost::geometry::covered_by(point, polygon2d): inside or on the boundary."""
    if x < lanelet.min_x or x > lanelet.max_x or y < lanelet.min_y or y > lanelet.max_y:
        return False
    xs = lanelet.outline_x
    ys = lanelet.outline_y
    n = len(xs)
    inside = False
    j = n - 1
    for i in range(n):
        xi = xs[i]
        yi = ys[i]
        xj = xs[j]
        yj = ys[j]
        if _segment_distance(x, y, xi, yi, xj, yj) == 0.0:
            return True
        if (yi > y) != (yj > y):
            cross_x = xi + (y - yi) * (xj - xi) / (yj - yi)
            if x < cross_x:
                inside = not inside
        j = i
    return inside


def _segment_distance(px: float, py: float, ax: float, ay: float, bx: float, by: float) -> float:
    dx = bx - ax
    dy = by - ay
    length2 = dx * dx + dy * dy
    if length2 == 0.0:
        return math.hypot(px - ax, py - ay)
    u = ((px - ax) * dx + (py - ay) * dy) / length2
    u = _clip(u, 0.0, 1.0)
    return math.hypot(px - (ax + u * dx), py - (ay + u * dy))


def _polygon_distance(lanelet: _Lanelet, x: float, y: float) -> float:
    """boost::geometry::distance(point, polygon2d): 0 inside, else to the boundary."""
    if _covered_by(lanelet, x, y):
        return 0.0
    xs = lanelet.outline_x
    ys = lanelet.outline_y
    n = len(xs)
    best = math.inf
    j = n - 1
    for i in range(n):
        d = _segment_distance(x, y, xs[j], ys[j], xs[i], ys[i])
        if d < best:
            best = d
        j = i
    return best


def _find_nearest(mm: _MapData, x: float, y: float, count: int) -> List[Tuple[float, _Lanelet]]:
    """lanelet2.geometry.findNearest(laneletLayer, point, count): (distance, lanelet),
    nearest first."""
    found = List[Tuple[float, int]]()
    order = 0
    for lanelet_id in mm.lanelet_order:
        found.append((_polygon_distance(mm.lanelets[lanelet_id], x, y), order))
        order += 1
    found.sort()
    out = List[Tuple[float, _Lanelet]]()
    for i in range(min(count, len(found))):
        out.append((found[i][0], mm.lanelets[mm.lanelet_order[found[i][1]]]))
    return out



def _road_z(carla_map: carla.Map, location: carla.Location) -> float:
    try:
        waypoint = carla_map.get_waypoint(location, project_to_road=True)
    except carla.CarlaError:
        return location.z
    if waypoint is None:
        return location.z
    return unwrap(waypoint).transform.location.z


def _z_offset_from_spawn_points(mm: _MapData, carla_map: carla.Map) -> Optional[float]:
    spawn_points = carla_map.get_spawn_points()
    if len(spawn_points) == 0:
        return None
    offsets = List[float]()
    for sp in spawn_points:
        mgrs_x = sp.location.x + mm.mgrs_offset_x
        mgrs_y = -sp.location.y + mm.mgrs_offset_y
        nearest = _find_nearest(mm, mgrs_x, mgrs_y, 1)
        if len(nearest) == 0:
            continue
        dist_to_lanelet, lanelet = nearest[0]
        if dist_to_lanelet > 10.0:
            continue
        cl = lanelet.centerline
        best_d2 = math.inf
        ll2_z = 0.0
        for i in range(len(cl)):
            d2 = (cl.xs[i] - mgrs_x) ** 2 + (cl.ys[i] - mgrs_y) ** 2
            if d2 < best_d2:
                best_d2 = d2
                ll2_z = cl.zs[i]
        offsets.append(ll2_z - _road_z(carla_map, sp.location))
    if len(offsets) == 0:
        return None
    return sum(offsets) / float(len(offsets))



def _lanelet(mm: _MapData, lanelet_id: int) -> _Lanelet:
    if lanelet_id not in mm.lanelets:
        raise KeyError(f"lanelet {lanelet_id} is not in the map")
    return mm.lanelets[lanelet_id]


def _road(mm: _MapData, road_id: str) -> _Polyline:
    if road_id not in mm.roads:
        raise KeyError(f"OpenDRIVE road {repr(road_id)} is not in the map")
    return mm.roads[road_id]




class MapManager:
    _data: Optional[_MapData]
    _INSTANCE: ClassVar[List[MapManager]] = List[MapManager]()

    def __init__(self):
        self._data = None

    @staticmethod
    def get_instance() -> MapManager:
        if len(MapManager._INSTANCE) == 0:
            MapManager._INSTANCE.append(MapManager())
        return MapManager._INSTANCE[0]

    @staticmethod
    def reset() -> None:
        MapManager._INSTANCE.clear()

    def initialize(self, map_data: str, carla_world: Optional[carla.World] = None) -> None:
        """MapManager.initialize(), from the baked map; with a world, its map serves
        the waypoint lookups and its spawn points the z offset, as in Python."""
        if self._data is not None:
            raise RuntimeError("MapManager is already initialized. Call MapManager.reset() "
                               "before re-initializing (testing only).")
        data = load_map_data(map_data)
        if carla_world is not None:
            carla_map = unwrap(carla_world).get_map()
            data.carla_map = carla_map
            measured = _z_offset_from_spawn_points(data, carla_map)
            if measured is not None:
                data.z_offset = unwrap(measured)
        self._data = data
        _logger.info("Map data: %d lanelets, %d roads, z_offset=%.3f", len(data.lanelets),
                     len(data.roads), data.z_offset)

    def _map(self) -> _MapData:
        if self._data is None:
            raise RuntimeError("MapManager is not initialized. Call initialize() first.")
        return unwrap(self._data)

    @property
    def mgrs_offset(self) -> Tuple[float, float]:
        m = self._map()
        return (m.mgrs_offset_x, m.mgrs_offset_y)

    @property
    def z_offset(self) -> float:
        return self._map().z_offset

    @property
    def carla_map(self) -> Optional[carla.Map]:
        return self._map().carla_map
