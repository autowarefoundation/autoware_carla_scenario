# Model of autoware_carla_scenario.entity_role (docs/typecheck.md).


class EntityRole:
    _value: str

    def __init__(self, value: str):
        self._value = value

    @staticmethod
    def ego() -> EntityRole:
        return EntityRole("Ego")

    @staticmethod
    def npc(n: int) -> EntityRole:
        return EntityRole("npc" + str(n))

    def __str__(self) -> str:
        return self._value

    def __repr__(self) -> str:
        return "EntityRole(" + self._value + ")"

    def __eq__(self, other: EntityRole) -> bool:
        return self._value == other._value

    def __ne__(self, other: EntityRole) -> bool:
        return self._value != other._value

    def __hash__(self) -> int:
        return hash(self._value)


def _expect_role(role) -> EntityRole:
    """A Union[EntityRole, str] argument (a role name)."""
    if isinstance(role, EntityRole):
        return role
    elif isinstance(role, str):
        return EntityRole(role)
    else:
        compile_error("expected an EntityRole or a str (a role name)")


def _expect_optional_role(role) -> Optional[EntityRole]:
    """A Union[EntityRole, str, None] argument."""
    if isinstance(role, None):
        return None
    elif isinstance(role, Optional[NoneType]):
        return None
    elif isinstance(role, Optional):
        if role is None:
            return None
        return _expect_role(unwrap(role))
    else:
        return _expect_role(role)
