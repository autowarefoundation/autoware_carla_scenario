# autoware_carla_scenario.scenario_base for the standalone runtime
# (docs/standalone.md): BaseScenario as scenario_base.py has it. Only the
# attributes a scenario subclass is meant to touch are declared for the
# subclass; the rest are the runner's (runner.codon).

import math
import logging
import typesafe_carla.carla as carla

from ._tc import _keyword_only, _expect_int_sequence
from .actions import BaseAction, RoutingAction, _as_action
from .conditions import BaseCondition, _as_condition, find_actor_by_role_name
from .constants import DEFAULT_TM_PORT, EGO_ROLE_NAME
from .coordinate import (Lanelet2Pose, OpenDrivePose, CarlaWorldPose, GroundProjectionConfig,
                         _expect_optional_ground_projection, snap_to_carla_road, to_opendrive)
from .entity import (EgoConfig, EgoVehicle, VehicleEntity, PedestrianEntity, SpawnTransform,
                     register_entity as _register_entity, _expect_optional_ego_vehicle,
                     _expect_optional_lanelet2_poses)
from .traffic import TrafficManagerBackend

_logger = logging.getLogger("autoware_carla_scenario.scenario_base")


def _expect_actor_getter(actor_getter):
    """A Callable[[], Optional[carla.Actor]] argument."""
    actor: Optional[carla.Actor] = actor_getter()


class SpectatorCameraConfig:
    offset_back: float
    offset_up: float
    pitch: float

    def __init__(self, offset_back: float, offset_up: float, pitch: float):
        self.offset_back = offset_back
        self.offset_up = offset_up
        self.pitch = pitch


class BaseScenario:
    ego_config: EgoConfig
    ego_entity: Optional[EgoVehicle]
    random_seed: int
    _spawn_pose: Optional[Lanelet2Pose]
    _ground_projection: GroundProjectionConfig
    _client: Optional[carla.Client]
    _tm_port: int
    _traffic_backend: Optional[TrafficManagerBackend]
    _entities: List[VehicleEntity]
    _init_callbacks: List[Callable[[carla.World], None]]
    _init_actions: List[BaseAction]
    _pre_tick_callbacks: List[Callable[[carla.World], None]]
    _post_tick_callbacks: List[Callable[[carla.World], None]]
    _pre_tick_actions: List[BaseAction]
    _post_tick_actions: List[BaseAction]
    _pass_conditions: List[BaseCondition]
    _fail_conditions: List[BaseCondition]
    _spectator_camera_config: Optional[SpectatorCameraConfig]
    DEFAULT_RANDOM_SEED: ClassVar[int] = 0
    STABILIZE_TICKS: ClassVar[int] = 5

    def __init__(self, ego_config: EgoConfig, *_kw, spawn_pose: Optional[Lanelet2Pose] = None,
                 ground_projection = None, random_seed: int = 0, ego_type = None,
                 ego_entity = None):
        _keyword_only(_kw, "BaseScenario(): every argument but ego_config")
        if isinstance(ego_type, None):
            pass
        elif isinstance(ego_type, Optional[NoneType]):
            pass
        else:
            compile_error("BaseScenario(ego_type=...): the standalone runtime runs the autopilot "
                          "ego (EgoVehicle) only")
        self.ego_config = ego_config
        self.ego_entity = _expect_optional_ego_vehicle(ego_entity)
        self.random_seed = random_seed
        self._spawn_pose = spawn_pose
        gp = _expect_optional_ground_projection(ground_projection)
        self._ground_projection = gp if gp is not None else GroundProjectionConfig()
        self._client = None
        self._tm_port = DEFAULT_TM_PORT
        self._traffic_backend = None
        self._entities = List[VehicleEntity]()
        self._init_callbacks = List[Callable[[carla.World], None]]()
        self._init_actions = List[BaseAction]()
        self._pre_tick_callbacks = List[Callable[[carla.World], None]]()
        self._post_tick_callbacks = List[Callable[[carla.World], None]]()
        self._pre_tick_actions = List[BaseAction]()
        self._post_tick_actions = List[BaseAction]()
        self._pass_conditions = List[BaseCondition]()
        self._fail_conditions = List[BaseCondition]()
        self._spectator_camera_config = None

    @property
    def goal_pose(self) -> Optional[Lanelet2Pose]:
        return self.ego_config.goal_pose

    @goal_pose.setter
    def goal_pose(self, pose: Optional[Lanelet2Pose]):
        self.ego_config.goal_pose = pose

    @property
    def waypoint_poses(self) -> List[Lanelet2Pose]:
        return self.ego_config.waypoint_poses

    @waypoint_poses.setter
    def waypoint_poses(self, poses):
        self.ego_config.waypoint_poses = _expect_optional_lanelet2_poses(poses)

    def create_ego(self) -> EgoVehicle:
        if self.ego_entity is not None:
            return unwrap(self.ego_entity)
        return EgoVehicle()

    def set_client(self, client: carla.Client, tm_port: int = 8100) -> None:
        self._client = client
        self._tm_port = tm_port

    def set_traffic_backend(self, backend: TrafficManagerBackend) -> None:
        self._traffic_backend = backend

    @property
    def traffic_backend(self) -> Optional[TrafficManagerBackend]:
        return self._traffic_backend

    @property
    def client(self) -> carla.Client:
        if self._client is None:
            raise RuntimeError("CARLA client not set. Call set_client() before accessing the "
                               "client property.")
        return unwrap(self._client)

    @property
    def tm_port(self) -> int:
        return self._tm_port

    @property
    def world(self) -> carla.World:
        return self.client.get_world()

    def _setup_ego_spawn(self) -> OpenDrivePose:
        if self._spawn_pose is None:
            raise ValueError("spawn_pose is required for this scenario")
        ll2_pose = unwrap(self._spawn_pose)
        world = self.world
        snapped = snap_to_carla_road(ll2_pose, world, ground_projection=self._ground_projection)
        od_pose = to_opendrive(snapped)
        _logger.info("Lanelet %d -> OpenDRIVE road='%s' lane=%d s=%.1f -> CARLA (%.1f, %.1f, %.3f) "
                     "yaw=%.1f", ll2_pose.lanelet_id, od_pose.road_id, od_pose.lane_id, od_pose.s,
                     snapped.x, snapped.y, snapped.z, snapped.yaw)
        self.ego_config.spawn_location = SpawnTransform(snapped.to_carla_transform())
        self.ego_config.od_pose = od_pose
        self.ego_config.ground_projection = self._ground_projection
        ego_actor = lambda: find_actor_by_role_name(world, EGO_ROLE_NAME)
        self.follow_with_spectator(ego_actor)
        self.log_actor_position(ego_actor, label="ego")
        self.register_route_to_goal(snapped)
        return od_pose

    @property
    def ego_requires_goal(self) -> bool:
        return EgoVehicle.requires_goal

    def require_goal(self) -> Optional[Lanelet2Pose]:
        if self.goal_pose is None and self.ego_requires_goal:
            raise ValueError("the scenario has no goal, and its ego plans its own route: it will "
                             "not move without one.")
        return self.goal_pose

    def derive_goal_from_route(self, route_lanelet_ids) -> None:
        ids = _expect_int_sequence(route_lanelet_ids)
        if self.goal_pose is not None or len(ids) == 0:
            return
        self.goal_pose = Lanelet2Pose(ids[len(ids) - 1], 0.0)

    def derive_waypoints_from_route(self, route_lanelet_ids) -> None:
        ids = _expect_int_sequence(route_lanelet_ids)
        if len(self.waypoint_poses) > 0 or len(ids) == 0:
            return
        goal = self.goal_pose
        ends_at_the_goal = goal is None or unwrap(goal).lanelet_id == ids[len(ids) - 1]
        via = ids[: len(ids) - 1] if ends_at_the_goal else ids
        self.waypoint_poses = [Lanelet2Pose(lanelet_id, 0.0) for lanelet_id in via]

    def register_route_to_goal(self, initial_pose: Optional[CarlaWorldPose] = None) -> None:
        goal = self.require_goal()
        if goal is None:
            return
        self.register_init(RoutingAction(EGO_ROLE_NAME, unwrap(goal), initial_pose=initial_pose,
                                         ground_projection=self._ground_projection,
                                         waypoints=self.waypoint_poses, label="route_ego_to_goal"))

    def setup(self) -> None:
        raise NotImplementedError("BaseScenario.setup()")

    def is_done(self) -> bool:
        raise NotImplementedError("BaseScenario.is_done()")

    def register_init(self, cb) -> None:
        if hasattr(cb, "_acs_action"):
            self._init_actions.append(_as_action(cb))
        else:
            self._init_callbacks.append(cb)

    def run_init(self, world: carla.World) -> None:
        for cb in self._init_callbacks:
            cb(world)
        for action in self._init_actions:
            action.tick(world, 0.0)

    def register_pre_tick(self, cb) -> None:
        if hasattr(cb, "_acs_action"):
            self._pre_tick_actions.append(_as_action(cb))
        else:
            self._pre_tick_callbacks.append(cb)

    def register_post_tick(self, cb) -> None:
        if hasattr(cb, "_acs_action"):
            self._post_tick_actions.append(_as_action(cb))
        else:
            self._post_tick_callbacks.append(cb)

    def register_entity(self, entity: VehicleEntity) -> None:
        self._entities.append(entity)
        _register_entity(entity.role_name, entity)
        if self._traffic_backend is not None:
            entity.set_traffic_backend(unwrap(self._traffic_backend))
        elif self._client is not None:
            entity.set_client(unwrap(self._client), self._tm_port)

    def register_pedestrian(self, entity: PedestrianEntity) -> None:
        compile_error("register_pedestrian() is not supported by the standalone runtime yet")

    def register_pass_condition(self, condition) -> None:
        self._pass_conditions.append(_as_condition(condition))

    def register_fail_condition(self, condition) -> None:
        self._fail_conditions.append(_as_condition(condition))

    def follow_with_spectator(self, actor_getter, *_kw, offset_back: float = 8.0,
                              offset_up: float = 5.0, pitch: float = -15.0) -> None:
        _keyword_only(_kw, "BaseScenario.follow_with_spectator(): offset_back, offset_up and pitch")
        self._spectator_camera_config = SpectatorCameraConfig(offset_back, offset_up, pitch)

        def _follow(world: carla.World):
            found: Optional[carla.Actor] = actor_getter()
            if found is None:
                return
            try:
                tf = unwrap(found).get_transform()
            except carla.CarlaError:
                return
            fwd = tf.get_forward_vector()
            loc = carla.Location(x=tf.location.x - offset_back * fwd.x,
                                 y=tf.location.y - offset_back * fwd.y,
                                 z=tf.location.z + offset_up)
            rot = carla.Rotation(yaw=tf.rotation.yaw, pitch=pitch)
            world.get_spectator().set_transform(carla.Transform(loc, rot))

        self.register_post_tick(_follow)

    def log_actor_position(self, actor_getter, *_kw, label: str = "actor",
                           interval_ticks: int = 20) -> None:
        _keyword_only(_kw, "BaseScenario.log_actor_position(): label and interval_ticks")
        state = [0]

        def _log(world: carla.World):
            state[0] += 1
            if state[0] % interval_ticks != 0:
                return
            found: Optional[carla.Actor] = actor_getter()
            if found is None:
                return
            actor = unwrap(found)
            try:
                loc = actor.get_location()
                vel = actor.get_velocity()
            except carla.CarlaError:
                _logger.warning("[%s] actor no longer valid", label)
                return
            speed = math.sqrt(vel.x ** 2 + vel.y ** 2 + vel.z ** 2)
            _logger.info("[%s] speed=%.1f m/s | pos=(%.1f, %.1f, %.1f)", label, speed, loc.x,
                         loc.y, loc.z)

        self.register_post_tick(_log)

    def set_initial_speed(self, ego_actor: carla.Actor) -> None:
        def _apply(actor: carla.Actor, speed_kmh: float):
            if speed_kmh <= 0.0:
                return
            speed_ms = speed_kmh / 3.6
            fwd = actor.get_transform().get_forward_vector()
            actor.set_target_velocity(carla.Vector3D(x=fwd.x * speed_ms, y=fwd.y * speed_ms, z=0.0))

        for entity in self._entities:
            if entity.actor is not None:
                _apply(unwrap(entity.actor), entity.initial_speed_kmh)
        _apply(ego_actor, self.ego_config.initial_speed_kmh)
