    compile_error("get_stop_line_poses() is not supported by the standalone runtime yet")


def get_stop_line_poses_with_following(lanelet_id: int, depth: int = 1
                                       ) -> List[Lanelet2Pose]:
    compile_error("get_stop_line_poses_with_following() is not supported by the standalone "
                  "runtime yet")


def find_nearest_traffic_light(world: carla.World, location, max_distance: float = 150.0
                               ) -> Tuple[Optional[carla.TrafficLight], float]:
    loc = to_carla_location(location)
    nearest: Optional[carla.TrafficLight] = None
    nearest_dist = math.inf
    for actor in world.get_actors():
        if not actor.type_id.startswith("traffic.traffic_light"):
            continue
        dist = actor.get_transform().location.distance(loc)
        if dist < nearest_dist and dist < max_distance:
            nearest = actor.as_traffic_light()
            nearest_dist = dist
    return (nearest, nearest_dist)


