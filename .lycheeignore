# Lychee Link Checker Ignore File
# This file contains regex patterns for URLs that should be excluded from link checking

# Localhost and local development URLs
http://localhost:*
http://127.0.0.1:*
http://0.0.0.0:*

# Example/placeholder domains (as per RFC 2606)
https?://example\.com.*
https?://example\.org.*
https?://example\.net.*

# Common authentication-required pages
https://github.com/settings/*
https://github.com/notifications
https://github.com/*/settings/*

# Rate-limited or authentication-required APIs
https://api.github.com/*

# LinkedIn (requires authentication)
https?://(www\.)?linkedin\.com/.*

# Twitter/X (unstable link checking)
https?://(www\.)?(twitter|x)\.com/.*

# Private/internal documentation (add your own)
# https://internal.company.com/*

# CI/CD temporary URLs
file://.*

# Anchors in same document (handled separately by lychee)
#.*

# Add project-specific exclusions below this line
# ------------------------------------------------
# Placeholders in docstrings that describe URL shapes, not links.
^https?://(user@)?host/owner/repo
^https://huggingface\.co/datasets/OWNER/NAME
# Placeholders in the tests: repositories and files that exist nowhere.
^https://github\.com/owner/repo$
^https://github\.com/(OWNER/NAME|o/n)(/|$)
^https://huggingface\.co/datasets/O/N(/|$)
^https?://x/
# The git-lfs pointer format's version line, not a page (and as a test writes
# it, with its newline escaped).
^https://git-lfs\.github\.com/spec/v1(/n)?$
# CARLA's nightly URL is written over two lines (carla_install.NIGHTLY_URL);
# lychee reads the first, the bucket's directory, which is no page.
^https://s3\.us-east-005\.backblazeb2\.com/carla-releases/Linux/Dev/$
# ISO answers link checkers with 403; the standard's page is there.
^https://www\.iso\.org/standard/
# The web viewer's CDN and npm registry URLs are templates (`{version}` is
# filled in from the installed rerun), not links (#572).
^https://unpkg\.com/@rerun-io/web-viewer@(%7B|\{)version(%7D|\})$
^https://registry\.npmjs\.org/@rerun-io/web-viewer/(%7B|\{)version(%7D|\})$
