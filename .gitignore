!data/nishishinjuku_carla.xodr
*processed.osm

# pytest-testmon
.testmondata*

# Hydra output
outputs/
multirun/

# MkDocs build output
site/

# Scenario output
scenario_outputs

# Scenario Editor working directories. An exported package is meant to be
# committed -- to its own repository, not to this one -- so the default export
# destination is ignored here rather than tracked by accident.
scenario_drafts/
scenario_packages/
.lycheecache

# Agent skills installed by `scenario-agent` (editable symlinks into the
# package's agent/skills/, and the installer's manifests). Their
# discoverability blocks in CLAUDE.md and AGENTS.md are committed; the installs
# are per checkout.
.claude/skills/
.codex/
