.venv

# Local environment (.env.example is the template)
.env

# Artifacts
*.xodr
# Generated with roadgen, which CI does not have -- see its generate.py.
!autoware_carla_scenario/test/data/two_way_street/two_way_street.xodr
# Generated once with the autoware_lanelet2_to_opendrive `convert` CLI from
